"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":4253,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":4252,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":4251,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":4250,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":4249,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":4248,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":4247,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":4246,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":4245,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":4244,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":4243,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":4242,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":4241,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":4240,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":4239,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":4238,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":4237,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":4236,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":4235,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":4234,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":4233,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":4232,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":4231,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":4230,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":4229,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":4228,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":4227,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":4226,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":4225,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":4224,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":4223,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":4222,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":4221,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":4220,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":4219,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":4218,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":4217,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":4216,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":4215,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":4214,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":4213,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":4212,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":4211,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":4210,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":4209,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":4208,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":4207,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":4206,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":4205,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":4204,\"_525\":14,\"_526\":14,\"_527\":-5},\"ia5mif\",\"6zh314\",\"v8ous5\",\"efq5ja\",\"19f1nq\",\"uvwuiw\",\"9a0dto\",\"h9atnq\",\"0g85ve\",\"9aokmq\",\"l9bhst\",\"0rjf5n\",\"ak8iv8\",\"t2yvos\",\"o89412\",\"j62hgk\",\"174wd9\",\"9g6vn6\",\"thmxmx\",\"wrxw29\",\"63f86q\",\"0f7n8l\",\"0yft7y\",\"399flm\",\"ikk16d\",\"46fyx7\",\"c1fl2c\",\"b1pmyz\",\"f4w2bc\",\"yxnsdr\",\"e9owjx\",\"g9le10\",\"ew44ds\",\"kqhi5r\",\"sz190t\",\"b7f6fg\",\"evq21q\",\"5sf6xm\",\"a9xtcu\",\"fskwr8\",\"z8v90j\",\"zsmmwv\",\"6jxyh0\",\"vbh6fi\",\"045r99\",\"h0qw4s\",\"llempe\",\"812c0v\",\"2uabzq\",\"wj3vp3\",\"mxi60x\",\"tt72px\",\"zs4yrz\",\"y4axfi\",\"qyvxka\",\"vuqh30\",\"roe5rm\",\"qjzpwa\",\"cgdter\",\"ixht13\",\"ksx62u\",\"wcppmf\",\"37c36z\",\"zj5lsv\",\"7gkoc8\",\"p4wugm\",\"6jh6es\",\"42e3k6\",\"6qeeil\",\"vokv0k\",\"u7a6k7\",\"896pm1\",\"h7314w\",\"tnoxz0\",\"1v1it4\",\"nto2r8\",\"ufc492\",\"5zza32\",\"360sk7\",\"vkvkui\",\"zd5y20\",\"ebhbrw\",\"qzcr3o\",\"mdt96a\",\"x347nr\",\"337xl2\",\"oygizg\",\"4r502e\",\"2bo259\",\"rmlpq2\",\"kksdfp\",\"fimeab\",\"7xjl65\",\"k01936\",\"hj01h7\",\"hqop4j\",\"86poaj\",\"djtyfq\",\"clzt4p\",\"rhxv32\",\"gczbc1\",\"k1ui0t\",\"hb0f18\",\"a8dszy\",\"i6s5le\",\"928ve4\",\"lq7fc7\",\"do2gv0\",\"duto2n\",\"higcyf\",\"j4y8qc\",\"rbllgs\",\"aurpna\",\"bie2y4\",\"l42ipr\",\"tu9s44\",\"wurq5a\",\"5y5is2\",\"pajoyu\",\"8bbqpz\",\"ji3a1m\",\"7ruuk5\",\"t471fn\",\"eg5nog\",\"w9t6qu\",\"28fi6y\",\"j6903i\",\"bid7mc\",\"36qf7p\",\"tz9nn8\",\"y2zw84\",\"dqdmi6\",[650],[4338],\"# Phase 1B — Operators, Truthy/Falsy \u0026 Type Coercion\\n\\nNow we're going deeper into the parts that make JavaScript feel strange to a Java developer.\\n\\nThe goal isn't to memorize weird expressions. **Understand the rules that produce them.**\\n\\n---\\n\\n# 1B.1 Arithmetic operators\\n\\nThese are familiar from Java:\\n\\n```js\\n+   -   *   /   %   **\\n```\\n\\nExample:\\n\\n```js\\nlet a = 10;\\nlet b = 3;\\n\\nconsole.log(a + b); // 13\\nconsole.log(a - b); // 7\\nconsole.log(a * b); // 30\\nconsole.log(a / b); // 3.333...\\nconsole.log(a % b); // 1\\nconsole.log(a ** b); // 1000\\n```\\n\\nThe new one for you is:\\n\\n```js\\n**\\n```\\n\\nwhich means exponentiation.\\n\\nJava equivalent:\\n\\n```java\\nMath.pow(a, b);\\n```\\n\\nJavaScript:\\n\\n```js\\na ** b\\n```\\n\\n---\\n\\n# 1B.2 Increment and decrement\\n\\nSame as Java:\\n\\n```js\\nlet x = 10;\\n\\nx++;\\nx--;\\n\\n++x;\\n--x;\\n```\\n\\nAnd prefix/postfix behavior is also similar:\\n\\n```js\\nlet x = 5;\\n\\nconsole.log(x++); // 5\\nconsole.log(x);   // 6\\n```\\n\\n```js\\nlet x = 5;\\n\\nconsole.log(++x); // 6\\nconsole.log(x);   // 6\\n```\\n\\nSo your Java knowledge transfers directly here.\\n\\n---\\n\\n# 1B.3 Assignment operators\\n\\nSame concepts:\\n\\n```js\\nlet x = 10;\\n\\nx += 5;  // 15\\nx -= 2;  // 13\\nx *= 2;  // 26\\nx /= 2;  // 13\\nx %= 5;  // 3\\n```\\n\\nYou already know these from Java.\\n\\n---\\n\\n# 1B.4 Comparison operators\\n\\n```js\\n10 \u003e 5\\n10 \u003c 5\\n10 \u003e= 10\\n10 \u003c= 10\\n10 == 10\\n10 != 5\\n10 === 10\\n10 !== 5\\n```\\n\\nThe important distinction:\\n\\n```text\\n==   loose equality\\n===  strict equality\\n\\n!=   loose inequality\\n!==  strict inequality\\n```\\n\\nFor normal modern JavaScript:\\n\\n\u003e **Prefer `===` and `!==`.**\\n\\n---\\n\\n# 1B.5 `===` actually compares type AND value\\n\\n```js\\n5 === 5\\n```\\n\\nBoth:\\n\\n```text\\ntype   → number\\nvalue  → 5\\n```\\n\\nTherefore:\\n\\n```text\\ntrue\\n```\\n\\nBut:\\n\\n```js\\n5 === \\\"5\\\"\\n```\\n\\nhas:\\n\\n```text\\nnumber\\nstring\\n```\\n\\nTherefore:\\n\\n```text\\nfalse\\n```\\n\\nThink:\\n\\n```text\\n=== → same type AND same value\\n```\\n\\nFor primitives, that's a useful mental model.\\n\\n---\\n\\n# 1B.6 `==` performs coercion\\n\\nNow:\\n\\n```js\\n5 == \\\"5\\\"\\n```\\n\\nJavaScript effectively converts one side so the values can be compared.\\n\\nResult:\\n\\n```text\\ntrue\\n```\\n\\nAnother:\\n\\n```js\\n0 == false\\n```\\n\\n→\\n\\n```text\\ntrue\\n```\\n\\nAnd:\\n\\n```js\\n1 == true\\n```\\n\\n→\\n\\n```text\\ntrue\\n```\\n\\nThis is why `==` can become confusing.\\n\\n---\\n\\n# 1B.7 `null` and `undefined`\\n\\nHere's an interview favorite:\\n\\n```js\\nnull == undefined\\n```\\n\\n→\\n\\n```text\\ntrue\\n```\\n\\nBut:\\n\\n```js\\nnull === undefined\\n```\\n\\n→\\n\\n```text\\nfalse\\n```\\n\\nBecause they're different types/values.\\n\\nRemember:\\n\\n```text\\nnull       → intentional absence of value\\nundefined  → value not provided / not assigned\\n```\\n\\n---\\n\\n# 1B.8 Truthy and falsy\\n\\nThis is one of the most important JavaScript concepts.\\n\\nJava requires:\\n\\n```java\\nif (x \u003e 0) {\\n}\\n```\\n\\nand the expression must produce a boolean.\\n\\nJavaScript allows:\\n\\n```js\\nif (x) {\\n}\\n```\\n\\nJavaScript asks:\\n\\n\u003e Is `x` truthy or falsy?\\n\\n---\\n\\n## Falsy values\\n\\nMemorize this list:\\n\\n```text\\nfalse\\n0\\n-0\\n0n\\n\\\"\\\"\\nnull\\nundefined\\nNaN\\n```\\n\\nThat's essentially the complete list of falsy values.\\n\\nEverything else is truthy.\\n\\n---\\n\\n# 1B.9 Examples\\n\\n```js\\nif (0) {\\n    console.log(\\\"A\\\");\\n}\\n```\\n\\nNothing happens.\\n\\nBecause:\\n\\n```text\\n0 → falsy\\n```\\n\\nBut:\\n\\n```js\\nif (10) {\\n    console.log(\\\"A\\\");\\n}\\n```\\n\\nprints:\\n\\n```text\\nA\\n```\\n\\nbecause:\\n\\n```text\\n10 → truthy\\n```\\n\\n---\\n\\n## Empty string\\n\\n```js\\nif (\\\"\\\") {\\n    console.log(\\\"A\\\");\\n}\\n```\\n\\nNothing.\\n\\nBut:\\n\\n```js\\nif (\\\"hello\\\") {\\n    console.log(\\\"A\\\");\\n}\\n```\\n\\nprints `A`.\\n\\n---\\n\\n# 1B.10 Java programmer trap: empty arrays and objects\\n\\nThis is important.\\n\\nYou might think:\\n\\n```js\\nif ([]) {\\n    console.log(\\\"runs\\\");\\n}\\n```\\n\\nMaybe the empty array should be false?\\n\\n**No.**\\n\\nIt runs.\\n\\n```text\\n[] → truthy\\n```\\n\\nAnd:\\n\\n```js\\nif ({}) {\\n    console.log(\\\"runs\\\");\\n}\\n```\\n\\nalso runs.\\n\\n```text\\n{} → truthy\\n```\\n\\nWhy?\\n\\nBecause arrays and objects are objects, and objects are truthy even when they're empty.\\n\\nSo:\\n\\n```text\\nJava intuition:\\nempty collection → maybe false\\n\\nJavaScript:\\n[] → true\\n{} → true\\n```\\n\\nVery important.\\n\\n---\\n\\n# 1B.11 Logical AND `\u0026\u0026`\\n\\nJava:\\n\\n```java\\nif (age \u003e 18 \u0026\u0026 isStudent) {\\n}\\n```\\n\\nJavaScript:\\n\\n```js\\nif (age \u003e 18 \u0026\u0026 isStudent) {\\n}\\n```\\n\\nSo far, identical.\\n\\nBut JavaScript's `\u0026\u0026` has an additional behavior.\\n\\nIt **returns a value**, not necessarily a boolean.\\n\\nExample:\\n\\n```js\\nconsole.log(true \u0026\u0026 \\\"Hello\\\");\\n```\\n\\n→\\n\\n```text\\nHello\\n```\\n\\nAnd:\\n\\n```js\\nconsole.log(false \u0026\u0026 \\\"Hello\\\");\\n```\\n\\n→\\n\\n```text\\nfalse\\n```\\n\\n---\\n\\n# 1B.12 How `\u0026\u0026` works\\n\\nJavaScript roughly evaluates:\\n\\n```text\\nA \u0026\u0026 B\\n```\\n\\nas:\\n\\n\u003e If A is falsy, return A. Otherwise return B.\\n\\nExample:\\n\\n```js\\nlet username = \\\"Dev\\\";\\n\\nconsole.log(username \u0026\u0026 \\\"Logged in\\\");\\n```\\n\\n`username` is truthy, so:\\n\\n```text\\n\\\"Logged in\\\"\\n```\\n\\nBut:\\n\\n```js\\nlet username = \\\"\\\";\\n\\nconsole.log(username \u0026\u0026 \\\"Logged in\\\");\\n```\\n\\nreturns:\\n\\n```text\\n\\\"\\\"\\n```\\n\\nThis becomes very useful in React.\\n\\nYou'll see:\\n\\n```js\\nisLoggedIn \u0026\u0026 \u003cDashboard /\u003e\\n```\\n\\nMeaning:\\n\\n\u003e If `isLoggedIn` is truthy, evaluate/render the dashboard.\\n\\n---\\n\\n# 1B.13 Logical OR `||`\\n\\nAgain, Java programmers need to adjust their mental model.\\n\\nJava:\\n\\n```java\\nif (a || b) {\\n}\\n```\\n\\nJavaScript:\\n\\n```js\\nif (a || b) {\\n}\\n```\\n\\nBut JavaScript's `||` also returns values.\\n\\n```js\\nconsole.log(false || \\\"Hello\\\");\\n```\\n\\n→\\n\\n```text\\nHello\\n```\\n\\nBecause the first value is falsy.\\n\\nAnother:\\n\\n```js\\nconsole.log(\\\"Dev\\\" || \\\"Guest\\\");\\n```\\n\\n→\\n\\n```text\\nDev\\n```\\n\\nBecause `\\\"Dev\\\"` is already truthy.\\n\\n---\\n\\n# 1B.14 `||` as a default value\\n\\nYou'll see:\\n\\n```js\\nlet username = \\\"\\\";\\nlet displayName = username || \\\"Guest\\\";\\n\\nconsole.log(displayName);\\n```\\n\\nOutput:\\n\\n```text\\nGuest\\n```\\n\\nBecause `\\\"\\\"` is falsy.\\n\\nThis is common, but there is a catch.\\n\\nSuppose:\\n\\n```js\\nlet count = 0;\\n\\nlet result = count || 100;\\n```\\n\\nResult:\\n\\n```text\\n100\\n```\\n\\nBut perhaps you actually wanted `0`.\\n\\nThat's where `??` becomes useful.\\n\\n---\\n\\n# 1B.15 Nullish coalescing `??`\\n\\n```js\\nlet count = 0;\\n\\nlet result = count ?? 100;\\n\\nconsole.log(result);\\n```\\n\\nOutput:\\n\\n```text\\n0\\n```\\n\\nBecause `??` only checks:\\n\\n```text\\nnull\\nundefined\\n```\\n\\nSo:\\n\\n```js\\n0 ?? 100          // 0\\n\\\"\\\" ?? \\\"Guest\\\"     // \\\"\\\"\\nfalse ?? true     // false\\nnull ?? \\\"Guest\\\"   // \\\"Guest\\\"\\nundefined ?? 10   // 10\\n```\\n\\nThis distinction is **very important in modern JavaScript and React**.\\n\\n---\\n\\n# 1B.16 `||` vs `??`\\n\\nRemember this:\\n\\n```text\\nA || B\\n```\\n\\nuses B if A is **falsy**.\\n\\n```text\\nA ?? B\\n```\\n\\nuses B if A is **null or undefined**.\\n\\nExample:\\n\\n```js\\nlet age = 0;\\n\\nconsole.log(age || 18);\\nconsole.log(age ?? 18);\\n```\\n\\nOutput:\\n\\n```text\\n18\\n0\\n```\\n\\n---\\n\\n# 1B.17 The ternary operator\\n\\nJava has:\\n\\n```java\\nString result = age \u003e= 18 ? \\\"Adult\\\" : \\\"Minor\\\";\\n```\\n\\nJavaScript is identical:\\n\\n```js\\nlet result = age \u003e= 18 ? \\\"Adult\\\" : \\\"Minor\\\";\\n```\\n\\nExample:\\n\\n```js\\nlet age = 20;\\n\\nlet status = age \u003e= 18 ? \\\"Adult\\\" : \\\"Minor\\\";\\n\\nconsole.log(status);\\n```\\n\\nOutput:\\n\\n```text\\nAdult\\n```\\n\\nYou'll use ternaries heavily in React.\\n\\n---\\n\\n# 1B.18 Optional chaining `?.`\\n\\nThis is another modern JavaScript feature.\\n\\nSuppose:\\n\\n```js\\nconst user = {\\n    profile: {\\n        name: \\\"Dev\\\"\\n    }\\n};\\n```\\n\\nYou can access:\\n\\n```js\\nconsole.log(user.profile.name);\\n```\\n\\nBut what if:\\n\\n```js\\nconst user = {};\\n```\\n\\nThen:\\n\\n```js\\nuser.profile.name\\n```\\n\\ncauses an error because `profile` is undefined.\\n\\nOptional chaining:\\n\\n```js\\nuser.profile?.name\\n```\\n\\nmeans approximately:\\n\\n\u003e If `profile` exists, access `name`; otherwise return `undefined`.\\n\\nEven:\\n\\n```js\\nuser?.profile?.name\\n```\\n\\nis safe if `user` itself could be null/undefined.\\n\\nThis becomes extremely common when working with API responses.\\n\\n---\\n\\n# 1B.19 Type coercion — the dangerous part\\n\\nNow let's understand the famous expressions.\\n\\n### Example 1\\n\\n```js\\n5 + \\\"5\\\"\\n```\\n\\n→\\n\\n```text\\n\\\"55\\\"\\n```\\n\\nBecause `+` can mean string concatenation.\\n\\n---\\n\\n### Example 2\\n\\n```js\\n5 - \\\"5\\\"\\n```\\n\\n→\\n\\n```text\\n0\\n```\\n\\nBecause subtraction is numeric, so `\\\"5\\\"` is converted to `5`.\\n\\n---\\n\\n### Example 3\\n\\n```js\\n\\\"10\\\" * \\\"2\\\"\\n```\\n\\n→\\n\\n```text\\n20\\n```\\n\\nBoth strings are converted to numbers.\\n\\n---\\n\\n### Example 4\\n\\n```js\\n\\\"10\\\" / \\\"2\\\"\\n```\\n\\n→\\n\\n```text\\n5\\n```\\n\\n---\\n\\n# 1B.20 `+` is special\\n\\nThis is the key rule:\\n\\n```text\\n+ can mean:\\n\\nnumeric addition\\nOR\\nstring concatenation\\n```\\n\\nWhereas:\\n\\n```text\\n-\\n*\\n/\\n%\\n```\\n\\nare numeric operators.\\n\\nSo:\\n\\n```js\\n\\\"10\\\" + 2\\n```\\n\\n→ `\\\"102\\\"`\\n\\nbut:\\n\\n```js\\n\\\"10\\\" - 2\\n```\\n\\n→ `8`\\n\\n---\\n\\n# 1B.21 `Number()`\\n\\nWhen you don't want implicit conversion, explicitly convert:\\n\\n```js\\nlet input = \\\"100\\\";\\n\\nlet number = Number(input);\\n\\nconsole.log(number + 20);\\n```\\n\\n→\\n\\n```text\\n120\\n```\\n\\nWithout conversion:\\n\\n```js\\nlet input = \\\"100\\\";\\n\\nconsole.log(input + 20);\\n```\\n\\n→\\n\\n```text\\n1020\\n```\\n\\nSo when handling user input from HTML forms, this matters a lot.\\n\\n---\\n\\n# 1B.22 `parseInt()` and `parseFloat()`\\n\\nYou will encounter these too.\\n\\n```js\\nparseInt(\\\"100\\\");\\n```\\n\\n→ `100`\\n\\n```js\\nparseFloat(\\\"10.5\\\");\\n```\\n\\n→ `10.5`\\n\\nBut there's a subtle difference from `Number()`.\\n\\n```js\\nNumber(\\\"10abc\\\")\\n```\\n\\n→\\n\\n```text\\nNaN\\n```\\n\\nwhile:\\n\\n```js\\nparseInt(\\\"10abc\\\")\\n```\\n\\n→\\n\\n```text\\n10\\n```\\n\\nBecause `parseInt` parses the numeric prefix.\\n\\nFor now, remember:\\n\\n```text\\nNumber()      → conversion\\nparseInt()    → parse integer\\nparseFloat()  → parse floating-point number\\n```\\n\\n---\\n\\n# 1B.23 `NaN`\\n\\nImportant interview detail:\\n\\n```js\\nNaN === NaN\\n```\\n\\nis:\\n\\n```text\\nfalse\\n```\\n\\nEven:\\n\\n```js\\nNaN == NaN\\n```\\n\\nis:\\n\\n```text\\nfalse\\n```\\n\\nTo check whether something is actually NaN, use:\\n\\n```js\\nNumber.isNaN(value)\\n```\\n\\nExample:\\n\\n```js\\nconsole.log(Number.isNaN(NaN));\\n```\\n\\n→\\n\\n```text\\ntrue\\n```\\n\\n---\\n\\n# 1B.24 The \\\"weird JavaScript\\\" interview questions\\n\\nNow let's test your understanding.\\n\\nDon't blindly memorize these.\\n\\n### Question 1\\n\\n```js\\nconsole.log([] == false);\\n```\\n\\nResult:\\n\\n```text\\ntrue\\n```\\n\\nThis happens because loose equality performs coercion.\\n\\nBut:\\n\\n```js\\n[] === false\\n```\\n\\n→\\n\\n```text\\nfalse\\n```\\n\\nbecause the types differ.\\n\\n---\\n\\n### Question 2\\n\\n```js\\nconsole.log(\\\"\\\" == false);\\n```\\n\\n→\\n\\n```text\\ntrue\\n```\\n\\nAgain, loose equality/coercion.\\n\\nBut:\\n\\n```js\\n\\\"\\\" === false\\n```\\n\\n→\\n\\n```text\\nfalse\\n```\\n\\n---\\n\\n### Question 3\\n\\n```js\\nconsole.log(null == undefined);\\n```\\n\\n→ `true`\\n\\nBut:\\n\\n```js\\nnull === undefined\\n```\\n\\n→ `false`\\n\\n---\\n\\n# 1B.25 What you should actually say in interviews\\n\\nIf an interviewer asks:\\n\\n\u003e Why does JavaScript have weird equality results?\\n\\nDon't say:\\n\\n\u003e \\\"Because JavaScript is weird.\\\"\\n\\nSay:\\n\\n\u003e \\\"The loose equality operator `==` performs type coercion according to JavaScript's equality rules. The strict equality operator `===` doesn't perform that coercion, so it generally gives more predictable comparisons.\\\"\\n\\nThat's a much stronger answer.\\n\\n---\\n\\n# 🧠 Your mental model after Phase 1B\\n\\nYou should now think:\\n\\n```text\\nJava                              JavaScript\\n\\nboolean condition only            truthy/falsy allowed\\n\u0026\u0026 / ||                           \u0026\u0026 / || also return values\\n+                                 addition OR concatenation\\nstrict-ish typed operators        implicit coercion exists\\nnull                              null\\n(no equivalent)                   undefined\\nno normal dynamic type changes    variable can change value type\\n```\\n\\n---\\n\\n# Interview checkpoint\\n\\nBefore we move to **Phase 2 — Conditions \u0026 Loops**, try these.\\n\\n### Q1\\n\\nWhat is the output?\\n\\n```js\\nconsole.log(10 + \\\"20\\\");\\nconsole.log(10 - \\\"20\\\");\\n```\\n\\n### Q2\\n\\nWhat is the output?\\n\\n```js\\nconsole.log(10 + 20 + \\\"30\\\");\\nconsole.log(\\\"10\\\" + 20 + 30);\\n```\\n\\n### Q3\\n\\nWhat is the difference?\\n\\n```js\\n0 || 100\\n```\\n\\nvs\\n\\n```js\\n0 ?? 100\\n```\\n\\n### Q4\\n\\nWhich of these are falsy?\\n\\n```js\\n0\\n\\\"0\\\"\\n\\\"\\\"\\n[]\\n{}\\nnull\\nundefined\\nNaN\\n```\\n\\n### Q5\\n\\nWhat is the output?\\n\\n```js\\nconsole.log(null == undefined);\\nconsole.log(null === undefined);\\n```\\n\\n### Q6\\n\\nWhy does this work?\\n\\n```js\\nconst user = {};\\n\\nconsole.log(user.profile?.name);\\n```\\n\\n### Q7 — interview\\n\\nExplain the difference between `==` and `===` in **one interview-quality answer**.\\n\\n---\\n\\nAfter this, we'll go to **Phase 2: Conditions, loops, switch, and JavaScript-specific iteration**, where your Java knowledge will transfer heavily and we'll start writing actual small programs.\",{},{\"_197\":4056,\"_204\":4343,\"_54\":4344,\"_56\":4345,\"_208\":4346,\"_210\":211,\"_213\":214,\"_215\":4347,\"_217\":218},\"a681b957-fb71-4165-aff6-6326a07e615e\",[4038],{\"_656\":709,\"_215\":4352},1789040810.106,1789040838.222883,{\"_651\":652,\"_653\":4351},{\"_702\":4348,\"_236\":4069,\"_704\":-5,\"_240\":4070,\"_242\":4070,\"_246\":4349,\"_248\":10,\"_244\":14},{\"_705\":4350},\"f4fccc82-9d99-4109-b08b-9ff3920a29ef\",[],[239],{},{\"_197\":4341,\"_204\":4356,\"_54\":4357,\"_56\":4358,\"_208\":4359,\"_210\":211,\"_212\":34,\"_213\":214,\"_215\":4360,\"_217\":218,\"_219\":220},\"6886a13c-b488-4167-ac1f-2a78fd192f51\",[4056],{\"_656\":657,\"_215\":4621},1789040267.814746,1789040781.223943,{\"_651\":652,\"_653\":4619},{\"_221\":4361,\"_223\":34,\"_224\":4362,\"_249\":4363,\"_226\":4364,\"_228\":67,\"_229\":4365,\"_231\":4366,\"_233\":234,\"_235\":34,\"_236\":4367,\"_238\":239,\"_240\":4368,\"_242\":4368,\"_243\":67,\"_66\":67,\"_244\":34,\"_245\":4354,\"_246\":4369,\"_248\":10},{\"_50\":647,\"_648\":4618},[],[],[],{\"_286\":4370,\"_288\":4371,\"_290\":4372,\"_292\":4373,\"_294\":4374,\"_296\":4375,\"_298\":4376,\"_300\":4377,\"_302\":4378,\"_304\":4379,\"_306\":4380,\"_308\":4381,\"_310\":4382,\"_312\":4383