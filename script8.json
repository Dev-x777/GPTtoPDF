_526\":14,\"_527\":-5},{\"_197\":2703,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2702,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2701,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2700,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2699,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2698,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2697,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2696,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2695,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2694,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2693,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2692,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2691,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2690,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2689,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2688,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2687,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2686,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2685,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2684,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2683,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2682,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2681,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2680,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2679,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2678,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2677,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2676,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2675,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2674,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2673,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2672,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2671,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2670,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2669,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2668,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2667,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2666,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2665,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2664,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2663,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2662,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2661,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2660,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2659,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2658,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2657,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2656,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2655,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2654,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2653,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2652,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2651,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2650,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2649,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2648,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2647,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2646,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2645,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2644,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2643,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2642,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2641,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2640,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2639,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2638,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2637,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2636,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2635,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2634,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2633,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2632,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2631,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2630,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2629,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2628,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2627,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2626,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2625,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2624,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2623,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2622,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2621,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2620,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2619,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2618,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2617,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2616,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2615,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2614,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2613,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2612,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2611,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2610,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2609,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2608,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2607,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2606,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2605,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2604,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":2603,\"_525\":14,\"_526\":14,\"_527\":-5},\"qot9p5\",\"cmftmd\",\"eeacdo\",\"xqcnvi\",\"gujjyz\",\"myd8t0\",\"d0n252\",\"wrh6m9\",\"diyvn3\",\"roqmb6\",\"53bqrq\",\"lsj1t9\",\"dwde3y\",\"yl12uz\",\"298zo2\",\"ylvy14\",\"z2koye\",\"9zfwoq\",\"1org61\",\"mxfqw0\",\"grrlzr\",\"4g9r9j\",\"gsg08e\",\"4vmf3g\",\"vj75jd\",\"dzze1i\",\"6uk6ld\",\"eqnvu2\",\"s7g2ll\",\"8l7jql\",\"89aom7\",\"gstt99\",\"x2bnsu\",\"hg3yvq\",\"z0s0vl\",\"w2gdbi\",\"rcbfgu\",\"1va0nl\",\"04i2ie\",\"ju7tm6\",\"969dve\",\"wo6g6b\",\"mtdb6g\",\"8crzfl\",\"yehaxh\",\"xwci4t\",\"hmwonn\",\"0dfahj\",\"5fiwwz\",\"76qgzr\",\"eug3wd\",\"bti715\",\"l95b36\",\"tn56cn\",\"ldgxgd\",\"5fzt0d\",\"4jgb0e\",\"fnma84\",\"odhft9\",\"97fu9h\",\"c1c5sk\",\"9eqoyk\",\"bxhadt\",\"i0qhu9\",\"3z0rje\",\"8ea7dv\",\"h7obz0\",\"v0aga9\",\"ym3vt7\",\"l8ewcy\",\"rvzasv\",\"gdim1a\",\"18b0v9\",\"kq4nad\",\"0psobd\",\"7idepg\",\"e79m54\",\"n6f6k0\",\"enki6g\",\"74unzz\",\"ehxg82\",\"rvkarl\",\"4ibs3w\",\"72udnj\",\"ygdauu\",\"0qvyts\",\"ijwo7v\",\"ww5cyu\",\"5hqpn2\",\"xp98fd\",\"30paps\",\"l8m8mq\",\"18fkpi\",\"czn3sq\",\"b1ifkt\",\"xjho0p\",\"t3v646\",\"46hibz\",\"pq8fj6\",\"06sbne\",\"fjkyfq\",\"55d9cn\",\"hx1dzx\",\"qu8k4q\",\"rx20wb\",\"nkpv2k\",\"foexcr\",\"rs891f\",\"ujz90o\",\"qfk3fb\",[650],[2715],\"# 🚀 Phase 7 — Advanced JavaScript Execution Model\\n\\nThis is one of the **most important phases for JavaScript interviews**.\\n\\nYou already know variables, functions, objects, classes, `this`, prototypes, etc. Now we're going to understand **what JavaScript actually does internally when your code runs**.\\n\\nAs a Java developer, this phase is especially important because some Java intuitions will be **wrong in JavaScript**.\\n\\n---\\n\\n# 7.1 Execution Context\\n\\nWhen JavaScript runs code, it creates an **Execution Context**.\\n\\nThink of it as the environment in which your code is executed.\\n\\nThere are mainly:\\n\\n1. **Global Execution Context**\\n2. **Function Execution Context**\\n3. **Module Execution Context** — important in modern JS\\n\\n### Java comparison\\n\\nIn Java, you can think roughly:\\n\\n```java\\npublic static void main(String[] args) {\\n    int x = 10;\\n    foo();\\n}\\n\\nstatic void foo() {\\n    int y = 20;\\n}\\n```\\n\\nWhen `main()` calls `foo()`, Java creates a stack frame for `foo`.\\n\\nJavaScript has a similar concept, but its execution model has additional machinery around **lexical environments, closures, hoisting, and the event loop**.\\n\\n---\\n\\n# 7.2 Global Execution Context\\n\\nConsider:\\n\\n```javascript\\nlet x = 10;\\n\\nfunction greet() {\\n    console.log(\\\"Hello\\\");\\n}\\n\\ngreet();\\n```\\n\\nBefore executing the code, JavaScript creates the **Global Execution Context**.\\n\\nConceptually:\\n\\n```text\\nGlobal Execution Context\\n│\\n├── x → 10\\n├── greet → function\\n└── other global information\\n```\\n\\nThen:\\n\\n```javascript\\ngreet();\\n```\\n\\ncauses a new function execution context to be created.\\n\\n---\\n\\n# 7.3 Call Stack\\n\\nThe **Call Stack** keeps track of currently executing functions.\\n\\nExample:\\n\\n```javascript\\nfunction a() {\\n    b();\\n}\\n\\nfunction b() {\\n    c();\\n}\\n\\nfunction c() {\\n    console.log(\\\"Hello\\\");\\n}\\n\\na();\\n```\\n\\nExecution:\\n\\n```text\\n                ┌─────────┐\\n                │    c    │  ← currently executing\\n                ├─────────┤\\n                │    b    │\\n                ├─────────┤\\n                │    a    │\\n                ├─────────┤\\n                │ global  │\\n                └─────────┘\\n```\\n\\n`a()` calls `b()`:\\n\\n```text\\nglobal\\na\\nb\\n```\\n\\n`b()` calls `c()`:\\n\\n```text\\nglobal\\na\\nb\\nc\\n```\\n\\n`c()` finishes:\\n\\n```text\\nglobal\\na\\nb\\n```\\n\\nThen `b()` finishes:\\n\\n```text\\nglobal\\na\\n```\\n\\nThen `a()` finishes:\\n\\n```text\\nglobal\\n```\\n\\nFinally:\\n\\n```text\\nempty\\n```\\n\\n### Java comparison\\n\\nThis is very similar to Java's **stack frames**.\\n\\nSo:\\n\\n\u003e **Java knowledge transfers here.**\\n\\nThe important difference comes when JavaScript introduces **asynchronous operations** later.\\n\\n---\\n\\n# 7.4 Stack Overflow\\n\\nBecause the call stack has finite space, infinite recursion causes an error.\\n\\n```javascript\\nfunction test() {\\n    test();\\n}\\n\\ntest();\\n```\\n\\nEventually:\\n\\n```text\\nRangeError: Maximum call stack size exceeded\\n```\\n\\nJava has the analogous:\\n\\n```java\\nStackOverflowError\\n```\\n\\nSo this concept transfers almost directly.\\n\\n---\\n\\n# 7.5 Lexical Environment\\n\\nNow things get more interesting.\\n\\nConsider:\\n\\n```javascript\\nlet x = 10;\\n\\nfunction test() {\\n    let y = 20;\\n\\n    console.log(x);\\n    console.log(y);\\n}\\n\\ntest();\\n```\\n\\nInside `test()`:\\n\\n```text\\ntest Lexical Environment\\n│\\n├── y → 20\\n│\\n└── outer → Global Environment\\n                 │\\n                 └── x → 10\\n```\\n\\nSo when JavaScript sees:\\n\\n```javascript\\nconsole.log(x);\\n```\\n\\nit searches:\\n\\n```text\\nCurrent scope\\n     ↓\\nOuter scope\\n     ↓\\nOuter scope\\n     ↓\\nGlobal scope\\n```\\n\\nThis is the **scope chain**.\\n\\n---\\n\\n# 7.6 Scope Chain\\n\\nExample:\\n\\n```javascript\\nlet a = 10;\\n\\nfunction outer() {\\n    let b = 20;\\n\\n    function inner() {\\n        let c = 30;\\n\\n        console.log(a);\\n        console.log(b);\\n        console.log(c);\\n    }\\n\\n    inner();\\n}\\n\\nouter();\\n```\\n\\n`inner()` can access:\\n\\n```text\\nc → own scope\\nb → outer scope\\na → global scope\\n```\\n\\nSo:\\n\\n```text\\ninner\\n ↓\\nouter\\n ↓\\nglobal\\n```\\n\\nThis is called the **scope chain**.\\n\\n### Java comparison\\n\\nJava also has lexical/block scope:\\n\\n```java\\nint a = 10;\\n\\nvoid outer() {\\n    int b = 20;\\n\\n    {\\n        int c = 30;\\n    }\\n}\\n```\\n\\nBut JavaScript's scope model becomes especially important because of **closures**.\\n\\nWe'll get there.\\n\\n---\\n\\n# 7.7 Lexical Scope\\n\\nJavaScript uses **lexical scoping**.\\n\\nThat means:\\n\\n\u003e Where a function is **written** determines what variables it can access.\\n\\nNot where the function is called.\\n\\nExample:\\n\\n```javascript\\nlet x = \\\"global\\\";\\n\\nfunction outer() {\\n    let x = \\\"outer\\\";\\n\\n    function inner() {\\n        console.log(x);\\n    }\\n\\n    return inner;\\n}\\n\\nconst fn = outer();\\n\\nfn();\\n```\\n\\nOutput:\\n\\n```text\\nouter\\n```\\n\\nWhy?\\n\\nBecause `inner()` was **defined inside `outer()`**.\\n\\nIts lexical environment remembers the environment where it was created.\\n\\nThis leads directly to **closures**.\\n\\n---\\n\\n# 7.8 Hoisting — Deep Understanding\\n\\nYou've already seen the basics.\\n\\nLet's go deeper.\\n\\nConsider:\\n\\n```javascript\\nconsole.log(x);\\n\\nvar x = 10;\\n```\\n\\nOutput:\\n\\n```text\\nundefined\\n```\\n\\nConceptually, JavaScript behaves somewhat like:\\n\\n```javascript\\nvar x;\\n\\nconsole.log(x);\\n\\nx = 10;\\n```\\n\\nImportant:\\n\\n\u003e The declaration is processed before execution, but the assignment is not.\\n\\n---\\n\\n# 7.9 `let` and `const` Hoisting\\n\\nNow:\\n\\n```javascript\\nconsole.log(x);\\n\\nlet x = 10;\\n```\\n\\nThis gives:\\n\\n```text\\nReferenceError\\n```\\n\\nA common interview mistake is saying:\\n\\n\u003e \\\"`let` and `const` are not hoisted.\\\"\\n\\nThat's **not the best answer**.\\n\\nBetter answer:\\n\\n\u003e `let` and `const` are hoisted, but they remain inaccessible in the Temporal Dead Zone until their declaration is evaluated.\\n\\nThat's interview-quality.\\n\\n---\\n\\n# 7.10 Temporal Dead Zone — TDZ\\n\\nConsider:\\n\\n```javascript\\n{\\n    console.log(x);\\n\\n    let x = 10;\\n}\\n```\\n\\nBetween entering the scope and reaching:\\n\\n```javascript\\nlet x = 10;\\n```\\n\\n`x` is in the:\\n\\n\u003e **Temporal Dead Zone**\\n\\nTherefore:\\n\\n```javascript\\nconsole.log(x);\\n```\\n\\nthrows:\\n\\n```text\\nReferenceError\\n```\\n\\nThe TDZ ends when execution reaches the declaration.\\n\\n```javascript\\nlet x = 10;\\n```\\n\\n---\\n\\n# 7.11 `var` vs `let` vs `const`\\n\\nThis is a very common interview question.\\n\\n| Feature | `var` | `let` | `const` |\\n|---|---|---|---|\\n| Scope | Function | Block | Block |\\n| Hoisted | Yes | Yes | Yes |\\n| Initial value before declaration | `undefined` | TDZ | TDZ |\\n| Redeclaration same scope | Yes | No | No |\\n| Reassignment | Yes | Yes | No |\\n\\nExample:\\n\\n```javascript\\nvar a = 10;\\nvar a = 20;   // allowed\\n```\\n\\nBut:\\n\\n```javascript\\nlet b = 10;\\nlet b = 20;   // error\\n```\\n\\nAnd:\\n\\n```javascript\\nconst c = 10;\\nc = 20;       // error\\n```\\n\\n---\\n\\n# 7.12 Important `const` Trap\\n\\n`const` does **not** make an object immutable.\\n\\nExample:\\n\\n```javascript\\nconst user = {\\n    name: \\\"Dev\\\"\\n};\\n\\nuser.name = \\\"Alex\\\";\\n\\nconsole.log(user.name);\\n```\\n\\nOutput:\\n\\n```text\\nAlex\\n```\\n\\nThis is allowed.\\n\\nWhy?\\n\\nBecause:\\n\\n```text\\nuser\\n ↓\\nreference to object\\n```\\n\\n`const` prevents changing the **binding**:\\n\\n```javascript\\nuser = {};\\n```\\n\\n❌\\n\\nBut it doesn't automatically freeze the object.\\n\\n```javascript\\nuser.name = \\\"Alex\\\";\\n```\\n\\n✅\\n\\n### Java comparison\\n\\nThis is somewhat like:\\n\\n```java\\nfinal User user = new User();\\n```\\n\\nYou cannot:\\n\\n```java\\nuser = new User();\\n```\\n\\nbut you can modify the object's fields if they aren't otherwise immutable.\\n\\nSo this concept transfers nicely.\\n\\n---\\n\\n# 7.13 Closures — The Big One\\n\\nYou have already seen closures, but now let's understand them from the execution model.\\n\\n```javascript\\nfunction outer() {\\n    let count = 0;\\n\\n    function inner() {\\n        count++;\\n        console.log(count);\\n    }\\n\\n    return inner;\\n}\\n\\nconst counter = outer();\\n\\ncounter();\\ncounter();\\ncounter();\\n```\\n\\nOutput:\\n\\n```text\\n1\\n2\\n3\\n```\\n\\nHere's the interesting part.\\n\\nNormally, you'd expect:\\n\\n```text\\nouter()\\n↓\\nouter finishes\\n↓\\ncount disappears\\n```\\n\\nBut `inner()` still needs:\\n\\n```javascript\\ncount\\n```\\n\\nSo JavaScript keeps the necessary lexical environment alive.\\n\\nConceptually:\\n\\n```text\\ncounter\\n   │\\n   ▼\\ninner()\\n   │\\n   └── [[Environment]]\\n          │\\n          ▼\\n       outer scope\\n          │\\n          └── count = 3\\n```\\n\\nThat's a **closure**.\\n\\n### Interview definition\\n\\nA good answer:\\n\\n\u003e A closure is a function together with access to the lexical environment in which it was created, allowing it to retain access to variables from its outer scope even after that outer function has finished executing.\\n\\nThat is a strong interview answer.\\n\\n---\\n\\n# 7.14 Why Closures Are Useful\\n\\nClosures allow us to create **private state**.\\n\\n```javascript\\nfunction bankAccount(initialBalance) {\\n    let balance = initialBalance;\\n\\n    return {\\n        deposit(amount) {\\n            balance += amount;\\n        },\\n\\n        getBalance() {\\n            return balance;\\n        }\\n    };\\n}\\n\\nconst account = bankAccount(1000);\\n\\naccount.deposit(500);\\n\\nconsole.log(account.getBalance());\\n```\\n\\nOutput:\\n\\n```text\\n1500\\n```\\n\\nBut:\\n\\n```javascript\\nconsole.log(account.balance);\\n```\\n\\ngives:\\n\\n```text\\nundefined\\n```\\n\\nbecause `balance` isn't directly exposed.\\n\\n### Java comparison\\n\\nIn Java you'd normally use:\\n\\n```java\\nclass BankAccount {\\n    private double balance;\\n    \\n    void deposit(double amount) {\\n        balance += amount;\\n    }\\n    \\n    double getBalance() {\\n        return balance;\\n    }\\n}\\n```\\n\\nJava uses:\\n\\n```text\\nclass + private field\\n```\\n\\nJavaScript can achieve similar encapsulation with:\\n\\n```text\\nclosure\\n```\\n\\nModern JS also has private fields:\\n\\n```javascript\\nclass BankAccount {\\n    #balance = 1000;\\n}\\n```\\n\\nSo Java knowledge helps you understand the purpose, but JS provides multiple mechanisms.\\n\\n---\\n\\n# 7.15 Closure Interview Trap\\n\\nWhat does this print?\\n\\n```javascript\\nfunction createCounter() {\\n    let count = 0;\\n\\n    return function () {\\n        count++;\\n        return count;\\n    };\\n}\\n\\nconst a = createCounter();\\nconst b = createCounter();\\n\\nconsole.log(a());\\nconsole.log(a());\\nconsole.log(b());\\nconsole.log(b());\\n```\\n\\nAnswer:\\n\\n```text\\n1\\n2\\n1\\n2\\n```\\n\\nWhy?\\n\\nBecause:\\n\\n```text\\na → closure A → count = 2\\n\\nb → closure B → count = 2\\n```\\n\\nThey have **different lexical environments**.\\n\\n---\\n\\n# 7.16 Event Loop — Where JavaScript Becomes Different\\n\\nNow we're entering one of the **most important JavaScript interview topics**.\\n\\nConsider:\\n\\n```javascript\\nconsole.log(\\\"A\\\");\\n\\nsetTimeout(() =\u003e {\\n    console.log(\\\"B\\\");\\n}, 0);\\n\\nconsole.log(\\\"C\\\");\\n```\\n\\nOutput:\\n\\n```text\\nA\\nC\\nB\\n```\\n\\nMany Java developers initially think:\\n\\n\u003e `setTimeout(..., 0)` means execute immediately.\\n\\nNo.\\n\\nIt means:\\n\\n\u003e Schedule the callback so it can run later, after the current synchronous work has completed and the relevant event-loop conditions are met.\\n\\n---\\n\\n# 7.17 JavaScript Runtime Model\\n\\nA simplified picture:\\n\\n```text\\n             JavaScript Runtime\\n                    │\\n        ┌───────────┴───────────┐\\n        │                       │\\n   Call Stack              Web APIs / Host\\n        │                       │\\n        │                  timers, I/O,\\n        │                  network, etc.\\n        │                       │\\n        │                       ▼\\n        │                  Task queues\\n        │                       │\\n        └─────────────── Event Loop\\n                                │\\n                                ▼\\n                           Call Stack\\n```\\n\\nImportant:\\n\\n**The event loop is not simply \\\"JavaScript running things in parallel.\\\"**\\n\\nJavaScript execution itself is generally performed on a single main JS thread in the typical browser model, while the host environment can perform asynchronous work outside the JS call stack.\\n\\n---\\n\\n# 7.18 `setTimeout`\\n\\nExample:\\n\\n```javascript\\nconsole.log(\\\"1\\\");\\n\\nsetTimeout(() =\u003e {\\n    console.log(\\\"2\\\");\\n}, 0);\\n\\nconsole.log(\\\"3\\\");\\n```\\n\\nExecution:\\n\\n### Step 1\\n\\n```javascript\\nconsole.log(\\\"1\\\");\\n```\\n\\nOutput:\\n\\n```text\\n1\\n```\\n\\n### Step 2\\n\\n```javascript\\nsetTimeout(...)\\n```\\n\\nTimer is registered with the host environment.\\n\\nJavaScript continues.\\n\\n### Step 3\\n\\n```javascript\\nconsole.log(\\\"3\\\");\\n```\\n\\nOutput:\\n\\n```text\\n3\\n```\\n\\nOnly after the current synchronous execution completes can the timer callback be processed.\\n\\nEventually:\\n\\n```text\\n2\\n```\\n\\nFinal:\\n\\n```text\\n1\\n3\\n2\\n```\\n\\n---\\n\\n# 7.19 Microtasks vs Macrotasks\\n\\nThis is **extremely important for interviews**.\\n\\nJavaScript has different kinds of queued work.\\n\\n### Microtasks\\n\\nExamples include:\\n\\n```javascript\\nPromise.then()\\nPromise.catch()\\nPromise.finally()\\nqueueMicrotask()\\n```\\n\\n### Tasks / Macrotasks\\n\\nExamples commonly include:\\n\\n```javascript\\nsetTimeout()\\nsetInterval()\\n```\\n\\nBrowser environments have additional task sources as well.\\n\\nThe simplified interview model is:\\n\\n```text\\nSynchronous code\\n      ↓\\nMicrotasks\\n      ↓\\nNext task\\n      ↓\\nMicrotasks\\n      ↓\\nNext task\\n      ↓\\n...\\n```\\n\\nSo:\\n\\n\u003e **Microtasks generally get priority over the next task once the current synchronous execution finishes.**\\n\\n---\\n\\n# 7.20 Classic Interview Question\\n\\n```javascript\\nconsole.log(\\\"A\\\");\\n\\nsetTimeout(() =\u003e {\\n    console.log(\\\"B\\\");\\n}, 0);\\n\\nPromise.resolve().then(() =\u003e {\\n    console.log(\\\"C\\\");\\n});\\n\\nconsole.log(\\\"D\\\");\\n```\\n\\nWhat is the output?\\n\\nLet's execute it.\\n\\nFirst synchronous code:\\n\\n```text\\nA\\nD\\n```\\n\\nThen the microtask:\\n\\n```text\\nC\\n```\\n\\nThen the timer task:\\n\\n```text\\nB\\n```\\n\\nTherefore:\\n\\n```text\\nA\\nD\\nC\\nB\\n```\\n\\n🔥 Memorize the reasoning, not just the output.\\n\\n---\\n\\n# 7.21 Another Interview Question\\n\\n```javascript\\nconsole.log(\\\"1\\\");\\n\\nsetTimeout(() =\u003e {\\n    console.log(\\\"2\\\");\\n}, 0);\\n\\nPromise.resolve().then(() =\u003e {\\n    console.log(\\\"3\\\");\\n});\\n\\nPromise.resolve().then(() =\u003e {\\n    console.log(\\\"4\\\");\\n});\\n\\nconsole.log(\\\"5\\\");\\n```\\n\\nOutput:\\n\\n```text\\n1\\n5\\n3\\n4\\n2\\n```\\n\\nWhy?\\n\\n```text\\nSynchronous:\\n1\\n5\\n\\nMicrotask queue:\\n3\\n4\\n\\nTask queue:\\n2\\n```\\n\\nThe microtasks are processed before moving to the timer task.\\n\\n---\\n\\n# 7.22 Promises\\n\\nNow we need to understand what a Promise actually represents.\\n\\nA Promise represents the eventual result of an asynchronous operation.\\n\\nIt can be:\\n\\n```text\\npending\\n   ↓\\nfulfilled\\n```\\n\\nor:\\n\\n```text\\npending\\n   ↓\\nrejected\\n```\\n\\nOnce settled, it doesn't go back.\\n\\nExample:\\n\\n```javascript\\nconst promise = new Promise((resolve, reject) =\u003e {\\n\\n    const success = true;\\n\\n    if (success) {\\n        resolve(\\\"Success\\\");\\n    } else {\\n        reject(\\\"Failed\\\");\\n    }\\n});\\n```\\n\\nThen:\\n\\n```javascript\\npromise.then(result =\u003e {\\n    console.log(result);\\n});\\n```\\n\\n---\\n\\n# 7.23 Promise States\\n\\nThink:\\n\\n```text\\n              pending\\n             /       \\\\\\n            /         \\\\\\n       fulfilled     rejected\\n```\\n\\nOnce:\\n\\n```text\\nfulfilled\\n```\\n\\nit stays fulfilled.\\n\\nOnce:\\n\\n```text\\nrejected\\n```\\n\\nit stays rejected.\\n\\n---\\n\\n# 7.24 Java Comparison\\n\\nJava doesn't have a perfect one-to-one equivalent.\\n\\nThe closest conceptual comparisons include:\\n\\n```java\\nCompletableFuture\u003cT\u003e\\n```\\n\\nand older:\\n\\n```java\\nFuture\u003cT\u003e\\n```\\n\\nBut don't say:\\n\\n\u003e Promise = CompletableFuture\\n\\nThey're conceptually related, but JavaScript Promises have their own semantics and integration with the JS event loop/microtask model.\\n\\nA good interview answer:\\n\\n\u003e JavaScript Promises represent eventual completion or failure of an asynchronous operation. Java's `CompletableFuture` is conceptually similar, but they are not identical.\\n\\n---\\n\\n# 7.25 Promise Chaining\\n\\n```javascript\\nfetchData()\\n    .then(data =\u003e {\\n        return processData(data);\\n    })\\n    .then(result =\u003e {\\n        console.log(result);\\n    })\\n    .catch(error =\u003e {\\n        console.log(error);\\n    });\\n```\\n\\nEach `.then()` returns another Promise.\\n\\nThat's what enables chaining.\\n\\n---\\n\\n# 7.26 `async` / `await`\\n\\nModern JavaScript normally uses:\\n\\n```javascript\\nasync/await\\n```\\n\\ninstead of long `.then()` chains.\\n\\nExample:\\n\\n```javascript\\nasync function getUser() {\\n    const response = await fetch(\\\"/api/user\\\");\\n\\n    const data = await response.json();\\n\\n    console.log(data);\\n}\\n```\\n\\n`await` makes asynchronous code **look sequential**, but it does not turn the operation into a blocking synchronous operation in the usual JS execution model.\\n\\nThis distinction is extremely important.\\n\\n---\\n\\n# 7.27 Java Comparison\\n\\nJava:\\n\\n```java\\nCompletableFuture\u003cUser\u003e future = getUser();\\n\\nfuture.thenAccept(user -\u003e {\\n    System.out.println(user);\\n});\\n```\\n\\nJavaScript:\\n\\n```javascript\\nconst user = await getUser();\\n```\\n\\nConceptually both support asynchronous composition.\\n\\nBut JavaScript:\\n\\n```javascript\\nawait\\n```\\n\\ndoesn't block the JS thread waiting for the result in the way a traditional blocking call does.\\n\\n---\\n\\n# 7.28 `try/catch` with `async/await`\\n\\n```javascript\\nasync function getData() {\\n    try {\\n        const response = await fetch(\\\"/api/data\\\");\\n        const data = await response.json();\\n\\n        console.log(data);\\n    } catch (error) {\\n        console.log(error);\\n    }\\n}\\n```\\n\\nVery similar in appearance to Java exception handling:\\n\\n```java\\ntry {\\n    ...\\n} catch (Exception e) {\\n    ...\\n}\\n```\\n\\nBut Promise rejection is a key JavaScript concept.\\n\\n---\\n\\n# 7.29 The Big Mental Model\\n\\nAt this point, you should be able to visualize:\\n\\n```text\\n                 JavaScript Runtime\\n                        │\\n                        ▼\\n                 ┌─────────────┐\\n                 │ Call Stack  │\\n                 └──────┬──────┘\\n                        │\\n                 synchronous code\\n                        │\\n                        ▼\\n                Host async APIs\\n                        │\\n                        ▼\\n                 Queued callbacks\\n                        │\\n                 ┌──────┴──────┐\\n                 │             │\\n             Microtasks      Tasks\\n                 │             │\\n                 └──────┬──────┘\\n                        │\\n                    Event Loop\\n                        │\\n                        ▼\\n                   Call Stack\\n```\\n\\nAnd execution contexts sit conceptually within the stack:\\n\\n```text\\nCall Stack\\n│\\n├── Function Execution Context\\n├── Function Execution Context\\n└── Global Execution Context\\n```\\n\\n---\\n\\n# 🔥 Phase 7 Interview Questions\\n\\nYou should be able to answer these **without looking at notes**:\\n\\n### Q1\\nWhat is an execution context?\\n\\n### Q2\\nWhat is the call stack?\\n\\n### Q3\\nWhat is lexical scope?\\n\\n### Q4\\nWhat is the scope chain?\\n\\n### Q5\\nAre `let` and `const` hoisted?\\n\\n### Q6\\nWhat is the Temporal Dead Zone?\\n\\n### Q7\\nWhat is a closure?\\n\\n### Q8\\nWhy does this work?\\n\\n```javascript\\nfunction counter() {\\n    let x = 0;\\n\\n    return () =\u003e ++x;\\n}\\n\\nconst c = counter();\\n\\nconsole.log(c());\\nconsole.log(c());\\n```\\n\\n### Q9\\nWhat is the event loop?\\n\\n### Q10\\nWhat is the difference between a microtask and a task?\\n\\n### Q11\\nPredict:\\n\\n```javascript\\nconsole.log(\\\"A\\\");\\n\\nsetTimeout(() =\u003e console.log(\\\"B\\\"), 0);\\n\\nPromise.resolve().then(() =\u003e console.log(\\\"C\\\"));\\n\\nconsole.log(\\\"D\\\");\\n```\\n\\nAnswer:\\n\\n```text\\nA\\nD\\nC\\nB\\n```\\n\\n### Q12\\nDoes `setTimeout(fn, 0)` execute immediately?\\n\\n**No.**\\n\\n### Q13\\nWhat does `await` actually do?\\n\\n### Q14\\nWhat are the states of a Promise?\\n\\n### Q15\\nHow is a JavaScript Promise conceptually related to Java's `CompletableFuture`?\\n\\n---\\n\\n# 🧪 Phase 7 Coding Checkpoint\\n\\nBefore moving to Phase 8, try predicting the output of these **without running them**.\\n\\n### Problem 1\\n\\n```javascript\\nconsole.log(\\\"1\\\");\\n\\nfunction test() {\\n    console.log(\\\"2\\\");\\n\\n    setTimeout(() =\u003e {\\n        console.log(\\\"3\\\");\\n    }, 0);\\n\\n    console.log(\\\"4\\\");\\n}\\n\\ntest();\\n\\nconsole.log(\\\"5\\\");\\n```\\n\\n### Problem 2\\n\\n```javascript\\nconsole.log(\\\"A\\\");\\n\\nPromise.resolve().then(() =\u003e {\\n    console.log(\\\"B\\\");\\n});\\n\\nsetTimeout(() =\u003e {\\n    console.log(\\\"C\\\");\\n}, 0);\\n\\nPromise.resolve().then(() =\u003e {\\n    console.log(\\\"D\\\");\\n});\\n\\nconsole.log(\\\"E\\\");\\n```\\n\\n### Problem 3 — Closure\\n\\n```javascript\\nfunction create() {\\n    let x = 10;\\n\\n    return function () {\\n        x += 5;\\n        console.log(x);\\n    };\\n}\\n\\nconst a = create();\\nconst b = create();\\n\\na();\\na();\\nb();\\na();\\nb();\\n```\\n\\n### Problem 4 — Hoisting\\n\\n```javascript\\nconsole.log(a);\\n\\nvar a = 10;\\n\\nconsole.log(b);\\n\\nlet b = 20;\\n```\\n\\nDon't just memorize the outputs. Explain **why** each line behaves that way.\\n\\n---\\n\\n## 🗺️ Where we are in the complete course\\n\\n```text\\n✅ Phase 0  Java → JS Mental Model\\n✅ Phase 1  Variables \u0026 Data Types\\n✅ Phase 1B Operators \u0026 Coercion\\n✅ Phase 2  Conditions \u0026 Loops\\n✅ Phase 3  Arrays\\n✅ Phase 4  Objects\\n✅ Phase 5  Functions\\n✅ Phase 6  this + OOP + Prototypes\\n\\n🔥 Phase 7  Execution Model\\n   ├── Execution Context\\n   ├── Call Stack\\n   ├── Lexical Environment\\n   ├── Scope Chain\\n   ├── Hoisting\\n   ├── TDZ\\n   ├── Closures\\n   ├── Event Loop\\n   ├── Microtasks\\n   ├── Tasks\\n   ├── Promises\\n   └── async/await\\n\\n➡️ Phase 8  Advanced Functions \u0026 Functional JavaScript\\n   ├── callbacks\\n   ├── higher-order functions\\n   ├── currying\\n   ├── partial application\\n   ├── composition\\n   ├── memoization\\n   ├── generators\\n   ├── iterators\\n   └── advanced function patterns\\n```\\n\\n**Phase 7 is a major interview milestone.** If you understand the execution context → call stack → closure → event loop → microtask/task relationship properly, a large portion of the \\\"tricky JavaScript\\\" interview questions becomes much easier.\",{},{\"_197\":2477,\"_204\":2720,\"_54\":2721,\"_208\":2722,\"_210\":211,\"_213\":214,\"_215\":2723,\"_217\":218},\"619c0250-c07b-4fcd-bf67-61feaeb86d46\",[2465],{\"_656\":657,\"_215\":2724},1789312194.718387,{\"_651\":667,\"_668\":669},{\"_233\":234,\"_240\":2491,\"_242\":2491,\"_245\":2718,\"_248\":10,\"_666\":34},{},{\"_197\":2718,\"_204\":2728,\"_54\":2729,\"_208\":2730,\"_210\":211,\"_213\":214,\"_215\":2731,\"_217\":218},\"9316c60d-ddc9-42ec-8ad1-b616ed9d5067\",[2477],{\"_656\":681,\"_215\":2734},1789312194.4172251,{\"_651\":652,\"_653\":2733},{\"_678\":34,\"_246\":2732,\"_228\":67,\"_233\":234,\"_236\":2490,\"_238\":239,\"_240\":2491,\"_242\":2491,\"_243\":67,\"_66\":67,\"_245\":2726,\"_248\":10,\"_244\":14},\"eb83fdfa-a7c3-4116-9db9-7caab2e4962a\",[669],{},{\"_197\":2726,\"_204\":2738,\"_54\":2739,\"_208\":2740,\"_210\":211,\"_213\":214,\"_215\":2741,\"_217\":218},\"da9c30e8-0ba4-4c15-9cc5-88496b886be7\",[2718],{\"_656\":681,\"_215\":2743},1789312194.416882,{\"_651\":652,\"_653\":2742},{\"_678\":34,\"_246\":2732,\"_228\":67,\"_233\":234,\"_236\":2490,\"_238\":239,\"_240\":2491,\"_242\":2491,\"_243\":67,\"_66\":67,\"_245\":2736,\"_248\":10,\"_244\":14},[669],{},{\"_197\":2736,\"_204\":2747,\"_54\":2748,\"_208\":2749,\"_210\":211,\"_212\":34,\"_213\":689,\"_215\":2750,\"_217\":218},\"4337b87a-382c-4a67-96c3-36df86b10e95\",[2726],{\"_656\":681,\"_215\":2752},1789312195.195905,{\"_651\":652,\"_653\":2751},{\"_691\":34,\"_678\":34,\"_246\":2732,\"_228\":67,\"_233\":234,\"_236\":2490,\"_238\":239,\"_240\":2491,\"_242\":2491,\"_243\":67,\"_66\":67,\"_245\":2745,\"_248\":10,\"_244\":14},[669],{},{\"_197\":2745,\"_204\":2756,\"_54\":2757,\"_56\":2758,\"_208\":2759,\"_210\":211,\"_213\":214,\"_215\":2760,\"_217\":218},\"3ca7e509-4e32-46f3-b008-9b45f52315ab\",[2736],{\"_656\":709,\"_215\":2764},1789312196.048,1789312233.606143,{\"_651\":652,\"_653\":2763},{\"_702\":2761,\"_236\":2490,\"_704\":-5,\"_240\":2491,\"_242\":2491,\"_246\":2732,\"_248\":10,\"_244\":14},{\"_705\":2762},[],[708],{},{\"_197\":2754,\"_204\":2768,\"_54\":2769,\"_56\":2770,\"_208\":2771,\"_210\":211,\"_212\":34,\"_213\":214,\"_215\":2772,\"_217\":218,\"_219\":220},\"2545aa4b-9ef3-4082-8ff5-06e853455fb7\",[2745],{\"_656\":657,\"_215\":2782},1789140870.216809,1789140915.871965,{\"_651\":652,\"_653\":2780},{\"_224\":2773,\"_249\":2774,\"_226\":2775,\"_228\":67,\"_231\":2776,\"_233\":234,\"_235\":34,\"_236\":2777,\"_238\":239,\"_240\":2778,\"_242\":2778,\"_243\":67,\"_66\":67,\"_244\":34,\"_245\":2766,\"_246\":2779,\"_248\":10},[],[],[],[],\"1349b49a-43bb-41a0-8a54-cab281749213\",\"2e1075c0-0381-40c6-9e8d-ef1e3e2247f4\",\"e5071f5b-bebc-4835-adde-9364c3a0f3f9\",[2781],\"# Phase 6 — `this`, OOP \u0026 Prototypes 🔥\\n\\nThis is one of the phases where **knowing Java can actually mislead you**.\\n\\nIn Java, `this` is relatively straightforward:\\n\\n```java\\nclass Student {\\n    String name;\\n\\n    void printName() {\\n        System.out.println(this.name);\\n    }\\n}\\n```\\n\\nIn JavaScript, **`this` is determined primarily by how a function is called**, not simply by where it was defined.\\n\\nThat single idea explains a huge amount of JavaScript behavior.\\n\\n---\\n\\n# 6.1 `this` in a Java class\\n\\nJava:\\n\\n```java\\nclass Student {\\n    String name;\\n\\n    Student(String name) {\\n        this.name = name;\\n    }\\n\\n    void printName() {\\n        System.out.println(this.name);\\n    }\\n}\\n```\\n\\nWhen:\\n\\n```java\\nStudent s = new Student(\\\"Dev\\\");\\ns.printName();\\n```\\n\\n`this` refers to `s`.\\n\\nSimple.\\n\\n---\\n\\n# 6.2 JavaScript object method\\n\\nJavaScript:\\n\\n```js\\nconst student = {\\n    name: \\\"Dev\\\",\\n\\n    printName() {\\n        console.log(this.name);\\n    }\\n};\\n\\nstudent.printName();\\n```\\n\\nOutput:\\n\\n```text\\nDev\\n```\\n\\nHere:\\n\\n```js\\nstudent.printName()\\n```\\n\\ncauses `this` inside `printName()` to refer to:\\n\\n```text\\nstudent\\n```\\n\\nSo:\\n\\n```js\\nthis.name\\n```\\n\\nmeans:\\n\\n```js\\nstudent.name\\n```\\n\\n---\\n\\n# 6.3 The critical rule\\n\\nFor a **regular function**, ask:\\n\\n\u003e **How was the function called?**\\n\\nNot:\\n\\n\u003e Where was the function written?\\n\\nExample:\\n\\n```js\\nconst user = {\\n    name: \\\"Dev\\\",\\n\\n    greet() {\\n        console.log(this.name);\\n    }\\n};\\n\\nuser.greet();\\n```\\n\\nHere:\\n\\n```text\\nthis → user\\n```\\n\\nbecause the call is:\\n\\n```text\\nuser.greet()\\n```\\n\\n---\\n\\n# 6.4 The same function can have a different `this`\\n\\nLook:\\n\\n```js\\nconst user1 = {\\n    name: \\\"Dev\\\",\\n    greet() {\\n        console.log(this.name);\\n    }\\n};\\n\\nconst user2 = {\\n    name: \\\"Alex\\\",\\n    greet: user1.greet\\n};\\n\\nuser2.greet();\\n```\\n\\nOutput:\\n\\n```text\\nAlex\\n```\\n\\nThe function was originally written inside `user1`.\\n\\nBut when called as:\\n\\n```js\\nuser2.greet()\\n```\\n\\n`this` becomes `user2`.\\n\\nThis is a **major difference from Java's mental model**.\\n\\n---\\n\\n# 6.5 Losing `this`\\n\\nConsider:\\n\\n```js\\nconst user = {\\n    name: \\\"Dev\\\",\\n\\n    greet() {\\n        console.log(this.name);\\n    }\\n};\\n\\nuser.greet();\\n```\\n\\nWorks.\\n\\nBut:\\n\\n```js\\nconst greet = user.greet;\\n\\ngreet();\\n```\\n\\nNow the function isn't being called as:\\n\\n```js\\nuser.greet()\\n```\\n\\nThe object context has been lost.\\n\\nThis is one of the most common JavaScript `this` problems.\\n\\n---\\n\\n# 6.6 Arrow functions are different ⭐⭐⭐\\n\\nArrow functions don't get their own `this`.\\n\\nExample:\\n\\n```js\\nconst user = {\\n    name: \\\"Dev\\\",\\n\\n    greet: () =\u003e {\\n        console.log(this.name);\\n    }\\n};\\n\\nuser.greet();\\n```\\n\\nDon't think:\\n\\n\u003e \\\"`greet` belongs to `user`, therefore `this = user`.\\\"\\n\\nThat rule **doesn't apply to arrow functions**.\\n\\nArrow functions capture `this` from their surrounding lexical environment.\\n\\n### Critical rule\\n\\n```text\\nRegular function\\n→ this determined by call\\n\\nArrow function\\n→ this inherited lexically\\n```\\n\\nMemorize that distinction.\\n\\n---\\n\\n# 6.7 Why React developers care\\n\\nYou'll frequently see:\\n\\n```js\\nconst handleClick = () =\u003e {\\n    // ...\\n};\\n```\\n\\nArrow functions are convenient partly because they don't create a new `this`.\\n\\nOlder React class components had many `this` issues, which is one reason understanding this topic matters historically and in interviews.\\n\\n---\\n\\n# 6.8 `call()`\\n\\nJavaScript lets you explicitly control `this`.\\n\\n```js\\nfunction greet() {\\n    console.log(this.name);\\n}\\n\\nconst user = {\\n    name: \\\"Dev\\\"\\n};\\n\\ngreet.call(user);\\n```\\n\\nOutput:\\n\\n```text\\nDev\\n```\\n\\n`call()` essentially says:\\n\\n\u003e Execute this function with `this` set to this object.\\n\\n---\\n\\n# 6.9 `call()` with arguments\\n\\n```js\\nfunction greet(message) {\\n    console.log(`${message}, ${this.name}`);\\n}\\n\\nconst user = {\\n    name: \\\"Dev\\\"\\n};\\n\\ngreet.call(user, \\\"Hello\\\");\\n```\\n\\nOutput:\\n\\n```text\\nHello, Dev\\n```\\n\\nSyntax:\\n\\n```text\\nfunction.call(thisValue, arg1, arg2, ...)\\n```\\n\\n---\\n\\n# 6.10 `apply()`\\n\\n`apply()` is similar:\\n\\n```js\\nfunction greet(message, punctuation) {\\n    console.log(`${message}, ${this.name}${punctuation}`);\\n}\\n\\nconst user = {\\n    name: \\\"Dev\\\"\\n};\\n\\ngreet.apply(user, [\\\"Hello\\\", \\\"!\\\"]);\\n```\\n\\nOutput:\\n\\n```text\\nHello, Dev!\\n```\\n\\nDifference:\\n\\n```text\\ncall()\\n→ arguments individually\\n\\napply()\\n→ arguments as an array\\n```\\n\\n---\\n\\n# 6.11 `bind()` ⭐⭐⭐\\n\\n`bind()` is different.\\n\\nIt **returns a new function** with `this` permanently bound to the supplied object.\\n\\n```js\\nfunction greet() {\\n    console.log(this.name);\\n}\\n\\nconst user = {\\n    name: \\\"Dev\\\"\\n};\\n\\nconst boundGreet = greet.bind(user);\\n\\nboundGreet();\\n```\\n\\nOutput:\\n\\n```text\\nDev\\n```\\n\\nThink:\\n\\n```text\\ncall()\\n→ call now\\n\\napply()\\n→ call now\\n\\nbind()\\n→ give me a new bound function\\n```\\n\\nThis is an excellent interview answer.\\n\\n---\\n\\n# 6.12 `call` vs `apply` vs `bind`\\n\\n| Method | Executes immediately? | Arguments |\\n|---|---:|---|\\n| `call()` | Yes | Individual |\\n| `apply()` | Yes | Array |\\n| `bind()` | No | Creates new function |\\n\\nExample:\\n\\n```js\\nfn.call(obj, 1, 2);\\nfn.apply(obj, [1, 2]);\\n\\nconst newFn = fn.bind(obj, 1, 2);\\nnewFn();\\n```\\n\\n---\\n\\n# 6.13 JavaScript classes\\n\\nNow let's move into OOP.\\n\\nYou know Java:\\n\\n```java\\nclass Student {\\n    String name;\\n\\n    Student(String name) {\\n        this.name = name;\\n    }\\n\\n    void greet() {\\n        System.out.println(\\\"Hello \\\" + name);\\n    }\\n}\\n```\\n\\nJavaScript:\\n\\n```js\\nclass Student {\\n    constructor(name) {\\n        this.name = name;\\n    }\\n\\n    greet() {\\n        console.log(`Hello ${this.name}`);\\n    }\\n}\\n```\\n\\nCreate object:\\n\\n```js\\nconst student = new Student(\\\"Dev\\\");\\n\\nstudent.greet();\\n```\\n\\nOutput:\\n\\n```text\\nHello Dev\\n```\\n\\nVery similar.\\n\\n---\\n\\n# 6.14 Constructor\\n\\nJava:\\n\\n```java\\nStudent(String name) {\\n    this.name = name;\\n}\\n```\\n\\nJavaScript:\\n\\n```js\\nconstructor(name) {\\n    this.name = name;\\n}\\n```\\n\\nWhen:\\n\\n```js\\nnew Student(\\\"Dev\\\");\\n```\\n\\nthe constructor runs.\\n\\n---\\n\\n# 6.15 Methods\\n\\nJavaScript:\\n\\n```js\\nclass Student {\\n    constructor(name) {\\n        this.name = name;\\n    }\\n\\n    greet() {\\n        console.log(`Hello ${this.name}`);\\n    }\\n\\n    study() {\\n        console.log(`${this.name} is studying`);\\n    }\\n}\\n```\\n\\nThen:\\n\\n```js\\nconst s = new Student(\\\"Dev\\\");\\n\\ns.greet();\\ns.study();\\n```\\n\\nSame familiar OOP structure.\\n\\n---\\n\\n# 6.16 Static methods\\n\\nJava:\\n\\n```java\\nclass MathUtil {\\n    static int add(int a, int b) {\\n        return a + b;\\n    }\\n}\\n```\\n\\nJavaScript:\\n\\n```js\\nclass MathUtil {\\n    static add(a, b) {\\n        return a + b;\\n    }\\n}\\n```\\n\\nCall:\\n\\n```js\\nconsole.log(MathUtil.add(10, 20));\\n```\\n\\nYou don't do:\\n\\n```js\\nconst m = new MathUtil();\\nm.add(10, 20);\\n```\\n\\nbecause `add` belongs to the class itself.\\n\\n---\\n\\n# 6.17 Getters and setters\\n\\nJava often uses:\\n\\n```java\\npublic String getName() {\\n    return name;\\n}\\n\\npublic void setName(String name) {\\n    this.name = name;\\n}\\n```\\n\\nJavaScript supports getter/setter syntax:\\n\\n```js\\nclass Student {\\n    constructor(name) {\\n        this._name = name;\\n    }\\n\\n    get name() {\\n        return this._name;\\n    }\\n\\n    set name(value) {\\n        this._name = value;\\n    }\\n}\\n```\\n\\nThen:\\n\\n```js\\nconst s = new Student(\\\"Dev\\\");\\n\\nconsole.log(s.name);\\n```\\n\\nYou don't call:\\n\\n```js\\ns.name();\\n```\\n\\nThe getter is accessed like a property.\\n\\n---\\n\\n# 6.18 Inheritance\\n\\nJava:\\n\\n```java\\nclass Animal {\\n    void eat() {\\n        System.out.println(\\\"Eating\\\");\\n    }\\n}\\n\\nclass Dog extends Animal {\\n}\\n```\\n\\nJavaScript:\\n\\n```js\\nclass Animal {\\n    eat() {\\n        console.log(\\\"Eating\\\");\\n    }\\n}\\n\\nclass Dog extends Animal {\\n}\\n```\\n\\nThen:\\n\\n```js\\nconst dog = new Dog();\\n\\ndog.eat();\\n```\\n\\nOutput:\\n\\n```text\\nEating\\n```\\n\\n---\\n\\n# 6.19 `super`\\n\\nJava:\\n\\n```java\\nclass Dog extends Animal {\\n    Dog() {\\n        super();\\n    }\\n}\\n```\\n\\nJavaScript:\\n\\n```js\\nclass Dog extends Animal {\\n    constructor(name) {\\n        super();\\n        this.name = name;\\n    }\\n}\\n```\\n\\n`super()` invokes the parent constructor.\\n\\nYou can also call parent methods:\\n\\n```js\\nsuper.eat();\\n```\\n\\n---\\n\\n# 6.20 Method overriding\\n\\nJava:\\n\\n```java\\nclass Animal {\\n    void sound() {\\n        System.out.println(\\\"Animal sound\\\");\\n    }\\n}\\n\\nclass Dog extends Animal {\\n    @Override\\n    void sound() {\\n        System.out.println(\\\"Bark\\\");\\n    }\\n}\\n```\\n\\nJavaScript:\\n\\n```js\\nclass Animal {\\n    sound() {\\n        console.log(\\\"Animal sound\\\");\\n    }\\n}\\n\\nclass Dog extends Animal {\\n    sound() {\\n        console.log(\\\"Bark\\\");\\n    }\\n}\\n```\\n\\nThen:\\n\\n```js\\nconst dog = new Dog();\\n\\ndog.sound();\\n```\\n\\n→\\n\\n```text\\nBark\\n```\\n\\n---\\n\\n# 6.21 `instanceof`\\n\\nJava:\\n\\n```java\\ndog instanceof Dog\\n```\\n\\nJavaScript:\\n\\n```js\\nconst dog = new Dog();\\n\\nconsole.log(dog instanceof Dog);\\n```\\n\\n→\\n\\n```text\\ntrue\\n```\\n\\nAlso:\\n\\n```js\\nconsole.log(dog instanceof Animal);\\n```\\n\\n→\\n\\n```text\\ntrue\\n```\\n\\nbecause `Dog` inherits from `Animal`.\\n\\n---\\n\\n# 6.22 Now the important part: prototypes\\n\\nEverything above looks like Java.\\n\\nBut now we need to understand what's actually happening.\\n\\nJavaScript is fundamentally **prototype-based**.\\n\\nConsider:\\n\\n```js\\nclass Student {\\n    greet() {\\n        console.log(\\\"Hello\\\");\\n    }\\n}\\n```\\n\\nCreate:\\n\\n```js\\nconst s1 = new Student();\\nconst s2 = new Student();\\n```\\n\\nDo both objects need their own separate copy of `greet()`?\\n\\nNo.\\n\\nThe method is available through the prototype.\\n\\nConceptually:\\n\\n```text\\ns1 ──────→ Student.prototype\\n              ↑\\ns2 ──────┘\\n```\\n\\nBoth instances can find:\\n\\n```text\\ngreet()\\n```\\n\\nthrough:\\n\\n```js\\nStudent.prototype\\n```\\n\\n---\\n\\n# 6.23 What is a prototype?\\n\\nEvery JavaScript object can have an internal link to another object called its **prototype**.\\n\\nWhen you try:\\n\\n```js\\nobj.someProperty\\n```\\n\\nJavaScript roughly does:\\n\\n```text\\n1. Look on obj\\n2. Not found?\\n3. Look on obj's prototype\\n4. Not found?\\n5. Look on prototype's prototype\\n6. Continue...\\n7. Stop at null\\n```\\n\\nThis is the:\\n\\n\u003e **Prototype chain**\\n\\n---\\n\\n# 6.24 Prototype chain example\\n\\n```js\\nconst dog = {\\n    name: \\\"Bruno\\\"\\n};\\n```\\n\\nYou can do:\\n\\n```js\\ndog.toString();\\n```\\n\\nBut you didn't define:\\n\\n```js\\ntoString\\n```\\n\\non `dog`.\\n\\nSo where did it come from?\\n\\nThrough the prototype chain.\\n\\nConceptually:\\n\\n```text\\ndog\\n ↓\\nObject.prototype\\n ↓\\nnull\\n```\\n\\n`Object.prototype` provides methods such as `toString()`.\\n\\n---\\n\\n# 6.25 `Object.getPrototypeOf()`\\n\\nYou can inspect an object's prototype:\\n\\n```js\\nconst user = {\\n    name: \\\"Dev\\\"\\n};\\n\\nconsole.log(Object.getPrototypeOf(user));\\n```\\n\\nFor a normal object literal, this leads to:\\n\\n```text\\nObject.prototype\\n```\\n\\n---\\n\\n# 6.26 The `prototype` property vs prototype object\\n\\nThis causes **massive confusion** in interviews.\\n\\nThere are two related concepts:\\n\\n```text\\nobject's [[Prototype]]\\n```\\n\\nand:\\n\\n```text\\nConstructorFunction.prototype\\n```\\n\\nThey aren't exactly the same thing.\\n\\nFor a class:\\n\\n```js\\nclass Student {\\n    greet() {}\\n}\\n```\\n\\nyou can access:\\n\\n```js\\nStudent.prototype\\n```\\n\\nThat is the object from which instances can inherit methods.\\n\\nAnd:\\n\\n```js\\nconst s = new Student();\\n\\nObject.getPrototypeOf(s) === Student.prototype\\n```\\n\\nis:\\n\\n```text\\ntrue\\n```\\n\\nThat's the relationship you should understand.\\n\\n---\\n\\n# 6.27 `__proto__`\\n\\nYou may see:\\n\\n```js\\nobj.__proto__\\n```\\n\\nThis exposes an object's prototype in many environments.\\n\\nBut modern code generally prefers:\\n\\n```js\\nObject.getPrototypeOf(obj)\\n```\\n\\nand:\\n\\n```js\\nObject.setPrototypeOf(obj, prototype)\\n```\\n\\nDon't build new code around `__proto__`.\\n\\nBut **know what it means for interviews and legacy code**.\\n\\n---\\n\\n# 6.28 Constructor functions — before `class`\\n\\nBefore `class` syntax became available, JavaScript commonly used constructor functions:\\n\\n```js\\nfunction Student(name) {\\n    this.name = name;\\n}\\n\\nStudent.prototype.greet = function() {\\n    console.log(`Hello ${this.name}`);\\n};\\n```\\n\\nThen:\\n\\n```js\\nconst s = new Student(\\\"Dev\\\");\\n\\ns.greet();\\n```\\n\\nThis works.\\n\\nThe prototype-based model existed before the `class` syntax.\\n\\n---\\n\\n# 6.29 What `new` does\\n\\nThis is a very important interview topic.\\n\\nWhen you do:\\n\\n```js\\nconst s = new Student(\\\"Dev\\\");\\n```\\n\\nconceptually, `new` does several things:\\n\\n```text\\n1. Creates a new object\\n2. Links it to Student.prototype\\n3. Calls Student with this = new object\\n4. Returns the resulting object\\n```\\n\\nSo:\\n\\n```js\\nnew Student()\\n```\\n\\nis doing much more than simply calling a function.\\n\\n---\\n\\n# 6.30 Private fields\\n\\nModern JavaScript supports private class fields using `#`.\\n\\n```js\\nclass BankAccount {\\n    #balance = 0;\\n\\n    deposit(amount) {\\n        this.#balance += amount;\\n    }\\n\\n    getBalance() {\\n        return this.#balance;\\n    }\\n}\\n```\\n\\nThen:\\n\\n```js\\nconst account = new BankAccount();\\n\\naccount.deposit(100);\\n\\nconsole.log(account.getBalance());\\n```\\n\\n→\\n\\n```text\\n100\\n```\\n\\nBut:\\n\\n```js\\naccount.#balance;\\n```\\n\\nis invalid outside the class.\\n\\nThis is genuine JavaScript private-field syntax.\\n\\n---\\n\\n# 6.31 Java vs JavaScript OOP\\n\\n| Java | JavaScript |\\n|---|---|\\n| Class-based | Prototype-based |\\n| `class` fundamental | `class` syntax built over prototypes |\\n| `this` tied to current instance | `this` depends on invocation for regular functions |\\n| Method overloading | No traditional overload resolution |\\n| Interfaces | No direct equivalent |\\n| `private` | `#privateField` |\\n| `extends` | `extends` |\\n| `super` | `super` |\\n| `instanceof` | `instanceof` |\\n| Constructor | `constructor()` |\\n| `static` | `static` |\\n\\n---\\n\\n# 🚨 Most important Phase 6 rules\\n\\nIf you remember nothing else:\\n\\n### Rule 1\\n\\n```js\\nobj.method()\\n```\\n\\nFor a regular function:\\n\\n```text\\nthis → obj\\n```\\n\\n---\\n\\n### Rule 2\\n\\nArrow functions:\\n\\n```js\\n() =\u003e {}\\n```\\n\\ndon't have their own `this`.\\n\\nThey capture it lexically.\\n\\n---\\n\\n### Rule 3\\n\\n```text\\ncall()  → invoke now, arguments separately\\napply() → invoke now, arguments array\\nbind()  → create bound function\\n```\\n\\n---\\n\\n### Rule 4\\n\\nJavaScript `class` syntax exists, but:\\n\\n```text\\nunderneath → prototypes\\n```\\n\\n---\\n\\n### Rule 5\\n\\nPrototype lookup:\\n\\n```text\\nobject\\n ↓\\nprototype\\n ↓\\nprototype\\n ↓\\n...\\n ↓\\nnull\\n```\\n\\n---\\n\\n# 🔥 Interview questions\\n\\n### Q1 — Very important\\n\\nWhat determines `this` in a regular JavaScript function?\\n\\n**Answer:**\\n\\n\u003e Primarily how the function is invoked. For example, in `obj.method()`, `this` refers to `obj`.\\n\\n---\\n\\n### Q2\\n\\nHow are arrow functions different regarding `this`?\\n\\n\u003e Arrow functions don't have their own `this`; they lexically inherit `this` from their surrounding scope.\\n\\n---\\n\\n### Q3\\n\\nDifference between `call`, `apply`, and `bind`?\\n\\n\u003e `call` invokes immediately with individual arguments, `apply` invokes immediately with arguments supplied as an array-like value, and `bind` returns a new function with `this` bound.\\n\\n---\\n\\n### Q4\\n\\nIs JavaScript class-based or prototype-based?\\n\\nBest answer:\\n\\n\u003e JavaScript is fundamentally prototype-based. ES6 `class` syntax provides a class-like abstraction over the prototype system.\\n\\n---\\n\\n### Q5\\n\\nWhat is the prototype chain?\\n\\n\u003e It's the chain of objects JavaScript follows when looking up a property or method that isn't found directly on the current object.\\n\\n---\\n\\n### Q6\\n\\nWhat does `new` do?\\n\\n\u003e It creates a new object, links it to the constructor's prototype, invokes the constructor with that object as `this`, and returns the resulting object, subject to constructor return semantics.\\n\\n---\\n\\n# 🧪 Coding checkpoint\\n\\n### Problem 1\\n\\nCreate:\\n\\n```js\\nclass Employee\\n```\\n\\nwith:\\n\\n```text\\nname\\nsalary\\n```\\n\\nand a method:\\n\\n```text\\ngetAnnualSalary()\\n```\\n\\nthat returns salary × 12.\\n\\n---\\n\\n### Problem 2\\n\\nCreate:\\n\\n```js\\nclass Manager extends Employee\\n```\\n\\nand add:\\n\\n```text\\ndepartment\\n```\\n\\nUse `super()` correctly.\\n\\n---\\n\\n### Problem 3\\n\\nCreate an object:\\n\\n```js\\nconst user = {\\n    name: \\\"Dev\\\",\\n\\n    greet() {\\n        console.log(this.name);\\n    }\\n};\\n```\\n\\nThen explain why:\\n\\n```js\\nuser.greet();\\n```\\n\\nworks, but:\\n\\n```js\\nconst greet = user.greet;\\ngreet();\\n```\\n\\ndoesn't preserve the same `this`.\\n\\n---\\n\\n### Problem 4 — important\\n\\nImplement:\\n\\n```js\\nfunction multiply(a, b) {\\n    return a * b;\\n}\\n```\\n\\nThen use `call()` to execute it with a chosen `this` value.\\n\\nThe `this` won't actually affect multiplication yet—the point is to practice the API.\\n\\n---\\n\\n### Problem 5 — prototype\\n\\nCreate:\\n\\n```js\\nfunction Person(name) {\\n    this.name = name;\\n}\\n```\\n\\nThen add:\\n\\n```js\\nPerson.prototype.greet = function() {\\n    console.log(`Hello ${this.name}`);\\n};\\n```\\n\\nCreate two people and call `greet()` on both.\\n\\n---\\n\\n## Next Phase — Advanced JavaScript Execution 🔥🔥\\n\\nNow we'll leave basic OOP and learn the stuff that separates someone who **knows JavaScript syntax** from someone who actually **understands JavaScript**:\\n\\n```text\\nExecution Context\\nCall Stack\\nGlobal Execution Context\\nFunction Execution Context\\nLexical Environment\\nScope Chain\\nHoisting\\nTemporal Dead Zone\\nClosures in depth\\nEvent Loop\\nMicrotasks\\nMacrotasks\\nPromises\\nasync/await\\n```\\n\\nWe'll also start doing the classic:\\n\\n```js\\nconsole.log(\\\"A\\\");\\n\\nsetTimeout(() =\u003e console.log(\\\"B\\\"), 0);\\n\\nPromise.resolve().then(() =\u003e console.log(\\\"C\\\"));\\n\\nconsole.log(\\\"D\\\");\\n```\\n\\ntype of interview questions and derive the output **step by step**, rather than memorizing `A D C B`.\",{},{\"_197\":2766,\"_204\":2786,\"_54\":2787,\"_208\":2788,\"_210\":211,\"_213\":214,\"_215\":2789,\"_217\":218},\"d71c91f8-cd65-47a1-b97f-ee816243d184\",[2754],{\"_656\":657,\"_215\":2790},1789140870.1810966,{\"_651\":667,\"_668\":669},{\"_233\":234,\"_240\":2778,\"_242\":2778,\"_245\":2784,\"_248\":10,\"_666\":34},{},{\"_197\":2784,\"_204\":2794,\"_54\":2795,\"_208\":2796,\"_210\":211,\"_213\":214,\"_215\":2797,\"_217\":218},\"b58a95cf-8be6-4291-b764-ca907f4ae458\",[2766],{\"_656\":681,\"_215\":2800},1789140869.9833925,{\"_651\":652,\"_653\":2799},{\"_678\":34,\"_246\":2798,\"_228\":67,\"_233\":234,\"_236\":2777,\"_238\":239,\"_240\":2778,\"_242\":2778,\"_243\":67,\"_66\":67,\"_245\":2792,\"_248\":10,\"_244\":14},\"2256dcf0-33b6-4300-87d2-b4e270533389\",[669],{},{\"_197\":2792,\"_204\":2804,\"_54\":2805,\"_208\":2806,\"_210\":211,\"_213\":214,\"_215\":2807,\"_217\":218},\"09660def-09e9-4841-adc2-40a5dbadfa84\",[2784],{\"_656\":681,\"_215\":2809},1789140869.98307,{\"_651\":652,\"_653\":2808},{\"_678\":34,\"_246\":2798,\"_228\":67,\"_233\":234,\"_236\":2777,\"_238\":239,\"_240\":2778,\"_242\":2778,\"_243\":67,\"_66\":67,\"_245\":2802,\"_248\":10,\"_244\":14},[669],{},{\"_197\":2802,\"_204\":2813,\"_54\":28