\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":991,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":990,\"_525\":14,\"_526\":34,\"_527\":531},{\"_197\":989,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":988,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":987,\"_525\":14,\"_526\":34,\"_527\":531},{\"_197\":986,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":985,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":984,\"_525\":14,\"_526\":34,\"_527\":531},{\"_197\":983,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":982,\"_525\":14,\"_526\":34,\"_527\":531},{\"_197\":981,\"_525\":14,\"_526\":34,\"_527\":531},{\"_197\":980,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":979,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":978,\"_525\":14,\"_526\":34,\"_527\":531},{\"_197\":977,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":976,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":975,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":974,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":973,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":972,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":971,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":970,\"_525\":14,\"_526\":34,\"_527\":531},{\"_197\":969,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":968,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":967,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":966,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":965,\"_525\":14,\"_526\":34,\"_527\":531},{\"_197\":964,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":963,\"_525\":14,\"_526\":34,\"_527\":531},{\"_197\":962,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":961,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":960,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":959,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":958,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":957,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":956,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":955,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":954,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":953,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":952,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":951,\"_525\":14,\"_526\":34,\"_527\":531},{\"_197\":950,\"_525\":14,\"_526\":14,\"_527\":-5},\"119\",{\"_197\":949,\"_525\":14,\"_526\":14,\"_527\":-5},\"120\",{\"_197\":948,\"_525\":14,\"_526\":34,\"_527\":531},\"121\",{\"_197\":947,\"_525\":14,\"_526\":14,\"_527\":-5},\"122\",{\"_197\":946,\"_525\":14,\"_526\":34,\"_527\":531},\"123\",{\"_197\":945,\"_525\":14,\"_526\":34,\"_527\":531},\"124\",{\"_197\":944,\"_525\":14,\"_526\":14,\"_527\":-5},\"125\",{\"_197\":943,\"_525\":14,\"_526\":14,\"_527\":-5},\"126\",{\"_197\":942,\"_525\":14,\"_526\":14,\"_527\":-5},\"127\",{\"_197\":941,\"_525\":14,\"_526\":14,\"_527\":-5},\"ve9nh3\",\"v0p3r9\",\"8wp2nh\",\"151ith\",\"dqer6l\",\"cb6q5p\",\"3injfv\",\"r1ez4t\",\"rm1ztw\",\"f50h3c\",\"g3k5ui\",\"pnl48k\",\"2zvz3h\",\"6ehyx0\",\"7v3u4z\",\"y3xwbq\",\"dxb6op\",\"kslnux\",\"yeo1jf\",\"g9qptz\",\"81lu5c\",\"ef88ga\",\"nb6ayl\",\"zkphd0\",\"1q7mb4\",\"n7gazu\",\"3uj3bw\",\"p67gi8\",\"n7u1j4\",\"wtdg3s\",\"qspaec\",\"20isc3\",\"2prjbe\",\"i3fy0n\",\"hfw0jf\",\"nf27ud\",\"lg9tw0\",\"q7anf9\",\"7ny7d7\",\"2qw16a\",\"47n5hc\",\"zb66lq\",\"6middi\",\"b0wem5\",\"7flha1\",\"kn3v95\",\"7lk5km\",\"0jldel\",\"znrlgk\",\"kprhbo\",\"45opvy\",\"wopwla\",\"jq2nte\",\"fkqd4z\",\"sdm37k\",\"kpyn1e\",\"24uiqh\",\"ahahe3\",\"1mj0s5\",\"2an84h\",\"pef4bk\",\"t0qsp3\",\"8aia6x\",\"l8ainj\",\"ctz4y8\",\"0moyli\",\"zodrvi\",\"zzwq29\",\"m8dees\",\"57akf6\",\"tf30d2\",\"wndz83\",\"x544tf\",\"t0pr8w\",\"5t5ex0\",\"zzehh6\",\"dhqgq0\",\"ggw8b2\",\"s0t6z9\",\"bsxdgr\",\"x0m5sc\",\"orynxd\",\"9i49p4\",\"5dwpwh\",\"gu9j7f\",\"u3oef4\",\"vnesql\",\"ms4x21\",\"cl0xnk\",\"wsbg6y\",\"iyd83i\",\"pb6yke\",\"gzuodc\",\"o60ac1\",\"fovjys\",\"ypfhxg\",\"a30abv\",\"txtqci\",\"zbm6i9\",\"ko2fc9\",\"6hjs8w\",\"hxneo1\",\"tjsgvk\",\"t36wcu\",\"7ip4dx\",\"bi4jc1\",\"hrg8kh\",\"g9xdpj\",\"kqnlk2\",\"646la3\",\"kepsn4\",\"9gjnyj\",\"gl1l0r\",\"c1wbuw\",\"zqzjlc\",\"bsxkkr\",\"pfz50t\",\"cqy2o9\",\"2hgcx6\",\"bdjq0k\",\"rnkt7a\",\"hojxdz\",\"2skxq8\",\"wjj86n\",\"2goh41\",\"txflxz\",\"bum7zj\",\"j3ayap\",[650],[1071],\"# 🚀 Phase 12 — Browser \u0026 DOM\\n\\nThis is where JavaScript becomes **frontend JavaScript**.\\n\\nUntil now, we mostly treated JavaScript as a programming language:\\n\\n```javascript\\nlet x = 10;\\nfunction add() {}\\nconst users = [];\\n```\\n\\nNow we'll learn how JavaScript interacts with an actual webpage:\\n\\n```text\\nHTML\\n ↓\\nBrowser creates DOM\\n ↓\\nJavaScript accesses DOM\\n ↓\\nJavaScript changes webpage\\n```\\n\\nSince you know Java, think of the DOM as a **runtime object representation of the HTML document**.\\n\\n---\\n\\n# 12.1 What Is the DOM?\\n\\nDOM = **Document Object Model**\\n\\nSuppose your HTML is:\\n\\n```html\\n\u003c!DOCTYPE html\u003e\\n\u003chtml\u003e\\n    \u003cbody\u003e\\n        \u003ch1\u003eHello\u003c/h1\u003e\\n        \u003cp\u003eWelcome\u003c/p\u003e\\n    \u003c/body\u003e\\n\u003c/html\u003e\\n```\\n\\nThe browser converts this into an object/tree structure.\\n\\nConceptually:\\n\\n```text\\nDocument\\n   │\\n   └── html\\n        │\\n        └── body\\n             ├── h1\\n             │    └── \\\"Hello\\\"\\n             │\\n             └── p\\n                  └── \\\"Welcome\\\"\\n```\\n\\nJavaScript can interact with this tree.\\n\\n---\\n\\n# 12.2 `document`\\n\\nThe main object you use to access the webpage is:\\n\\n```javascript\\ndocument\\n```\\n\\nFor example:\\n\\n```javascript\\nconsole.log(document);\\n```\\n\\nYou can inspect the current HTML document.\\n\\n---\\n\\n# 12.3 `window`\\n\\nIn a browser, JavaScript also has access to:\\n\\n```javascript\\nwindow\\n```\\n\\n`window` represents the browser window/global browsing context.\\n\\nFor example:\\n\\n```javascript\\nconsole.log(window);\\n```\\n\\nYou can access things like:\\n\\n```javascript\\nwindow.location\\nwindow.history\\nwindow.localStorage\\nwindow.setTimeout\\n```\\n\\nand many browser APIs.\\n\\n---\\n\\n# 12.4 `window` vs `document`\\n\\nThink:\\n\\n```text\\nwindow\\n  │\\n  ├── location\\n  ├── history\\n  ├── localStorage\\n  ├── timers\\n  │\\n  └── document\\n        │\\n        └── webpage DOM\\n```\\n\\nSo:\\n\\n\u003e `window` is the broader browser environment, while `document` represents the current HTML document.\\n\\n---\\n\\n# 12.5 Java Comparison\\n\\nThere isn't an exact Java equivalent.\\n\\nBut conceptually:\\n\\n```text\\nHTML\\n ↓\\nDOM tree\\n ↓\\nJavaScript objects representing elements\\n```\\n\\nis somewhat like taking a structured document and representing it as objects that your program can inspect and modify.\\n\\nDon't think:\\n\\n```text\\nDOM = Java object tree\\n```\\n\\nas an exact implementation comparison.\\n\\n---\\n\\n# 12.6 Selecting an Element by ID\\n\\nHTML:\\n\\n```html\\n\u003ch1 id=\\\"title\\\"\u003eHello\u003c/h1\u003e\\n```\\n\\nJavaScript:\\n\\n```javascript\\nconst title = document.getElementById(\\\"title\\\");\\n```\\n\\nNow:\\n\\n```javascript\\nconsole.log(title);\\n```\\n\\ngives you the DOM element.\\n\\n---\\n\\n# 12.7 Changing Text\\n\\n```javascript\\nconst title = document.getElementById(\\\"title\\\");\\n\\ntitle.textContent = \\\"Hello Dev\\\";\\n```\\n\\nHTML changes from:\\n\\n```html\\n\u003ch1 id=\\\"title\\\"\u003eHello\u003c/h1\u003e\\n```\\n\\nto effectively:\\n\\n```html\\n\u003ch1 id=\\\"title\\\"\u003eHello Dev\u003c/h1\u003e\\n```\\n\\n---\\n\\n# 12.8 `textContent` vs `innerHTML`\\n\\nThis is an important interview question.\\n\\nSuppose:\\n\\n```javascript\\nconst element = document.getElementById(\\\"message\\\");\\n```\\n\\nYou can do:\\n\\n```javascript\\nelement.textContent = \\\"\u003cb\u003eHello\u003c/b\u003e\\\";\\n```\\n\\nThe browser treats it as **text**.\\n\\nDisplayed content:\\n\\n```text\\n\u003cb\u003eHello\u003c/b\u003e\\n```\\n\\nBut:\\n\\n```javascript\\nelement.innerHTML = \\\"\u003cb\u003eHello\u003c/b\u003e\\\";\\n```\\n\\ninterprets it as HTML.\\n\\nResult:\\n\\n```text\\nHello\\n```\\n\\nwith bold formatting.\\n\\n---\\n\\n# 12.9 Security Warning — `innerHTML`\\n\\nConsider:\\n\\n```javascript\\nelement.innerHTML = userInput;\\n```\\n\\nIf `userInput` contains malicious HTML/script content, this can create an **XSS vulnerability** depending on the context and browser handling.\\n\\nTherefore:\\n\\n\u003e Don't blindly put untrusted user input into `innerHTML`.\\n\\nFor plain text, prefer:\\n\\n```javascript\\nelement.textContent = userInput;\\n```\\n\\nWe'll study XSS properly in the security phase.\\n\\n---\\n\\n# 12.10 Selecting by Class\\n\\nHTML:\\n\\n```html\\n\u003cp class=\\\"message\\\"\u003eHello\u003c/p\u003e\\n\u003cp class=\\\"message\\\"\u003eWorld\u003c/p\u003e\\n```\\n\\nYou can use:\\n\\n```javascript\\nconst messages =\\n    document.getElementsByClassName(\\\"message\\\");\\n```\\n\\nThis returns an `HTMLCollection`.\\n\\n---\\n\\n# 12.11 Selecting by Tag\\n\\n```javascript\\nconst paragraphs =\\n    document.getElementsByTagName(\\\"p\\\");\\n```\\n\\nThis gets matching `\u003cp\u003e` elements.\\n\\n---\\n\\n# 12.12 `querySelector()`\\n\\nModern JavaScript commonly uses:\\n\\n```javascript\\ndocument.querySelector()\\n```\\n\\nExample:\\n\\n```javascript\\nconst title = document.querySelector(\\\"#title\\\");\\n```\\n\\nSame idea as CSS selectors.\\n\\n### ID\\n\\n```javascript\\ndocument.querySelector(\\\"#title\\\");\\n```\\n\\n### Class\\n\\n```javascript\\ndocument.querySelector(\\\".message\\\");\\n```\\n\\n### Tag\\n\\n```javascript\\ndocument.querySelector(\\\"p\\\");\\n```\\n\\n---\\n\\n# 12.13 `querySelectorAll()`\\n\\nSuppose:\\n\\n```html\\n\u003cp class=\\\"message\\\"\u003eOne\u003c/p\u003e\\n\u003cp class=\\\"message\\\"\u003eTwo\u003c/p\u003e\\n\u003cp class=\\\"message\\\"\u003eThree\u003c/p\u003e\\n```\\n\\nThen:\\n\\n```javascript\\nconst messages =\\n    document.querySelectorAll(\\\".message\\\");\\n```\\n\\nreturns a `NodeList`.\\n\\nYou can iterate:\\n\\n```javascript\\nmessages.forEach(message =\u003e {\\n    console.log(message.textContent);\\n});\\n```\\n\\nOutput:\\n\\n```text\\nOne\\nTwo\\nThree\\n```\\n\\n---\\n\\n# 12.14 `querySelector` vs `querySelectorAll`\\n\\n### `querySelector`\\n\\nReturns the **first matching element**.\\n\\n```javascript\\ndocument.querySelector(\\\".item\\\");\\n```\\n\\n### `querySelectorAll`\\n\\nReturns **all matching elements**.\\n\\n```javascript\\ndocument.querySelectorAll(\\\".item\\\");\\n```\\n\\nEasy interview question.\\n\\n---\\n\\n# 12.15 CSS Selector Power\\n\\nBecause `querySelector()` uses CSS selector syntax, you can write:\\n\\n```javascript\\ndocument.querySelector(\\\"div\\\");\\n```\\n\\n```javascript\\ndocument.querySelector(\\\".card\\\");\\n```\\n\\n```javascript\\ndocument.querySelector(\\\"#title\\\");\\n```\\n\\n```javascript\\ndocument.querySelector(\\\".card p\\\");\\n```\\n\\n```javascript\\ndocument.querySelector(\\\"input[type='text']\\\");\\n```\\n\\n```javascript\\ndocument.querySelector(\\\"ul \u003e li\\\");\\n```\\n\\nThis makes it extremely powerful.\\n\\n---\\n\\n# 12.16 Changing CSS\\n\\nSuppose:\\n\\n```html\\n\u003ch1 id=\\\"title\\\"\u003eHello\u003c/h1\u003e\\n```\\n\\nJavaScript:\\n\\n```javascript\\nconst title = document.querySelector(\\\"#title\\\");\\n\\ntitle.style.color = \\\"red\\\";\\ntitle.style.fontSize = \\\"40px\\\";\\n```\\n\\nThe browser applies the styles.\\n\\n---\\n\\n# 12.17 JavaScript CSS Property Names\\n\\nCSS:\\n\\n```css\\nbackground-color: red;\\n```\\n\\nJavaScript:\\n\\n```javascript\\nelement.style.backgroundColor = \\\"red\\\";\\n```\\n\\nCSS:\\n\\n```css\\nfont-size: 20px;\\n```\\n\\nJavaScript:\\n\\n```javascript\\nelement.style.fontSize = \\\"20px\\\";\\n```\\n\\nThe hyphenated CSS property becomes camelCase in JavaScript.\\n\\n---\\n\\n# 12.18 Better Approach: CSS Classes\\n\\nInstead of:\\n\\n```javascript\\nelement.style.color = \\\"red\\\";\\nelement.style.backgroundColor = \\\"black\\\";\\nelement.style.fontSize = \\\"20px\\\";\\n```\\n\\noften define a CSS class:\\n\\n```css\\n.active {\\n    color: red;\\n    background-color: black;\\n}\\n```\\n\\nThen JavaScript:\\n\\n```javascript\\nelement.classList.add(\\\"active\\\");\\n```\\n\\nThis is generally easier to maintain.\\n\\n---\\n\\n# 12.19 `classList`\\n\\nImportant methods:\\n\\n```javascript\\nelement.classList.add(\\\"active\\\");\\n```\\n\\n```javascript\\nelement.classList.remove(\\\"active\\\");\\n```\\n\\n```javascript\\nelement.classList.toggle(\\\"active\\\");\\n```\\n\\n```javascript\\nelement.classList.contains(\\\"active\\\");\\n```\\n\\nExample:\\n\\n```javascript\\nconst button = document.querySelector(\\\"#btn\\\");\\n\\nbutton.classList.toggle(\\\"active\\\");\\n```\\n\\nEvery click could switch the class on/off—once we connect this with events.\\n\\n---\\n\\n# 12.20 Attributes\\n\\nHTML:\\n\\n```html\\n\u003cimg id=\\\"profile\\\" src=\\\"old.jpg\\\" alt=\\\"Profile\\\"\u003e\\n```\\n\\nGet an attribute:\\n\\n```javascript\\nconst image = document.querySelector(\\\"#profile\\\");\\n\\nconsole.log(image.getAttribute(\\\"src\\\"));\\n```\\n\\nSet:\\n\\n```javascript\\nimage.setAttribute(\\\"src\\\", \\\"new.jpg\\\");\\n```\\n\\nRemove:\\n\\n```javascript\\nimage.removeAttribute(\\\"alt\\\");\\n```\\n\\nCheck:\\n\\n```javascript\\nimage.hasAttribute(\\\"src\\\");\\n```\\n\\n---\\n\\n# 12.21 Direct Properties vs Attributes\\n\\nFor example:\\n\\n```javascript\\nimage.src\\n```\\n\\nand:\\n\\n```javascript\\nimage.getAttribute(\\\"src\\\")\\n```\\n\\nare related but not always identical in behavior or representation.\\n\\nFor standard DOM elements, many HTML attributes have corresponding DOM properties.\\n\\nMental model:\\n\\n```text\\nHTML attribute\\n       ↕\\nDOM property\\n```\\n\\nbut don't assume every property and attribute behave exactly the same.\\n\\n---\\n\\n# 12.22 Creating Elements\\n\\nThis is extremely important.\\n\\n```javascript\\nconst paragraph = document.createElement(\\\"p\\\");\\n```\\n\\nNow you have a new `\u003cp\u003e` element in memory.\\n\\nSet its text:\\n\\n```javascript\\nparagraph.textContent = \\\"Hello Dev\\\";\\n```\\n\\nBut it isn't visible on the page yet.\\n\\nYou need to insert it into the DOM.\\n\\n---\\n\\n# 12.23 `append()`\\n\\nSuppose:\\n\\n```html\\n\u003cdiv id=\\\"container\\\"\u003e\u003c/div\u003e\\n```\\n\\nJavaScript:\\n\\n```javascript\\nconst container =\\n    document.querySelector(\\\"#container\\\");\\n\\nconst paragraph =\\n    document.createElement(\\\"p\\\");\\n\\nparagraph.textContent = \\\"Hello\\\";\\n\\ncontainer.append(paragraph);\\n```\\n\\nNow the DOM effectively contains:\\n\\n```html\\n\u003cdiv id=\\\"container\\\"\u003e\\n    \u003cp\u003eHello\u003c/p\u003e\\n\u003c/div\u003e\\n```\\n\\n---\\n\\n# 12.24 `appendChild()`\\n\\nYou may also see:\\n\\n```javascript\\ncontainer.appendChild(paragraph);\\n```\\n\\nThis is an older/common DOM API.\\n\\n`append()` is more flexible because it can append nodes and strings.\\n\\nFor example:\\n\\n```javascript\\ncontainer.append(\\n    paragraph,\\n    \\\"Some text\\\"\\n);\\n```\\n\\n---\\n\\n# 12.25 `prepend()`\\n\\n```javascript\\ncontainer.prepend(paragraph);\\n```\\n\\nAdds the node at the beginning.\\n\\nConceptually:\\n\\n```text\\nBefore:\\nA\\nB\\n\\nprepend(C):\\n\\nC\\nA\\nB\\n```\\n\\n---\\n\\n# 12.26 Removing Elements\\n\\nModern:\\n\\n```javascript\\nparagraph.remove();\\n```\\n\\nYou can also use:\\n\\n```javascript\\ncontainer.removeChild(paragraph);\\n```\\n\\nThe direct `.remove()` method is often simpler.\\n\\n---\\n\\n# 12.27 Traversing the DOM\\n\\nSuppose:\\n\\n```html\\n\u003cdiv id=\\\"parent\\\"\u003e\\n    \u003cp id=\\\"child\\\"\u003eHello\u003c/p\u003e\\n\u003c/div\u003e\\n```\\n\\nYou can do:\\n\\n```javascript\\nconst child = document.querySelector(\\\"#child\\\");\\n\\nconsole.log(child.parentElement);\\n```\\n\\nThis gives the parent.\\n\\n---\\n\\n# 12.28 `children`\\n\\n```javascript\\nconst parent =\\n    document.querySelector(\\\"#parent\\\");\\n\\nconsole.log(parent.children);\\n```\\n\\nThis gives the element children.\\n\\nFor example:\\n\\n```html\\n\u003cdiv\u003e\\n    \u003cp\u003eA\u003c/p\u003e\\n    \u003cp\u003eB\u003c/p\u003e\\n\u003c/div\u003e\\n```\\n\\nThen:\\n\\n```javascript\\nparent.children\\n```\\n\\ncontains the two `\u003cp\u003e` elements.\\n\\n---\\n\\n# 12.29 `firstElementChild`\\n\\n```javascript\\nparent.firstElementChild;\\n```\\n\\ngets:\\n\\n```html\\n\u003cp\u003eA\u003c/p\u003e\\n```\\n\\nAnd:\\n\\n```javascript\\nparent.lastElementChild;\\n```\\n\\ngets:\\n\\n```html\\n\u003cp\u003eB\u003c/p\u003e\\n```\\n\\n---\\n\\n# 12.30 `nextElementSibling`\\n\\nSuppose:\\n\\n```html\\n\u003cp id=\\\"one\\\"\u003eOne\u003c/p\u003e\\n\u003cp id=\\\"two\\\"\u003eTwo\u003c/p\u003e\\n\u003cp id=\\\"three\\\"\u003eThree\u003c/p\u003e\\n```\\n\\nThen:\\n\\n```javascript\\nconst one =\\n    document.querySelector(\\\"#one\\\");\\n\\nconsole.log(one.nextElementSibling);\\n```\\n\\ngets the second `\u003cp\u003e`.\\n\\nSimilarly:\\n\\n```javascript\\none.previousElementSibling;\\n```\\n\\ngets the previous sibling, if one exists.\\n\\n---\\n\\n# 12.31 `children` vs `childNodes`\\n\\nThis is a classic DOM interview question.\\n\\n### `children`\\n\\nReturns element children.\\n\\n```html\\n\u003cdiv\u003e\\n    \u003cp\u003eHello\u003c/p\u003e\\n\u003c/div\u003e\\n```\\n\\nThe `\u003cp\u003e` is an element child.\\n\\n### `childNodes`\\n\\nIncludes different kinds of nodes, including text nodes and comments.\\n\\nFor example, whitespace in formatted HTML can appear as text nodes.\\n\\nSo:\\n\\n```text\\nchildren\\n→ elements\\n\\nchildNodes\\n→ nodes, including text/comment nodes\\n```\\n\\n---\\n\\n# 12.32 Element vs Node\\n\\nThis distinction matters.\\n\\nA DOM **Node** is a broader concept.\\n\\nExamples include:\\n\\n```text\\nDocument\\nElement\\nText\\nComment\\n```\\n\\nAn **Element** is a particular kind of Node representing an HTML/XML element.\\n\\nSo:\\n\\n```text\\nNode\\n│\\n├── Element\\n├── Text\\n├── Comment\\n└── ...\\n```\\n\\nThis explains why:\\n\\n```javascript\\nchildNodes\\n```\\n\\ncan contain text nodes while:\\n\\n```javascript\\nchildren\\n```\\n\\ncontains elements.\\n\\n---\\n\\n# 12.33 `parentElement` vs `parentNode`\\n\\nYou'll sometimes see:\\n\\n```javascript\\nelement.parentElement\\n```\\n\\nand:\\n\\n```javascript\\nelement.parentNode\\n```\\n\\n`parentElement` specifically expects an element parent.\\n\\n`parentNode` can return a broader Node type.\\n\\nFor ordinary HTML element traversal, `parentElement` is often convenient.\\n\\n---\\n\\n# 12.34 `closest()`\\n\\nSuppose:\\n\\n```html\\n\u003cdiv class=\\\"card\\\"\u003e\\n    \u003cbutton\u003eBuy\u003c/button\u003e\\n\u003c/div\u003e\\n```\\n\\nFrom the button:\\n\\n```javascript\\nconst button = document.querySelector(\\\"button\\\");\\n\\nconst card = button.closest(\\\".card\\\");\\n```\\n\\nThis searches the element itself and then ancestors until it finds a matching element.\\n\\nThis becomes extremely useful with **event delegation**, which we'll cover in Phase 13.\\n\\n---\\n\\n# 12.35 `matches()`\\n\\nYou can test whether an element matches a CSS selector:\\n\\n```javascript\\nelement.matches(\\\".active\\\");\\n```\\n\\nReturns:\\n\\n```text\\ntrue\\n```\\n\\nor:\\n\\n```text\\nfalse\\n```\\n\\nUseful when handling events or traversing elements.\\n\\n---\\n\\n# 12.36 DOM Example — Build a List\\n\\nHTML:\\n\\n```html\\n\u003cul id=\\\"list\\\"\u003e\u003c/ul\u003e\\n```\\n\\nJavaScript:\\n\\n```javascript\\nconst list = document.querySelector(\\\"#list\\\");\\n\\nconst names = [\\\"Dev\\\", \\\"Alex\\\", \\\"Sam\\\"];\\n\\nfor (const name of names) {\\n    const li = document.createElement(\\\"li\\\");\\n\\n    li.textContent = name;\\n\\n    list.append(li);\\n}\\n```\\n\\nThe browser gets:\\n\\n```html\\n\u003cul id=\\\"list\\\"\u003e\\n    \u003cli\u003eDev\u003c/li\u003e\\n    \u003cli\u003eAlex\u003c/li\u003e\\n    \u003cli\u003eSam\u003c/li\u003e\\n\u003c/ul\u003e\\n```\\n\\nThis is actual DOM manipulation.\\n\\n---\\n\\n# 12.37 DOM vs HTML\\n\\nThis distinction is important.\\n\\nHTML is the **markup/source representation**.\\n\\nDOM is the **in-memory object representation** created by the browser.\\n\\nThink:\\n\\n```text\\nHTML\\n ↓ parsing\\nDOM\\n ↓\\nJavaScript manipulates DOM\\n ↓\\nbrowser renders result\\n```\\n\\nChanging the DOM does not necessarily mean you're editing the original HTML source file on disk.\\n\\n---\\n\\n# 12.38 DOM Is Not JavaScript\\n\\nAnother important interview point:\\n\\n\u003e The DOM is a browser-provided Web API, not part of the core JavaScript language itself.\\n\\nFor example:\\n\\n```javascript\\nArray\\nPromise\\nMap\\n```\\n\\nare JavaScript language/built-in concepts.\\n\\nWhereas:\\n\\n```javascript\\ndocument\\nwindow\\nHTMLElement\\nquerySelector()\\n```\\n\\nare browser/platform APIs.\\n\\nThis distinction is **very important** when moving to Node.js.\\n\\nNode.js doesn't provide a browser DOM by default.\\n\\n---\\n\\n# 12.39 Browser APIs vs JavaScript\\n\\nThink:\\n\\n```text\\nJavaScript\\n│\\n├── Variables\\n├── Functions\\n├── Objects\\n├── Promise\\n├── Map\\n├── Set\\n└── ...\\n```\\n\\nBrowser environment:\\n\\n```text\\nBrowser APIs\\n│\\n├── DOM\\n├── window\\n├── fetch\\n├── localStorage\\n├── Web APIs\\n└── ...\\n```\\n\\nThe browser provides the environment in which JavaScript can interact with the webpage.\\n\\n---\\n\\n# 12.40 Very Important Interview Question\\n\\n### Is DOM part of JavaScript?\\n\\nBest answer:\\n\\n\u003e No. The DOM is a Web API/standardized object model provided by the browser environment. JavaScript can use the DOM API to manipulate documents.\\n\\nThat's much better than:\\n\\n\u003e \\\"DOM is JavaScript.\\\"\\n\\n---\\n\\n# 🔥 Phase 12 Interview Questions\\n\\nYou should be able to answer:\\n\\n### 1. What is DOM?\\n\\nDocument Object Model — an object representation of a document that programs can inspect and manipulate.\\n\\n### 2. What is `document`?\\n\\nThe DOM's document object representing the current webpage/document.\\n\\n### 3. `window` vs `document`?\\n\\n`window` represents the broader browser environment; `document` represents the current document.\\n\\n### 4. `querySelector()` vs `querySelectorAll()`?\\n\\n```text\\nquerySelector\\n→ first matching element\\n\\nquerySelectorAll\\n→ all matching elements\\n```\\n\\n### 5. `textContent` vs `innerHTML`?\\n\\n```text\\ntextContent\\n→ treats content as text\\n\\ninnerHTML\\n→ parses content as HTML\\n```\\n\\n### 6. `children` vs `childNodes`?\\n\\n```text\\nchildren\\n→ element children\\n\\nchildNodes\\n→ all child nodes, including text/comment nodes\\n```\\n\\n### 7. How do you create an element?\\n\\n```javascript\\ndocument.createElement(\\\"div\\\");\\n```\\n\\n### 8. How do you add it?\\n\\n```javascript\\nparent.append(element);\\n```\\n\\n### 9. How do you remove it?\\n\\n```javascript\\nelement.remove();\\n```\\n\\n### 10. What is `classList`?\\n\\nAPI for manipulating an element's CSS classes.\\n\\n### 11. What is `closest()`?\\n\\nFinds the nearest ancestor/self matching a CSS selector.\\n\\n### 12. Is DOM part of core JavaScript?\\n\\nNo — it is a browser/Web API.\\n\\n---\\n\\n# 🧪 Phase 12 Coding Checkpoint\\n\\nCreate this HTML:\\n\\n```html\\n\u003c!DOCTYPE html\u003e\\n\u003chtml\u003e\\n\u003cbody\u003e\\n\\n    \u003ch1 id=\\\"title\\\"\u003eHello\u003c/h1\u003e\\n\\n    \u003cdiv id=\\\"container\\\"\u003e\u003c/div\u003e\\n\\n    \u003cul id=\\\"list\\\"\u003e\u003c/ul\u003e\\n\\n    \u003cscript src=\\\"app.js\\\"\u003e\u003c/script\u003e\\n\u003c/body\u003e\\n\u003c/html\u003e\\n```\\n\\nNow write JavaScript that:\\n\\n### Task 1\\n\\nChanges:\\n\\n```text\\nHello\\n```\\n\\nto:\\n\\n```text\\nHello Dev\\n```\\n\\nusing `textContent`.\\n\\n---\\n\\n### Task 2\\n\\nChanges the title's color to blue.\\n\\n---\\n\\n### Task 3\\n\\nCreates:\\n\\n```html\\n\u003cp\u003eWelcome to JavaScript\u003c/p\u003e\\n```\\n\\nusing `createElement()` and `append()`.\\n\\n---\\n\\n### Task 4\\n\\nGiven:\\n\\n```javascript\\nconst names = [\\\"Java\\\", \\\"JavaScript\\\", \\\"React\\\", \\\"Node\\\"];\\n```\\n\\ndynamically create:\\n\\n```html\\n\u003cul\u003e\\n    \u003cli\u003eJava\u003c/li\u003e\\n    \u003cli\u003eJavaScript\u003c/li\u003e\\n    \u003cli\u003eReact\u003c/li\u003e\\n    \u003cli\u003eNode\u003c/li\u003e\\n\u003c/ul\u003e\\n```\\n\\n---\\n\\n### Task 5\\n\\nCreate a button dynamically:\\n\\n```html\\n\u003cbutton\u003eDelete\u003c/button\u003e\\n```\\n\\nand add it to the page.\\n\\n**Don't worry about making it actually delete anything yet.**\\n\\nWe'll learn that in the next phase.\\n\\n---\\n\\n# 🧠 Phase 12 Mental Model\\n\\nYou should now visualize:\\n\\n```text\\n                   Browser\\n                      │\\n          ┌───────────┴───────────┐\\n          │                       │\\n     JavaScript               Web APIs\\n          │                       │\\n          │                  ┌────┴─────┐\\n          │                  │          │\\n          │                 DOM       window\\n          │                  │\\n          │                  ▼\\n          │             HTML document\\n          │                  │\\n          └──── manipulate ─┘\\n```\\n\\nAnd the DOM:\\n\\n```text\\nDocument\\n   │\\n   └── html\\n        │\\n        ├── head\\n        │\\n        └── body\\n             │\\n             ├── div\\n             ├── h1\\n             └── button\\n```\\n\\nJavaScript can:\\n\\n```text\\nSELECT\\n   ↓\\nREAD\\n   ↓\\nMODIFY\\n   ↓\\nCREATE\\n   ↓\\nINSERT\\n   ↓\\nREMOVE\\n```\\n\\n---\\n\\n# 🗺️ Updated Roadmap\\n\\n```text\\n✅ Phase 0   Java → JS Mental Model\\n✅ Phase 1   Variables \u0026 Data Types\\n✅ Phase 1B  Operators \u0026 Coercion\\n✅ Phase 2   Conditions \u0026 Loops\\n✅ Phase 3   Arrays\\n✅ Phase 4   Objects\\n✅ Phase 5   Functions\\n✅ Phase 6   this + OOP + Prototypes\\n✅ Phase 7   Execution Model\\n✅ Phase 8   Advanced Functions\\n✅ Phase 9   Async JavaScript\\n✅ Phase 10  Collections \u0026 Built-ins\\n✅ Phase 11  Modules \u0026 Modern JS\\n🔥 Phase 12  Browser \u0026 DOM\\n              ├── window\\n              ├── document\\n              ├── DOM tree\\n              ├── selectors\\n              ├── textContent\\n              ├── innerHTML\\n              ├── styles\\n              ├── classList\\n              ├── attributes\\n              ├── createElement\\n              ├── append/prepend\\n              ├── remove\\n              ├── DOM traversal\\n              ├── nodes vs elements\\n              └── closest/matches\\n\\n➡️ Phase 13  Events \u0026 Event Handling\\n              ├── click\\n              ├── input\\n              ├── submit\\n              ├── keyboard events\\n              ├── mouse events\\n              ├── addEventListener\\n              ├── event object\\n              ├── bubbling\\n              ├── capturing\\n              ├── preventDefault\\n              ├── stopPropagation\\n              └── event delegation\\n\\n➡️ Phase 14  HTTP, REST \u0026 APIs\\n➡️ Phase 15  Advanced JS Patterns\\n➡️ Phase 16  Node.js\\n➡️ Phase 17  Express.js\\n➡️ Phase 18  JavaScript Security\\n➡️ Phase 19  Performance \u0026 Memory\\n➡️ Phase 20  React JavaScript Foundations\\n➡️ Phase 21  JavaScript Interview Mastery\\n➡️ Phase 22  DSA in JavaScript\\n```\\n\\n**Phase 13 is especially important for frontend interviews:** we'll learn why `addEventListener()` is preferred, what the **event object** contains, how **bubbling/capturing** actually work, why `event.target` and `event.currentTarget` differ, and how **event delegation** works.\",{},{\"_197\":789,\"_204\":1076,\"_54\":1077,\"_208\":1078,\"_210\":211,\"_213\":214,\"_215\":1079,\"_217\":218},\"bad9e1e5-c752-40dd-8da9-885cee5115c5\",[776],{\"_656\":657,\"_215\":1080},1789933721.3405101,{\"_651\":667,\"_668\":669},{\"_233\":234,\"_240\":802,\"_242\":802,\"_245\":1074,\"_248\":10,\"_666\":34},{},{\"_197\":1074,\"_204\":1084,\"_54\":1085,\"_208\":1086,\"_210\":211,\"_213\":214,\"_215\":1087,\"_217\":218},\"8824a187-ee74-43a1-b358-0b5d9ca9cc54\",[789],{\"_656\":681,\"_215\":1090},1789933721.0444772,{\"_651\":652,\"_653\":1089},{\"_678\":34,\"_246\":1088,\"_228\":67,\"_233\":234,\"_236\":801,\"_238\":239,\"_240\":802,\"_242\":802,\"_243\":67,\"_66\":67,\"_245\":1082,\"_248\":10,\"_244\":14},\"36821d77-b5bb-4803-983b-22254d01d249\",[669],{},{\"_197\":1082,\"_204\":1094,\"_54\":1095,\"_208\":1096,\"_210\":211,\"_213\":214,\"_215\":1097,\"_217\":218},\"cd7c143c-cafd-4842-9008-30593304c88d\",[1074],{\"_656\":681,\"_215\":1099},1789933721.04413,{\"_651\":652,\"_653\":1098},{\"_678\":34,\"_246\":1088,\"_228\":67,\"_233\":234,\"_236\":801,\"_238\":239,\"_240\":802,\"_242\":802,\"_243\":67,\"_66\":67,\"_245\":1092,\"_248\":10,\"_244\":14},[669],{},{\"_197\":1092,\"_204\":1103,\"_54\":1104,\"_208\":1105,\"_210\":211,\"_212\":34,\"_213\":689,\"_215\":1106,\"_217\":218},\"f99c7bcc-d5e3-4451-b25a-0a8230ec8959\",[1082],{\"_656\":681,\"_215\":1109},1789933722.217528,{\"_651\":652,\"_653\":1108},{\"_1107\":34,\"_678\":34,\"_246\":1088,\"_228\":67,\"_233\":234,\"_236\":801,\"_238\":239,\"_240\":802,\"_242\":802,\"_243\":67,\"_66\":67,\"_245\":1101,\"_248\":10,\"_244\":14},\"rebase_developer_message\",[669],{},{\"_197\":1101,\"_204\":1113,\"_54\":1114,\"_208\":1115,\"_210\":211,\"_212\":34,\"_213\":689,\"_215\":1116,\"_217\":218},\"de70fae1-f542-4066-aa1c-571afe9b8950\",[1092],{\"_656\":681,\"_215\":1118},1789933722.19851,{\"_651\":652,\"_653\":1117},{\"_691\":34,\"_678\":34,\"_246\":1088,\"_228\":67,\"_233\":234,\"_236\":801,\"_238\":239,\"_240\":802,\"_242\":802,\"_243\":67,\"_66\":67,\"_245\":1111,\"_248\":10,\"_244\":14},[669],{},{\"_197\":1111,\"_204\":1122,\"_54\":1123,\"_56\":1124,\"_208\":1125,\"_210\":211,\"_213\":214,\"_215\":1126,\"_217\":218},\"d1e265df-093d-4819-a6c2-39925391b724\",[1101],{\"_656\":709,\"_215\":1130},1789933718.691,1789933