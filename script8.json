97\":3402,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3401,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3400,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3399,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3398,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3397,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3396,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3395,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3394,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3393,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3392,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3391,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3390,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3389,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3388,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3387,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3386,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3385,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3384,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3383,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3382,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3381,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3380,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3379,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3378,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3377,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3376,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3375,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3374,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3373,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3372,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3371,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3370,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3369,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3368,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3367,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3366,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3365,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3364,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3363,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3362,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3361,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3360,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3359,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3358,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3357,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3356,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3355,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3354,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3353,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3352,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3351,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3350,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3349,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3348,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3347,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3346,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3345,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3344,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3343,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3342,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3341,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3340,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3339,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3338,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3337,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3336,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3335,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3334,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3333,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3332,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3331,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3330,\"_525\":14,\"_526\":14,\"_527\":-5},\"dtc4a5\",\"r3lkqv\",\"z6anl4\",\"hqfeix\",\"onbs02\",\"nkd0ud\",\"m0zetz\",\"risgrs\",\"bcm0u5\",\"qqgsni\",\"ad6lub\",\"o0hgej\",\"4kz05k\",\"3c8jv9\",\"prh3pu\",\"w8cqu5\",\"eujrau\",\"9geyue\",\"5hhu7o\",\"s98sdp\",\"6jn0v0\",\"37dfjf\",\"ttghex\",\"mn6412\",\"2v1t8g\",\"uiq7w8\",\"qmwcgz\",\"s4m9o4\",\"qjxxwe\",\"j0vsl0\",\"9e0hza\",\"0dn36x\",\"chhiwl\",\"1yi8nz\",\"bmwjz5\",\"whi0fe\",\"mqkllj\",\"bq6q6e\",\"2k8237\",\"qucd43\",\"4lj7f1\",\"afgqry\",\"z3a9gq\",\"plrioz\",\"npnhci\",\"5ddhwk\",\"pxzowv\",\"r50uk5\",\"xqo1hd\",\"kji2rp\",\"3uneu4\",\"4c6vgp\",\"w11oac\",\"a5ku8s\",\"11kmaw\",\"53miiz\",\"vz2n8q\",\"b5qq8h\",\"0bbfv4\",\"1kxg4a\",\"gd1x6l\",\"3t2xtu\",\"qy8pzg\",\"azgl52\",\"q6b037\",\"zj4ftu\",\"6k5rjy\",\"2whio9\",\"idsbsr\",\"x4pert\",\"vmjthg\",\"crgoy8\",\"t2yasa\",\"gojen7\",\"ppt8vr\",\"p60d1m\",\"mttlme\",\"n94nsn\",\"xrd2sk\",\"4pddjr\",\"lqe2hx\",\"jcq589\",\"md2urr\",\"zlzmj2\",\"g8ssg3\",\"lvnw5z\",\"08jf9a\",\"24r964\",\"9mvxvq\",\"tnpkv0\",\"m0bf08\",\"fpti7l\",\"6gdppz\",\"tfkmrj\",\"bl7crj\",\"vpfs5d\",\"fh4jil\",\"0zruhp\",\"13kcat\",\"pfanph\",\"obullz\",\"bsg6sw\",\"gjpw88\",\"9saq81\",\"ft0vdr\",\"6n669v\",\"hno84y\",\"u4i8bj\",\"vue31l\",\"6i47pq\",\"bvy7u3\",\"d0awl9\",\"infn70\",\"oisjum\",\"rm3ksn\",\"irr9to\",\"6r1fnk\",\"nviti5\",\"nwyjdl\",\"7bvvcl\",\"0zv356\",\"bmx139\",\"k7a0m5\",\"rw6b91\",\"ch1ba5\",\"2e67u9\",\"nql4kb\",\"s5xr2p\",\"gqapu2\",\"4hhsy6\",\"9vyoz3\",\"ulvp82\",\"zyyuk9\",\"urxyza\",\"68vr1y\",\"gubdmy\",\"u4rl29\",\"fr4fd3\",\"5tx2i7\",\"e5ulcj\",\"f1e2ym\",[650],[3473],\"# Phase 4 — Objects\\n\\nThis is a **major phase**.\\n\\nSince you know Java, don't make the mistake of thinking:\\n\\n\u003e Java `Object` = JavaScript `object`\\n\\nThey share the name, but JavaScript objects work very differently.\\n\\nWe'll build this from the ground up.\\n\\n---\\n\\n# 4.1 What is an object?\\n\\nIn Java, you might create:\\n\\n```java\\nclass Student {\\n    String name;\\n    int age;\\n}\\n```\\n\\nand then:\\n\\n```java\\nStudent s = new Student();\\ns.name = \\\"Dev\\\";\\ns.age = 21;\\n```\\n\\nJavaScript lets you create an object **without defining a class first**:\\n\\n```js\\nconst student = {\\n    name: \\\"Dev\\\",\\n    age: 21\\n};\\n```\\n\\nThat's a huge difference.\\n\\nAn object is essentially a collection of **key-value pairs**.\\n\\n```text\\nstudent\\n│\\n├── name → \\\"Dev\\\"\\n└── age  → 21\\n```\\n\\n---\\n\\n# 4.2 Accessing properties\\n\\nYou have two ways.\\n\\n## Dot notation\\n\\n```js\\nconsole.log(student.name);\\nconsole.log(student.age);\\n```\\n\\nOutput:\\n\\n```text\\nDev\\n21\\n```\\n\\nThis is the most common form.\\n\\n---\\n\\n## Bracket notation\\n\\n```js\\nconsole.log(student[\\\"name\\\"]);\\nconsole.log(student[\\\"age\\\"]);\\n```\\n\\nSame result.\\n\\n---\\n\\n# 4.3 Why do we need bracket notation?\\n\\nThis becomes important when the property name is stored in a variable.\\n\\n```js\\nconst student = {\\n    name: \\\"Dev\\\",\\n    age: 21\\n};\\n\\nconst key = \\\"name\\\";\\n\\nconsole.log(student[key]);\\n```\\n\\nOutput:\\n\\n```text\\nDev\\n```\\n\\nBut:\\n\\n```js\\nconsole.log(student.key);\\n```\\n\\nwould look for a property literally called:\\n\\n```text\\n\\\"key\\\"\\n```\\n\\nnot the value of the variable.\\n\\n### Remember\\n\\n```js\\nstudent.name\\n```\\n\\nmeans:\\n\\n\u003e Property literally called `name`.\\n\\n```js\\nstudent[key]\\n```\\n\\nmeans:\\n\\n\u003e Property whose name is stored inside `key`.\\n\\n---\\n\\n# 4.4 Adding properties\\n\\nUnlike a normal Java object, JavaScript objects can dynamically acquire properties.\\n\\n```js\\nconst student = {\\n    name: \\\"Dev\\\"\\n};\\n\\nstudent.age = 21;\\nstudent.city = \\\"Chennai\\\";\\n```\\n\\nNow:\\n\\n```js\\nconsole.log(student);\\n```\\n\\ncontains:\\n\\n```text\\n{\\n    name: \\\"Dev\\\",\\n    age: 21,\\n    city: \\\"Chennai\\\"\\n}\\n```\\n\\nYou don't need to declare `age` beforehand.\\n\\n---\\n\\n# 4.5 Modifying properties\\n\\n```js\\nconst student = {\\n    name: \\\"Dev\\\",\\n    age: 21\\n};\\n\\nstudent.age = 22;\\n```\\n\\nNow:\\n\\n```js\\nconsole.log(student.age);\\n```\\n\\n→\\n\\n```text\\n22\\n```\\n\\n---\\n\\n# 4.6 Deleting properties\\n\\nJavaScript has the `delete` operator:\\n\\n```js\\nconst student = {\\n    name: \\\"Dev\\\",\\n    age: 21\\n};\\n\\ndelete student.age;\\n\\nconsole.log(student);\\n```\\n\\nResult:\\n\\n```text\\n{\\n    name: \\\"Dev\\\"\\n}\\n```\\n\\nSo:\\n\\n```js\\ndelete object.property;\\n```\\n\\nremoves the property.\\n\\n---\\n\\n# 4.7 Object methods\\n\\nObjects can contain functions.\\n\\n```js\\nconst student = {\\n    name: \\\"Dev\\\",\\n\\n    greet: function() {\\n        console.log(\\\"Hello\\\");\\n    }\\n};\\n```\\n\\nCall it:\\n\\n```js\\nstudent.greet();\\n```\\n\\nYou can use shorthand syntax:\\n\\n```js\\nconst student = {\\n    name: \\\"Dev\\\",\\n\\n    greet() {\\n        console.log(\\\"Hello\\\");\\n    }\\n};\\n```\\n\\nThis is very common.\\n\\n---\\n\\n# 4.8 Object property + method\\n\\nExample:\\n\\n```js\\nconst student = {\\n    name: \\\"Dev\\\",\\n    age: 21,\\n\\n    introduce() {\\n        console.log(`I am ${this.name} and I am ${this.age}`);\\n    }\\n};\\n\\nstudent.introduce();\\n```\\n\\nOutput:\\n\\n```text\\nI am Dev and I am 21\\n```\\n\\nNotice:\\n\\n```js\\nthis.name\\n```\\n\\nWe'll have an entire phase dedicated to `this`.\\n\\nFor now:\\n\\n\u003e When called as `student.introduce()`, `this` refers to `student`.\\n\\n---\\n\\n# 4.9 Objects can contain anything\\n\\nFor example:\\n\\n```js\\nconst student = {\\n    name: \\\"Dev\\\",\\n    age: 21,\\n    isStudent: true,\\n    skills: [\\\"Java\\\", \\\"JavaScript\\\", \\\"ML\\\"],\\n    address: {\\n        city: \\\"Chennai\\\",\\n        country: \\\"India\\\"\\n    }\\n};\\n```\\n\\nSo objects can contain:\\n\\n```text\\nstrings\\nnumbers\\nbooleans\\narrays\\nobjects\\nfunctions\\nnull\\netc.\\n```\\n\\n---\\n\\n# 4.10 Nested objects\\n\\nAccess:\\n\\n```js\\nconsole.log(student.address.city);\\n```\\n\\nOutput:\\n\\n```text\\nChennai\\n```\\n\\nOr:\\n\\n```js\\nconsole.log(student.address.country);\\n```\\n\\n→\\n\\n```text\\nIndia\\n```\\n\\nThis is extremely common when dealing with API responses.\\n\\n---\\n\\n# 4.11 Optional chaining\\n\\nSuppose:\\n\\n```js\\nconst student = {\\n    name: \\\"Dev\\\"\\n};\\n```\\n\\nThis would fail:\\n\\n```js\\nstudent.address.city\\n```\\n\\nbecause:\\n\\n```text\\nstudent.address\\n```\\n\\nis `undefined`.\\n\\nInstead:\\n\\n```js\\nstudent.address?.city\\n```\\n\\nreturns:\\n\\n```text\\nundefined\\n```\\n\\nrather than throwing an error.\\n\\nFor deeply nested data:\\n\\n```js\\nstudent?.address?.city\\n```\\n\\nThis is extremely common in React.\\n\\n---\\n\\n# 4.12 Checking whether a property exists\\n\\nYou can use:\\n\\n```js\\nconst student = {\\n    name: \\\"Dev\\\",\\n    age: 21\\n};\\n\\nconsole.log(\\\"name\\\" in student);\\n```\\n\\n→\\n\\n```text\\ntrue\\n```\\n\\nAnd:\\n\\n```js\\nconsole.log(\\\"city\\\" in student);\\n```\\n\\n→\\n\\n```text\\nfalse\\n```\\n\\nYou can also use:\\n\\n```js\\nstudent.hasOwnProperty(\\\"name\\\");\\n```\\n\\nBut there are subtleties around inherited properties, which we'll cover with prototypes.\\n\\n---\\n\\n# 4.13 `Object.keys()`\\n\\nSuppose:\\n\\n```js\\nconst student = {\\n    name: \\\"Dev\\\",\\n    age: 21,\\n    city: \\\"Chennai\\\"\\n};\\n```\\n\\nThen:\\n\\n```js\\nconsole.log(Object.keys(student));\\n```\\n\\nOutput:\\n\\n```text\\n[\\\"name\\\", \\\"age\\\", \\\"city\\\"]\\n```\\n\\nThink:\\n\\n```text\\nObject.keys()\\n       ↓\\ngive me all keys\\n```\\n\\n---\\n\\n# 4.14 `Object.values()`\\n\\n```js\\nconsole.log(Object.values(student));\\n```\\n\\nOutput:\\n\\n```text\\n[\\\"Dev\\\", 21, \\\"Chennai\\\"]\\n```\\n\\nThink:\\n\\n```text\\nObject.values()\\n       ↓\\ngive me all values\\n```\\n\\n---\\n\\n# 4.15 `Object.entries()` ⭐\\n\\nThis gives key-value pairs.\\n\\n```js\\nconsole.log(Object.entries(student));\\n```\\n\\nOutput conceptually:\\n\\n```text\\n[\\n    [\\\"name\\\", \\\"Dev\\\"],\\n    [\\\"age\\\", 21],\\n    [\\\"city\\\", \\\"Chennai\\\"]\\n]\\n```\\n\\nThis is extremely useful when iterating over objects.\\n\\n---\\n\\n# 4.16 Iterating through an object\\n\\nYou learned `for...in` earlier.\\n\\n```js\\nfor (const key in student) {\\n    console.log(key, student[key]);\\n}\\n```\\n\\nOutput:\\n\\n```text\\nname Dev\\nage 21\\ncity Chennai\\n```\\n\\nAlternatively:\\n\\n```js\\nfor (const [key, value] of Object.entries(student)) {\\n    console.log(key, value);\\n}\\n```\\n\\nWe'll properly learn the:\\n\\n```js\\n[key, value]\\n```\\n\\ndestructuring syntax shortly.\\n\\n---\\n\\n# 4.17 Object destructuring ⭐⭐⭐\\n\\nThis is one of the most important JavaScript features for React.\\n\\nSuppose:\\n\\n```js\\nconst student = {\\n    name: \\\"Dev\\\",\\n    age: 21,\\n    city: \\\"Chennai\\\"\\n};\\n```\\n\\nInstead of:\\n\\n```js\\nconst name = student.name;\\nconst age = student.age;\\nconst city = student.city;\\n```\\n\\nyou can write:\\n\\n```js\\nconst { name, age, city } = student;\\n```\\n\\nNow:\\n\\n```js\\nconsole.log(name);\\nconsole.log(age);\\nconsole.log(city);\\n```\\n\\nOutput:\\n\\n```text\\nDev\\n21\\nChennai\\n```\\n\\nThink:\\n\\n```text\\nconst { name } = student;\\n        ↓\\ntake student.name\\n        ↓\\nput it into variable name\\n```\\n\\n---\\n\\n# 4.18 Rename during destructuring\\n\\nSuppose you don't want the variable to be called `name`.\\n\\n```js\\nconst { name: studentName } = student;\\n\\nconsole.log(studentName);\\n```\\n\\nOutput:\\n\\n```text\\nDev\\n```\\n\\nImportant:\\n\\n```js\\n{name: studentName}\\n```\\n\\nmeans:\\n\\n```text\\nproperty → name\\nvariable → studentName\\n```\\n\\n---\\n\\n# 4.19 Default values\\n\\n```js\\nconst student = {\\n    name: \\\"Dev\\\"\\n};\\n\\nconst { name, age = 18 } = student;\\n\\nconsole.log(age);\\n```\\n\\nOutput:\\n\\n```text\\n18\\n```\\n\\nThe default is used when the property is `undefined`.\\n\\n---\\n\\n# 4.20 Nested destructuring\\n\\nGiven:\\n\\n```js\\nconst student = {\\n    name: \\\"Dev\\\",\\n    address: {\\n        city: \\\"Chennai\\\",\\n        country: \\\"India\\\"\\n    }\\n};\\n```\\n\\nYou can do:\\n\\n```js\\nconst {\\n    address: { city }\\n} = student;\\n\\nconsole.log(city);\\n```\\n\\n→\\n\\n```text\\nChennai\\n```\\n\\nThis syntax looks strange initially, but you'll encounter it frequently in real JavaScript.\\n\\n---\\n\\n# 4.21 Spread with objects ⭐⭐⭐\\n\\nYou learned:\\n\\n```js\\nconst copy = [...arr];\\n```\\n\\nfor arrays.\\n\\nObjects also support spread:\\n\\n```js\\nconst student = {\\n    name: \\\"Dev\\\",\\n    age: 21\\n};\\n\\nconst copy = {\\n    ...student\\n};\\n```\\n\\nNow `copy` contains the same properties.\\n\\n---\\n\\n# 4.22 Adding properties using spread\\n\\n```js\\nconst student = {\\n    name: \\\"Dev\\\",\\n    age: 21\\n};\\n\\nconst updatedStudent = {\\n    ...student,\\n    city: \\\"Chennai\\\"\\n};\\n```\\n\\nResult:\\n\\n```text\\n{\\n    name: \\\"Dev\\\",\\n    age: 21,\\n    city: \\\"Chennai\\\"\\n}\\n```\\n\\nThis pattern is **extremely important in React**.\\n\\n---\\n\\n# 4.23 Updating an object immutably\\n\\nSuppose:\\n\\n```js\\nconst student = {\\n    name: \\\"Dev\\\",\\n    age: 21\\n};\\n```\\n\\nYou could modify it directly:\\n\\n```js\\nstudent.age = 22;\\n```\\n\\nBut JavaScript applications, especially React, frequently create a new object:\\n\\n```js\\nconst updatedStudent = {\\n    ...student,\\n    age: 22\\n};\\n```\\n\\nNow:\\n\\n```text\\nstudent\\n→ { name: \\\"Dev\\\", age: 21 }\\n\\nupdatedStudent\\n→ { name: \\\"Dev\\\", age: 22 }\\n```\\n\\nWe'll later learn why React likes this pattern.\\n\\n---\\n\\n# 4.24 Property overwrite with spread\\n\\nThis is an important rule.\\n\\n```js\\nconst student = {\\n    name: \\\"Dev\\\",\\n    age: 21\\n};\\n\\nconst updated = {\\n    ...student,\\n    age: 22\\n};\\n```\\n\\nResult:\\n\\n```text\\n{\\n    name: \\\"Dev\\\",\\n    age: 22\\n}\\n```\\n\\nWhy?\\n\\nProperties appearing **later** overwrite earlier properties.\\n\\nSo:\\n\\n```js\\n{\\n    ...student,\\n    age: 22\\n}\\n```\\n\\nmeans:\\n\\n```text\\ncopy student\\nthen set age = 22\\n```\\n\\n---\\n\\n# 4.25 Reverse the order\\n\\n```js\\nconst updated = {\\n    age: 22,\\n    ...student\\n};\\n```\\n\\nNow `student.age` is copied **after** `age: 22`.\\n\\nTherefore:\\n\\n```text\\nage → 21\\n```\\n\\nThis is an important interview/detail question.\\n\\n### Rule\\n\\n\u003e **Later properties win.**\\n\\n---\\n\\n# 4.26 Shallow copying objects\\n\\nRemember arrays?\\n\\n```js\\nconst copy = [...original];\\n```\\n\\nShallow copy.\\n\\nSame for objects:\\n\\n```js\\nconst copy = {\\n    ...original\\n};\\n```\\n\\nExample:\\n\\n```js\\nconst original = {\\n    name: \\\"Dev\\\",\\n    address: {\\n        city: \\\"Chennai\\\"\\n    }\\n};\\n\\nconst copy = {\\n    ...original\\n};\\n\\ncopy.address.city = \\\"Bangalore\\\";\\n\\nconsole.log(original.address.city);\\n```\\n\\nOutput:\\n\\n```text\\nBangalore\\n```\\n\\nWhy?\\n\\nBecause the nested object wasn't copied.\\n\\nConceptually:\\n\\n```text\\noriginal ─────┐\\n              ↓\\n           address\\n              ↓\\n           { city }\\n              ↑\\ncopy ─────────┘\\n```\\n\\nOnly the outer object was copied.\\n\\n---\\n\\n# 4.27 Deep copying\\n\\nOne modern option is:\\n\\n```js\\nconst copy = structuredClone(original);\\n```\\n\\nThis can create a deep clone for supported data types.\\n\\nExample:\\n\\n```js\\nconst original = {\\n    name: \\\"Dev\\\",\\n    address: {\\n        city: \\\"Chennai\\\"\\n    }\\n};\\n\\nconst copy = structuredClone(original);\\n\\ncopy.address.city = \\\"Bangalore\\\";\\n\\nconsole.log(original.address.city);\\n```\\n\\nOutput:\\n\\n```text\\nChennai\\n```\\n\\nNow the nested object is separate.\\n\\nThere are other approaches, such as JSON serialization, but **don't blindly use**:\\n\\n```js\\nJSON.parse(JSON.stringify(obj))\\n```\\n\\nbecause it has limitations and can lose certain values/types.\\n\\n---\\n\\n# 4.28 Objects and references 🔥\\n\\nThis is critical.\\n\\nConsider:\\n\\n```js\\nconst a = {\\n    name: \\\"Dev\\\"\\n};\\n\\nconst b = a;\\n\\nb.name = \\\"Alex\\\";\\n\\nconsole.log(a.name);\\n```\\n\\nOutput:\\n\\n```text\\nAlex\\n```\\n\\nWhy?\\n\\nBecause:\\n\\n```text\\na ───────┐\\n         ↓\\n       object\\n         ↑\\nb ───────┘\\n```\\n\\n`a` and `b` refer to the **same object**.\\n\\nThis is similar to Java reference semantics.\\n\\n---\\n\\n# 4.29 But primitive assignment is different\\n\\n```js\\nlet a = 10;\\nlet b = a;\\n\\nb = 20;\\n\\nconsole.log(a);\\n```\\n\\nOutput:\\n\\n```text\\n10\\n```\\n\\nBecause the primitive value is copied.\\n\\nConceptually:\\n\\n```text\\na → 10\\n\\nb → 10\\n```\\n\\nThen:\\n\\n```text\\nb → 20\\n```\\n\\n`a` remains 10.\\n\\nWe'll formalize this when we discuss **pass-by-value and references**.\\n\\n---\\n\\n# 4.30 Comparing objects\\n\\nThis is another huge JavaScript trap.\\n\\n```js\\nconst a = {\\n    name: \\\"Dev\\\"\\n};\\n\\nconst b = {\\n    name: \\\"Dev\\\"\\n};\\n\\nconsole.log(a === b);\\n```\\n\\nOutput:\\n\\n```text\\nfalse\\n```\\n\\nWhy?\\n\\nBecause they are two different object references.\\n\\nEven though their contents look identical.\\n\\nBut:\\n\\n```js\\nconst a = {\\n    name: \\\"Dev\\\"\\n};\\n\\nconst b = a;\\n\\nconsole.log(a === b);\\n```\\n\\n→\\n\\n```text\\ntrue\\n```\\n\\nBecause both variables refer to the same object.\\n\\n---\\n\\n# 4.31 Java comparison vs JavaScript\\n\\nIn Java, you already know:\\n\\n```java\\na == b\\n```\\n\\nfor objects compares references.\\n\\nJavaScript:\\n\\n```js\\na === b\\n```\\n\\nalso compares object identity/references.\\n\\nSo your Java knowledge transfers nicely here.\\n\\nBut remember:\\n\\n```js\\n{ name: \\\"Dev\\\" } === { name: \\\"Dev\\\" }\\n```\\n\\nis false because these are two separately created objects.\\n\\n---\\n\\n# 4.32 `Object.assign()`\\n\\nAnother way to copy/merge objects:\\n\\n```js\\nconst a = {\\n    name: \\\"Dev\\\"\\n};\\n\\nconst b = {\\n    age: 21\\n};\\n\\nconst result = Object.assign({}, a, b);\\n```\\n\\nResult:\\n\\n```text\\n{\\n    name: \\\"Dev\\\",\\n    age: 21\\n}\\n```\\n\\nModern JavaScript usually prefers:\\n\\n```js\\nconst result = {\\n    ...a,\\n    ...b\\n};\\n```\\n\\nbecause it's cleaner.\\n\\n---\\n\\n# 4.33 Object merging\\n\\n```js\\nconst user = {\\n    name: \\\"Dev\\\",\\n    age: 21\\n};\\n\\nconst details = {\\n    city: \\\"Chennai\\\",\\n    age: 22\\n};\\n\\nconst result = {\\n    ...user,\\n    ...details\\n};\\n```\\n\\nResult:\\n\\n```text\\n{\\n    name: \\\"Dev\\\",\\n    age: 22,\\n    city: \\\"Chennai\\\"\\n}\\n```\\n\\nAgain:\\n\\n\u003e **Later properties overwrite earlier ones.**\\n\\n---\\n\\n# 4.34 Objects vs `Map`\\n\\nYou may initially think:\\n\\n\u003e \\\"Java has `HashMap`, so JavaScript object must be HashMap.\\\"\\n\\nNot exactly.\\n\\nJavaScript has a dedicated:\\n\\n```js\\nMap\\n```\\n\\nExample:\\n\\n```js\\nconst map = new Map();\\n\\nmap.set(\\\"name\\\", \\\"Dev\\\");\\nmap.set(\\\"age\\\", 21);\\n\\nconsole.log(map.get(\\\"name\\\"));\\n```\\n\\n→\\n\\n```text\\nDev\\n```\\n\\nWe'll study `Map` and `Set` separately.\\n\\nFor now:\\n\\n```text\\nObject → general structured data\\nMap    → key-value collection with Map semantics\\n```\\n\\nWhen receiving API JSON:\\n\\n```js\\n{\\n    name: \\\"Dev\\\",\\n    age: 21\\n}\\n```\\n\\nyou'll generally be dealing with an object.\\n\\n---\\n\\n# 4.35 JSON\\n\\nThis is extremely important for backend/API work.\\n\\nJSON looks almost exactly like JavaScript objects:\\n\\n```json\\n{\\n    \\\"name\\\": \\\"Dev\\\",\\n    \\\"age\\\": 21,\\n    \\\"skills\\\": [\\\"Java\\\", \\\"JavaScript\\\"]\\n}\\n```\\n\\nBut JSON is **data format**, not a JavaScript object.\\n\\nConvert object → JSON:\\n\\n```js\\nconst student = {\\n    name: \\\"Dev\\\",\\n    age: 21\\n};\\n\\nconst json = JSON.stringify(student);\\n\\nconsole.log(json);\\n```\\n\\nOutput:\\n\\n```text\\n{\\\"name\\\":\\\"Dev\\\",\\\"age\\\":21}\\n```\\n\\nJSON → JavaScript object:\\n\\n```js\\nconst obj = JSON.parse(json);\\n\\nconsole.log(obj.name);\\n```\\n\\n→\\n\\n```text\\nDev\\n```\\n\\nYou'll use this heavily when working with APIs.\\n\\n---\\n\\n# 🧠 Object mental model\\n\\nAt this point, think:\\n\\n```text\\nJava                         JavaScript\\n\\nclass Student                object literal\\nStudent s                    const s = {}\\ns.name                       s.name\\ns.getName()                  s.getName()\\nHashMap                      Map\\nJSON libraries               JSON.parse/stringify\\nreference ==                 === for object identity\\ngetter/setter                getters/setters\\n```\\n\\nBut remember:\\n\\n\u003e **JavaScript objects don't require classes.**\\n\\nThat is fundamental.\\n\\n---\\n\\n# 🔥 Interview questions from this phase\\n\\n### Q1\\n\\nWhat's the difference?\\n\\n```js\\nobj.name\\n```\\n\\nand\\n\\n```js\\nobj[name]\\n```\\n\\nAnswer:\\n\\n\u003e Dot notation accesses the literal property named `name`, while bracket notation evaluates the expression inside the brackets and uses its result as the property key.\\n\\n---\\n\\n### Q2\\n\\nWhy?\\n\\n```js\\n{} === {}\\n```\\n\\nis false.\\n\\nBecause two object literals create two different object references.\\n\\n---\\n\\n### Q3\\n\\nWhy does this print `\\\"Alex\\\"`?\\n\\n```js\\nconst a = { name: \\\"Dev\\\" };\\nconst b = a;\\n\\nb.name = \\\"Alex\\\";\\n\\nconsole.log(a.name);\\n```\\n\\nBecause `a` and `b` reference the same object.\\n\\n---\\n\\n### Q4\\n\\nWhat is object destructuring?\\n\\n```js\\nconst { name, age } = student;\\n```\\n\\nIt extracts properties from an object into variables.\\n\\n---\\n\\n### Q5\\n\\nWhat does this do?\\n\\n```js\\nconst updated = {\\n    ...student,\\n    age: 22\\n};\\n```\\n\\nCreates a new shallow-copied object from `student` and overrides `age` with `22`.\\n\\n---\\n\\n### Q6\\n\\nWhat happens?\\n\\n```js\\nconst a = {\\n    x: 10\\n};\\n\\nconst b = {\\n    x: 20,\\n    ...a\\n};\\n\\nconsole.log(b.x);\\n```\\n\\nAnswer:\\n\\n```text\\n10\\n```\\n\\nBecause the later spread overwrites the earlier `x: 20`.\\n\\n---\\n\\n# 🎯 Coding checkpoint\\n\\nWrite these yourself before moving on.\\n\\n### Problem 1\\n\\nCreate:\\n\\n```js\\nconst employee = {\\n    name: \\\"John\\\",\\n    age: 25,\\n    salary: 50000\\n};\\n```\\n\\nPrint all three properties.\\n\\n---\\n\\n### Problem 2\\n\\nAdd:\\n\\n```text\\ndepartment: \\\"AI\\\"\\n```\\n\\nto the object.\\n\\n---\\n\\n### Problem 3\\n\\nCreate a **new object** where salary becomes `60000`, without modifying the original.\\n\\n---\\n\\n### Problem 4\\n\\nGiven:\\n\\n```js\\nconst employee = {\\n    name: \\\"John\\\",\\n    age: 25,\\n    address: {\\n        city: \\\"Chennai\\\",\\n        country: \\\"India\\\"\\n    }\\n};\\n```\\n\\nExtract `name` and `city` using destructuring.\\n\\n---\\n\\n### Problem 5\\n\\nGiven:\\n\\n```js\\nconst employees = {\\n    e1: \\\"John\\\",\\n    e2: \\\"Alice\\\",\\n    e3: \\\"Bob\\\"\\n};\\n```\\n\\nPrint:\\n\\n```text\\ne1 John\\ne2 Alice\\ne3 Bob\\n```\\n\\nusing `Object.entries()` and `for...of`.\\n\\n---\\n\\n### Problem 6 — interview\\n\\nExplain why this is `false`:\\n\\n```js\\nconst a = { x: 10 };\\nconst b = { x: 10 };\\n\\nconsole.log(a === b);\\n```\\n\\n---\\n\\n## Next Phase: Functions ⭐⭐⭐\\n\\nThis is where JavaScript really starts separating itself from Java.\\n\\nWe'll cover:\\n\\n```text\\nfunction declarations\\nfunction expressions\\narrow functions\\nparameters\\nreturn values\\ndefault parameters\\nrest parameters\\ncallbacks\\nhigher-order functions\\nfirst-class functions\\nclosures\\nscope\\nhoisting\\nIIFE\\n```\\n\\nAnd I'll connect all of this directly to your Java knowledge of **methods, lambdas, functional interfaces, local variables, and scope**.\",{},{\"_197\":3173,\"_204\":3478,\"_54\":3479,\"_56\":3480,\"_208\":3481,\"_210\":211,\"_213\":214,\"_215\":3482,\"_217\":218},\"f12732f7-0b48-4375-ad83-3b19d6b0c750\",[3162],{\"_656\":709,\"_215\":3487},178