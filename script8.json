:3917,\"_440\":3918,\"_442\":3919,\"_444\":3920,\"_446\":3921,\"_448\":3922,\"_450\":3923,\"_452\":3924,\"_454\":3925,\"_456\":3926,\"_458\":3927},[],\"ebf1f560-49c7-4cbb-b5c0-4aae9396581e\",\"054e6d38-a690-4d7c-af6c-1625deda82b7\",\"360cefb0-fbfa-427b-a045-62bcd8749c44\",{\"_197\":4014,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":4013,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":4012,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":4011,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":4010,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":4009,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":4008,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":4007,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":4006,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":4005,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":4004,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":4003,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":4002,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":4001,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":4000,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3999,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3998,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3997,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3996,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3995,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3994,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3993,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3992,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3991,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3990,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3989,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3988,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3987,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3986,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3985,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3984,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3983,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3982,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3981,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3980,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3979,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3978,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3977,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3976,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3975,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3974,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3973,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3972,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3971,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3970,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3969,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3968,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3967,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3966,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3965,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3964,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3963,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3962,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3961,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3960,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3959,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3958,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3957,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3956,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3955,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3954,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3953,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3952,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3951,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3950,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3949,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3948,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3947,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3946,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3945,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3944,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3943,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3942,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3941,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3940,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3939,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3938,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3937,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3936,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3935,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3934,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3933,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3932,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3931,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3930,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3929,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":3928,\"_525\":14,\"_526\":14,\"_527\":-5},\"30q7ta\",\"r8dblj\",\"m8mpx5\",\"aq07vm\",\"f0vh4f\",\"nhos1y\",\"xs5pdq\",\"xr3qls\",\"9wjr7x\",\"7o298c\",\"8944oo\",\"4e3acv\",\"ga8rfe\",\"93ey6o\",\"bnaf5a\",\"tasfcn\",\"cce24q\",\"19izql\",\"synmva\",\"g2q3nc\",\"7aqnmh\",\"81nwto\",\"by9p06\",\"mtnwls\",\"8b4tcq\",\"8o1unb\",\"2rxbtj\",\"8h3row\",\"627htb\",\"ymo2ht\",\"1ao5ik\",\"ux4no0\",\"jeohww\",\"l31q8u\",\"zpyft7\",\"pbfivq\",\"8vb74a\",\"yt2iv5\",\"evmrw9\",\"vja8y1\",\"i6dhq2\",\"1be5j8\",\"urwry6\",\"a62qtr\",\"cugzlz\",\"1pdtxw\",\"39udky\",\"01xely\",\"x2dbuf\",\"seatzb\",\"paxbs8\",\"e0q8mw\",\"bhoat7\",\"v95t0y\",\"p40cr7\",\"v98rwg\",\"ej9tbb\",\"neds7l\",\"f7ajct\",\"cdc7ew\",\"08x640\",\"iowgfr\",\"6l4p62\",\"hwm4y2\",\"62h6zq\",\"3bx8tn\",\"ae8i7n\",\"n8g8wt\",\"cqc1y9\",\"5tft1n\",\"dawc82\",\"zt03jg\",\"9v7gel\",\"kipmwi\",\"qbrrnr\",\"yubdpl\",\"krihfe\",\"g03qpl\",\"s0wwa8\",\"z5c5jm\",\"z1vtbp\",\"6r5xte\",\"f7s2ft\",\"62n68r\",\"k1y3e9\",\"gzwxfw\",\"b7x6fh\",[650],[4017],\"# Phase 2 — Conditions \u0026 Loops\\n\\nNow we're entering the part where your **Core Java knowledge transfers heavily**.\\n\\nThe syntax is mostly familiar, but JavaScript has some important differences that you need to know for interviews and real coding.\\n\\n---\\n\\n# 2.1 `if`, `else if`, `else`\\n\\nJava:\\n\\n```java\\nint age = 20;\\n\\nif (age \u003e= 18) {\\n    System.out.println(\\\"Adult\\\");\\n} else {\\n    System.out.println(\\\"Minor\\\");\\n}\\n```\\n\\nJavaScript:\\n\\n```js\\nlet age = 20;\\n\\nif (age \u003e= 18) {\\n    console.log(\\\"Adult\\\");\\n} else {\\n    console.log(\\\"Minor\\\");\\n}\\n```\\n\\nAlmost identical.\\n\\nThe major difference is what we discussed:\\n\\n**Java requires a boolean condition.**\\n\\nJavaScript allows any expression that can be converted to truthy/falsy.\\n\\n```js\\nlet age = 20;\\n\\nif (age) {\\n    console.log(\\\"Runs\\\");\\n}\\n```\\n\\n`20` is truthy, so it runs.\\n\\n---\\n\\n# 2.2 Nested conditions\\n\\nSame as Java:\\n\\n```js\\nlet age = 25;\\nlet hasLicense = true;\\n\\nif (age \u003e= 18) {\\n    if (hasLicense) {\\n        console.log(\\\"Can drive\\\");\\n    }\\n}\\n```\\n\\nBut JavaScript code often uses `\u0026\u0026` to simplify:\\n\\n```js\\nif (age \u003e= 18 \u0026\u0026 hasLicense) {\\n    console.log(\\\"Can drive\\\");\\n}\\n```\\n\\n---\\n\\n# 2.3 `else if`\\n\\nSame:\\n\\n```js\\nlet marks = 85;\\n\\nif (marks \u003e= 90) {\\n    console.log(\\\"A+\\\");\\n} else if (marks \u003e= 80) {\\n    console.log(\\\"A\\\");\\n} else if (marks \u003e= 70) {\\n    console.log(\\\"B\\\");\\n} else {\\n    console.log(\\\"C\\\");\\n}\\n```\\n\\nNo major difference from Java here.\\n\\n---\\n\\n# 2.4 `switch`\\n\\nAgain, familiar:\\n\\n```js\\nlet day = 2;\\n\\nswitch (day) {\\n    case 1:\\n        console.log(\\\"Monday\\\");\\n        break;\\n\\n    case 2:\\n        console.log(\\\"Tuesday\\\");\\n        break;\\n\\n    case 3:\\n        console.log(\\\"Wednesday\\\");\\n        break;\\n\\n    default:\\n        console.log(\\\"Invalid\\\");\\n}\\n```\\n\\nOutput:\\n\\n```text\\nTuesday\\n```\\n\\n### ⚠️ Important\\n\\nDon't forget `break`.\\n\\nWithout it:\\n\\n```js\\nlet day = 2;\\n\\nswitch (day) {\\n    case 2:\\n        console.log(\\\"Tuesday\\\");\\n\\n    case 3:\\n        console.log(\\\"Wednesday\\\");\\n}\\n```\\n\\nOutput:\\n\\n```text\\nTuesday\\nWednesday\\n```\\n\\nThis is called **fall-through**.\\n\\nSame basic behavior exists in Java.\\n\\n---\\n\\n# 2.5 Strict comparison in `switch`\\n\\nHere's a JavaScript detail worth knowing.\\n\\n`switch` uses **strict comparison** semantics.\\n\\nConceptually:\\n\\n```js\\nswitch (value)\\n```\\n\\nmatches cases as though using `===`.\\n\\nFor example:\\n\\n```js\\nlet x = \\\"1\\\";\\n\\nswitch (x) {\\n    case 1:\\n        console.log(\\\"number\\\");\\n        break;\\n\\n    case \\\"1\\\":\\n        console.log(\\\"string\\\");\\n        break;\\n}\\n```\\n\\nOutput:\\n\\n```text\\nstring\\n```\\n\\nbecause:\\n\\n```js\\n\\\"1\\\" === 1\\n```\\n\\nis false.\\n\\n---\\n\\n# 2.6 Ternary operator\\n\\nYou already know this from Java.\\n\\n```js\\nlet age = 20;\\n\\nlet result = age \u003e= 18 ? \\\"Adult\\\" : \\\"Minor\\\";\\n\\nconsole.log(result);\\n```\\n\\nThink:\\n\\n```text\\ncondition ? valueIfTrue : valueIfFalse\\n```\\n\\nUseful for simple decisions.\\n\\nDon't write huge nested ternaries like:\\n\\n```js\\nlet x = a ? b : c ? d : e ? f : g;\\n```\\n\\nThat's technically possible but usually terrible for readability.\\n\\n---\\n\\n# 2.7 `for` loop\\n\\nExactly like Java:\\n\\n```java\\nfor (int i = 0; i \u003c 5; i++) {\\n    System.out.println(i);\\n}\\n```\\n\\nJavaScript:\\n\\n```js\\nfor (let i = 0; i \u003c 5; i++) {\\n    console.log(i);\\n}\\n```\\n\\nOutput:\\n\\n```text\\n0\\n1\\n2\\n3\\n4\\n```\\n\\nYour Java knowledge transfers directly.\\n\\n---\\n\\n# 2.8 `while`\\n\\nJava:\\n\\n```java\\nwhile (condition) {\\n}\\n```\\n\\nJavaScript:\\n\\n```js\\nwhile (condition) {\\n}\\n```\\n\\nExample:\\n\\n```js\\nlet i = 0;\\n\\nwhile (i \u003c 5) {\\n    console.log(i);\\n    i++;\\n}\\n```\\n\\nSame behavior.\\n\\n---\\n\\n# 2.9 `do...while`\\n\\nAgain:\\n\\n```js\\nlet i = 0;\\n\\ndo {\\n    console.log(i);\\n    i++;\\n} while (i \u003c 5);\\n```\\n\\nThe body executes at least once.\\n\\nSame as Java.\\n\\n---\\n\\n# 2.10 `break`\\n\\nSame:\\n\\n```js\\nfor (let i = 0; i \u003c 10; i++) {\\n    if (i === 5) {\\n        break;\\n    }\\n\\n    console.log(i);\\n}\\n```\\n\\nOutput:\\n\\n```text\\n0\\n1\\n2\\n3\\n4\\n```\\n\\n---\\n\\n# 2.11 `continue`\\n\\nSame:\\n\\n```js\\nfor (let i = 0; i \u003c 5; i++) {\\n    if (i === 2) {\\n        continue;\\n    }\\n\\n    console.log(i);\\n}\\n```\\n\\nOutput:\\n\\n```text\\n0\\n1\\n3\\n4\\n```\\n\\nSo far, you can basically use your Java knowledge.\\n\\nBut now we reach **JavaScript-specific loops**.\\n\\n---\\n\\n# 2.12 `for...of` ⭐\\n\\nThis is extremely important.\\n\\nSuppose:\\n\\n```js\\nconst numbers = [10, 20, 30, 40];\\n```\\n\\nYou can iterate over the **values**:\\n\\n```js\\nfor (const number of numbers) {\\n    console.log(number);\\n}\\n```\\n\\nOutput:\\n\\n```text\\n10\\n20\\n30\\n40\\n```\\n\\nThink of this roughly as Java's enhanced for loop:\\n\\n```java\\nfor (int number : numbers) {\\n    System.out.println(number);\\n}\\n```\\n\\nSo:\\n\\n```text\\nJava                     JavaScript\\n\\nfor (int x : array)      for (const x of array)\\n```\\n\\nThis is a very useful mapping.\\n\\n---\\n\\n# 2.13 `for...in` ⚠️\\n\\nNow we have another JavaScript loop:\\n\\n```js\\nconst user = {\\n    name: \\\"Dev\\\",\\n    age: 21,\\n    city: \\\"Chennai\\\"\\n};\\n\\nfor (const key in user) {\\n    console.log(key);\\n}\\n```\\n\\nOutput:\\n\\n```text\\nname\\nage\\ncity\\n```\\n\\n`for...in` iterates over **property keys**.\\n\\nYou can access the value:\\n\\n```js\\nfor (const key in user) {\\n    console.log(key, user[key]);\\n}\\n```\\n\\nOutput:\\n\\n```text\\nname Dev\\nage 21\\ncity Chennai\\n```\\n\\n---\\n\\n# 2.14 `for...of` vs `for...in`\\n\\nThis is an interview favorite.\\n\\n### `for...of`\\n\\nIterates over **values** of an iterable.\\n\\n```js\\nconst numbers = [10, 20, 30];\\n\\nfor (const value of numbers) {\\n    console.log(value);\\n}\\n```\\n\\nOutput:\\n\\n```text\\n10\\n20\\n30\\n```\\n\\n### `for...in`\\n\\nIterates over **keys/property names**.\\n\\n```js\\nconst user = {\\n    name: \\\"Dev\\\",\\n    age: 21\\n};\\n\\nfor (const key in user) {\\n    console.log(key);\\n}\\n```\\n\\nOutput:\\n\\n```text\\nname\\nage\\n```\\n\\n### Memorize the direction:\\n\\n```text\\nfor...of  → values\\nfor...in  → keys\\n```\\n\\n---\\n\\n# 2.15 ⚠️ Java programmer trap with arrays\\n\\nConsider:\\n\\n```js\\nconst numbers = [10, 20, 30];\\n```\\n\\nYou might see:\\n\\n```js\\nfor (const index in numbers) {\\n    console.log(index);\\n}\\n```\\n\\nOutput:\\n\\n```text\\n0\\n1\\n2\\n```\\n\\nThese are **keys/indexes**, not the values.\\n\\nTo get values:\\n\\n```js\\nfor (const value of numbers) {\\n    console.log(value);\\n}\\n```\\n\\nOutput:\\n\\n```text\\n10\\n20\\n30\\n```\\n\\nTherefore:\\n\\n\u003e **Use `for...of` when you want array values.**\\n\\n---\\n\\n# 2.16 `forEach()`\\n\\nNow we're moving toward the functional style of JavaScript.\\n\\n```js\\nconst numbers = [10, 20, 30];\\n\\nnumbers.forEach(function(number) {\\n    console.log(number);\\n});\\n```\\n\\nOutput:\\n\\n```text\\n10\\n20\\n30\\n```\\n\\nYou can write it using an arrow function:\\n\\n```js\\nnumbers.forEach((number) =\u003e {\\n    console.log(number);\\n});\\n```\\n\\nOr shorter:\\n\\n```js\\nnumbers.forEach(number =\u003e console.log(number));\\n```\\n\\nWe'll properly learn arrow functions and callbacks in the next major phase.\\n\\nFor now, recognize the structure:\\n\\n```text\\narray.forEach(function)\\n```\\n\\nmeans:\\n\\n\u003e Run this function once for every array element.\\n\\n---\\n\\n# 2.17 `forEach` gives you index too\\n\\n```js\\nconst numbers = [10, 20, 30];\\n\\nnumbers.forEach((value, index) =\u003e {\\n    console.log(index, value);\\n});\\n```\\n\\nOutput:\\n\\n```text\\n0 10\\n1 20\\n2 30\\n```\\n\\nThe callback receives:\\n\\n```text\\nvalue\\nindex\\narray\\n```\\n\\nSo technically:\\n\\n```js\\nnumbers.forEach((value, index, array) =\u003e {\\n    // ...\\n});\\n```\\n\\n---\\n\\n# 2.18 `for` vs `for...of` vs `forEach`\\n\\nGiven:\\n\\n```js\\nconst numbers = [10, 20, 30];\\n```\\n\\n### Traditional `for`\\n\\n```js\\nfor (let i = 0; i \u003c numbers.length; i++) {\\n    console.log(numbers[i]);\\n}\\n```\\n\\nYou control the index.\\n\\n### `for...of`\\n\\n```js\\nfor (const number of numbers) {\\n    console.log(number);\\n}\\n```\\n\\nYou directly get values.\\n\\n### `forEach`\\n\\n```js\\nnumbers.forEach(number =\u003e {\\n    console.log(number);\\n});\\n```\\n\\nYou give JavaScript a function to execute for every element.\\n\\n---\\n\\n# 2.19 When should you use which?\\n\\n### Need index/control?\\n\\n```js\\nfor (let i = 0; i \u003c arr.length; i++)\\n```\\n\\n### Want values simply?\\n\\n```js\\nfor (const value of arr)\\n```\\n\\n### Want functional processing?\\n\\n```js\\narr.forEach(...)\\n```\\n\\nLater you'll learn that for transformations, these are often better:\\n\\n```js\\nmap()\\nfilter()\\nreduce()\\n```\\n\\nThose are **extremely important for JavaScript interviews and React**.\\n\\n---\\n\\n# 2.20 Block scope matters\\n\\nRemember `let`?\\n\\n```js\\nfor (let i = 0; i \u003c 3; i++) {\\n    console.log(i);\\n}\\n\\nconsole.log(i); // ❌ ReferenceError\\n```\\n\\nBecause `i` exists only inside the loop's block.\\n\\nThis is another reason modern JS uses `let` instead of `var`.\\n\\nWith:\\n\\n```js\\nfor (var i = 0; i \u003c 3; i++) {\\n}\\n\\nconsole.log(i);\\n```\\n\\n`i` is still accessible.\\n\\nThis becomes very important when we study **closures and asynchronous code**.\\n\\n---\\n\\n# 2.21 A practical example\\n\\nLet's say you have marks:\\n\\n```js\\nconst marks = [45, 80, 92, 67, 30];\\n```\\n\\nPrint only marks above 70:\\n\\n```js\\nfor (const mark of marks) {\\n    if (mark \u003e 70) {\\n        console.log(mark);\\n    }\\n}\\n```\\n\\nOutput:\\n\\n```text\\n80\\n92\\n```\\n\\nVery straightforward.\\n\\nLater we'll write this much more elegantly using:\\n\\n```js\\nfilter()\\n```\\n\\n---\\n\\n# 2.22 Another example — FizzBuzz\\n\\nYou know this classic interview problem.\\n\\n```js\\nfor (let i = 1; i \u003c= 15; i++) {\\n\\n    if (i % 15 === 0) {\\n        console.log(\\\"FizzBuzz\\\");\\n    } else if (i % 3 === 0) {\\n        console.log(\\\"Fizz\\\");\\n    } else if (i % 5 === 0) {\\n        console.log(\\\"Buzz\\\");\\n    } else {\\n        console.log(i);\\n    }\\n}\\n```\\n\\nNotice something:\\n\\nI'm deliberately using:\\n\\n```js\\n===\\n```\\n\\nrather than:\\n\\n```js\\n==\\n```\\n\\nThat's the style you should develop.\\n\\n---\\n\\n# 2.23 Java → JavaScript mapping\\n\\n| Java | JavaScript |\\n|---|---|\\n| `if` | `if` |\\n| `else if` | `else if` |\\n| `else` | `else` |\\n| `switch` | `switch` |\\n| `for` | `for` |\\n| `while` | `while` |\\n| `do while` | `do while` |\\n| `break` | `break` |\\n| `continue` | `continue` |\\n| enhanced `for` | `for...of` |\\n| iterate map keys | `for...in` / `Object.keys()` depending on use |\\n| ternary | ternary |\\n| boolean condition | truthy/falsy condition |\\n\\n---\\n\\n# 🔥 Interview questions from this phase\\n\\n### Q1\\nWhat's the difference between:\\n\\n```js\\nfor (const x of arr)\\n```\\n\\nand:\\n\\n```js\\nfor (const x in arr)\\n```\\n\\n**Answer:**\\n\\n\u003e `for...of` iterates over values, while `for...in` iterates over enumerable property keys.\\n\\n---\\n\\n### Q2\\nWhy is this usually preferable?\\n\\n```js\\nfor (const value of numbers)\\n```\\n\\ninstead of:\\n\\n```js\\nfor (const index in numbers)\\n```\\n\\nwhen processing an array?\\n\\nBecause `for...of` directly gives the array's values, while `for...in` gives property keys/indexes.\\n\\n---\\n\\n### Q3\\nCan JavaScript's `if` accept a number?\\n\\nYes.\\n\\n```js\\nif (10) {\\n    console.log(\\\"yes\\\");\\n}\\n```\\n\\nbecause `10` is truthy.\\n\\n---\\n\\n### Q4\\nWhat does `break` do?\\n\\nImmediately terminates the nearest applicable loop or switch.\\n\\n---\\n\\n### Q5\\nWhat does `continue` do?\\n\\nSkips the current iteration and proceeds to the next iteration.\\n\\n---\\n\\n# 🎯 Your coding checkpoint\\n\\nTry writing these yourself.\\n\\n### Problem 1\\n\\nGiven:\\n\\n```js\\nconst numbers = [10, 25, 30, 45, 50];\\n```\\n\\nPrint only numbers greater than `30`.\\n\\n---\\n\\n### Problem 2\\n\\nGiven:\\n\\n```js\\nconst numbers = [10, 15, 20, 25, 30];\\n```\\n\\nCalculate the sum using a normal `for` loop.\\n\\nExpected:\\n\\n```text\\n100\\n```\\n\\n---\\n\\n### Problem 3\\n\\nPrint:\\n\\n```text\\n1\\n2\\nFizz\\n4\\nBuzz\\nFizz\\n7\\n8\\nFizz\\nBuzz\\n```\\n\\nfor numbers `1` through `10`.\\n\\n---\\n\\n### Problem 4\\n\\nGiven:\\n\\n```js\\nconst user = {\\n    name: \\\"Dev\\\",\\n    age: 21,\\n    city: \\\"Chennai\\\"\\n};\\n```\\n\\nPrint:\\n\\n```text\\nname = Dev\\nage = 21\\ncity = Chennai\\n```\\n\\nusing `for...in`.\\n\\n---\\n\\n### Problem 5 — important\\n\\nExplain the difference between:\\n\\n```js\\nfor (const x of arr)\\n```\\n\\nand:\\n\\n```js\\narr.forEach(x =\u003e ...)\\n```\\n\\nDon't worry if you can't fully answer the last part yet—we haven't formally learned **callbacks**.\\n\\n---\\n\\n## Next: Phase 3 — Arrays\\n\\nThis is where JavaScript starts getting **much more different from Java**.\\n\\nWe'll cover:\\n\\n```text\\nArray creation\\nlength\\nindexing\\npush/pop\\nshift/unshift\\nslice/splice\\nconcat\\nincludes\\nindexOf\\nfind\\nfindIndex\\nmap ⭐\\nfilter ⭐\\nreduce ⭐\\nsome\\nevery\\nsort\\nreverse\\ndestructuring\\nspread\\nshallow copies\\n```\\n\\nAnd especially:\\n\\n\u003e **Java `ArrayList` → JavaScript `Array`**\\n\\nbecause JavaScript arrays are considerably more flexible than Java arrays.\",{},{\"_197\":3824,\"_204\":4022,\"_54\":4023,\"_208\":4024,\"_210\":211,\"_213\":214,\"_215\":4025,\"_217\":218},\"99349f90-2fe3-459c-9128-c88e34c95dad\",[3812],{\"_656\":657,\"_215\":4026},1789043977.9021702,{\"_651\"