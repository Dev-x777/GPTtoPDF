4\":1236,\"_466\":1237,\"_468\":1238,\"_470\":1239,\"_472\":1240,\"_474\":1241,\"_476\":1242,\"_478\":1243,\"_480\":1244,\"_482\":1245,\"_484\":1246,\"_486\":1247,\"_488\":1248,\"_490\":1249,\"_492\":1250,\"_494\":1251,\"_496\":1252,\"_498\":1253,\"_500\":1254,\"_502\":1255,\"_504\":1256,\"_506\":1257,\"_508\":1258,\"_510\":1259,\"_512\":1260,\"_514\":1261,\"_516\":1262,\"_518\":1263,\"_520\":1264,\"_522\":1265,\"_923\":1266},[],\"e3698109-d158-4222-9198-76ba9b347d62\",\"a8c53f26-8c4e-4b9b-a8b0-2859dd36b79e\",\"c85fdcd8-4c82-4e9c-b20a-ef7fae96e519\",{\"_197\":1386,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1385,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1384,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1383,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1382,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1381,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1380,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1379,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1378,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1377,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1376,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1375,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1374,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1373,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1372,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1371,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1370,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1369,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1368,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1367,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1366,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1365,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1364,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1363,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1362,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1361,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1360,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1359,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1358,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1357,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1356,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1355,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1354,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1353,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1352,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1351,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1350,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1349,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1348,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1347,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1346,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1345,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1344,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1343,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1342,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1341,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1340,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1339,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1338,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1337,\"_525\":14,\"_526\":34,\"_527\":531},{\"_197\":1336,\"_525\":14,\"_526\":34,\"_527\":531},{\"_197\":1335,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1334,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1333,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1332,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1331,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1330,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1329,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1328,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1327,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1326,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1325,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1324,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1323,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1322,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1321,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1320,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1319,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1318,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1317,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1316,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1315,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1314,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1313,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1312,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1311,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1310,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1309,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1308,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1307,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1306,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1305,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1304,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1303,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1302,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1301,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1300,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1299,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1298,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1297,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1296,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1295,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1294,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1293,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1292,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1291,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1290,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1289,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1288,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1287,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1286,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1285,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1284,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1283,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1282,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1281,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1280,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1279,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1278,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1277,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1276,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1275,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1274,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1273,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1272,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1271,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1270,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1269,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1268,\"_525\":14,\"_526\":14,\"_527\":-5},{\"_197\":1267,\"_525\":14,\"_526\":14,\"_527\":-5},\"mf0o21\",\"1x0olo\",\"pdq4vh\",\"q1uc6j\",\"nh3a5x\",\"7xzksl\",\"ecnw17\",\"d2ubrl\",\"0b983g\",\"atn5vv\",\"psph4w\",\"eeod5v\",\"40vt43\",\"eastbw\",\"r9vjz5\",\"l0rqgf\",\"ell2qv\",\"p3az2l\",\"pct66l\",\"hqsfrf\",\"owplro\",\"7sl7l2\",\"reqemp\",\"0sif6j\",\"9w9icu\",\"6xsli9\",\"f2neum\",\"tcrq72\",\"s4jq35\",\"4kzn73\",\"dov1gh\",\"6b0gr0\",\"kvqh0h\",\"shfwvh\",\"pe5ne6\",\"epyspd\",\"sj8lgc\",\"gmoihf\",\"shmesb\",\"1bw8nt\",\"ye1fwz\",\"xlbth6\",\"qvb2oe\",\"q1zvju\",\"wkrvey\",\"af8a6j\",\"rrfjal\",\"os40rb\",\"nhuw6g\",\"ucddwy\",\"cy60b6\",\"hvqdbk\",\"82cayu\",\"orcttm\",\"5p8kvg\",\"301p9i\",\"iezyaj\",\"cdlyxh\",\"5spbf3\",\"abyark\",\"46hvdf\",\"7k376g\",\"ozztm4\",\"3m50pw\",\"vaxe6z\",\"6xbqpo\",\"kovg63\",\"le4ag4\",\"owokks\",\"j4p484\",\"v043y3\",\"7dpucy\",\"73p07f\",\"n50zgp\",\"mklvye\",\"50frud\",\"kjbvc0\",\"m3iy0c\",\"6v7ldr\",\"5upy9t\",\"fjt1u7\",\"uvmd4d\",\"q5ludo\",\"2lmlf4\",\"qmq198\",\"4qab50\",\"z5hb8d\",\"v7rhiz\",\"0vji2o\",\"q3u40c\",\"5hwkjo\",\"8i3kk2\",\"fjudml\",\"ocxv7z\",\"lnpkx3\",\"32du1p\",\"vxft2y\",\"hvxms9\",\"mr671l\",\"3c7b6n\",\"8gxbx8\",\"lwxjcw\",\"bqfmc2\",\"olrluw\",\"ygqgli\",\"u30zla\",\"1i5sle\",\"iqzda4\",\"3td249\",\"kg84qt\",\"ynsfui\",\"653i3u\",\"aqnqep\",\"7hmm3z\",\"uxvg7w\",\"kwtb8c\",\"j4q4ft\",\"w6sbup\",\"itny10\",\"mj7153\",[650],[1389],\"# 🚀 Phase 11 — JavaScript Modules \u0026 Modern JavaScript\\n\\nThis phase is where JavaScript starts becoming **real project JavaScript** rather than isolated LeetCode-style code.\\n\\nIf you've used **React + Vite**, you've already seen these concepts:\\n\\n```javascript\\nimport React from \\\"react\\\";\\nimport { useState } from \\\"react\\\";\\nimport \\\"./App.css\\\";\\n```\\n\\nNow we're going to understand **exactly what `import`, `export`, modules, npm, and `package.json` mean**.\\n\\nAs a Java developer, think:\\n\\n```text\\nJava                              JavaScript\\n--------------------------------------------------\\npackage                            module\\nimport Class                       import ...\\nimport static                      named import\\npublic class / exposed API         export\\nMaven/Gradle                       npm\\npom.xml/build.gradle               package.json\\ndependency                         package\\nJAR                                npm package\\n```\\n\\nAgain, these are **mental mappings**, not exact equivalents.\\n\\n---\\n\\n# 11.1 Why Do We Need Modules?\\n\\nImagine one huge JavaScript file:\\n\\n```javascript\\n// 10,000 lines\\n```\\n\\nEverything is in one place.\\n\\nThat's difficult to:\\n\\n- maintain\\n- test\\n- reuse\\n- understand\\n- collaborate on\\n\\nSo we divide code:\\n\\n```text\\nproject\\n│\\n├── math.js\\n├── user.js\\n├── auth.js\\n└── app.js\\n```\\n\\nEach file can expose certain functionality and import functionality from other files.\\n\\nThat's the purpose of **modules**.\\n\\n---\\n\\n# 11.2 Your First Module\\n\\n### `math.js`\\n\\n```javascript\\nexport function add(a, b) {\\n    return a + b;\\n}\\n\\nexport function subtract(a, b) {\\n    return a - b;\\n}\\n```\\n\\n### `app.js`\\n\\n```javascript\\nimport { add, subtract } from \\\"./math.js\\\";\\n\\nconsole.log(add(10, 5));\\nconsole.log(subtract(10, 5));\\n```\\n\\nOutput:\\n\\n```text\\n15\\n5\\n```\\n\\nThe flow:\\n\\n```text\\nmath.js\\n   │\\n   ├── add\\n   └── subtract\\n          │\\n          ▼\\n        export\\n          │\\n          ▼\\n        app.js\\n          │\\n        import\\n```\\n\\n---\\n\\n# 11.3 Named Exports\\n\\nThe previous example uses **named exports**:\\n\\n```javascript\\nexport function add() {}\\nexport function subtract() {}\\n```\\n\\nYou can also write:\\n\\n```javascript\\nfunction add(a, b) {\\n    return a + b;\\n}\\n\\nfunction subtract(a, b) {\\n    return a - b;\\n}\\n\\nexport {\\n    add,\\n    subtract\\n};\\n```\\n\\nThen:\\n\\n```javascript\\nimport { add, subtract } from \\\"./math.js\\\";\\n```\\n\\nThe names need to match.\\n\\n---\\n\\n# 11.4 Importing With an Alias\\n\\nSuppose:\\n\\n```javascript\\nimport { add as sum } from \\\"./math.js\\\";\\n```\\n\\nNow:\\n\\n```javascript\\nconsole.log(sum(2, 3));\\n```\\n\\nThe imported name inside this file is:\\n\\n```text\\nsum\\n```\\n\\neven though it was exported as:\\n\\n```text\\nadd\\n```\\n\\nSimilar idea to Java aliases aren't really built into Java imports the same way, but the mental purpose is:\\n\\n\u003e avoid naming conflicts.\\n\\n---\\n\\n# 11.5 Default Export\\n\\nA module can also have a **default export**.\\n\\n```javascript\\nexport default function greet(name) {\\n    return `Hello ${name}`;\\n}\\n```\\n\\nImport:\\n\\n```javascript\\nimport greet from \\\"./greet.js\\\";\\n```\\n\\nNotice:\\n\\n```text\\nNo {}\\n```\\n\\nThat's because it's a default import.\\n\\n---\\n\\n# 11.6 Named vs Default Export\\n\\n### Named\\n\\n```javascript\\nexport function add() {}\\n```\\n\\nImport:\\n\\n```javascript\\nimport { add } from \\\"./math.js\\\";\\n```\\n\\n### Default\\n\\n```javascript\\nexport default function add() {}\\n```\\n\\nImport:\\n\\n```javascript\\nimport add from \\\"./math.js\\\";\\n```\\n\\nMental rule:\\n\\n```text\\nnamed export\\n→ { }\\n\\ndefault export\\n→ no { }\\n```\\n\\n---\\n\\n# 11.7 Default Export Can Be Renamed\\n\\nSuppose:\\n\\n```javascript\\nexport default function greet() {}\\n```\\n\\nYou can import:\\n\\n```javascript\\nimport hello from \\\"./greet.js\\\";\\n```\\n\\nor:\\n\\n```javascript\\nimport xyz from \\\"./greet.js\\\";\\n```\\n\\nThe importing file chooses the local name.\\n\\nWith named exports:\\n\\n```javascript\\nexport function greet() {}\\n```\\n\\nyou normally import:\\n\\n```javascript\\nimport { greet } from \\\"./greet.js\\\";\\n```\\n\\nunless you explicitly alias it:\\n\\n```javascript\\nimport { greet as hello } from \\\"./greet.js\\\";\\n```\\n\\n---\\n\\n# 11.8 Java Comparison\\n\\nJava:\\n\\n```java\\nimport java.util.ArrayList;\\n```\\n\\nJavaScript:\\n\\n```javascript\\nimport { something } from \\\"./file.js\\\";\\n```\\n\\nBut don't assume the systems are identical.\\n\\nJava's package/class system and JavaScript's ES module system solve similar organization/reuse problems but have different semantics.\\n\\n---\\n\\n# 11.9 Import Everything\\n\\nSuppose:\\n\\n```javascript\\nimport * as math from \\\"./math.js\\\";\\n```\\n\\nThen:\\n\\n```javascript\\nconsole.log(math.add(10, 20));\\nconsole.log(math.subtract(10, 5));\\n```\\n\\nConceptually:\\n\\n```text\\nmath\\n│\\n├── add\\n└── subtract\\n```\\n\\nThis is called a **namespace import**.\\n\\n---\\n\\n# 11.10 Re-exporting\\n\\nSuppose:\\n\\n```text\\nsrc/\\n│\\n├── math.js\\n├── user.js\\n└── index.js\\n```\\n\\n`math.js`:\\n\\n```javascript\\nexport function add(a, b) {\\n    return a + b;\\n}\\n```\\n\\n`user.js`:\\n\\n```javascript\\nexport function getUser() {\\n    return { name: \\\"Dev\\\" };\\n}\\n```\\n\\n`index.js` can re-export:\\n\\n```javascript\\nexport { add } from \\\"./math.js\\\";\\nexport { getUser } from \\\"./user.js\\\";\\n```\\n\\nThen another file can simply do:\\n\\n```javascript\\nimport { add, getUser } from \\\"./index.js\\\";\\n```\\n\\nThis pattern is common in libraries.\\n\\n---\\n\\n# 11.11 Modules Have Their Own Scope\\n\\nThis is important.\\n\\nSuppose `a.js` contains:\\n\\n```javascript\\nconst secret = 123;\\n```\\n\\nand `b.js` contains:\\n\\n```javascript\\nconsole.log(secret);\\n```\\n\\nThat doesn't automatically work.\\n\\nVariables in one module aren't automatically global variables accessible from another module.\\n\\nYou need:\\n\\n```javascript\\n// a.js\\nexport const secret = 123;\\n```\\n\\nand:\\n\\n```javascript\\n// b.js\\nimport { secret } from \\\"./a.js\\\";\\n```\\n\\nSo modules provide a useful boundary.\\n\\n---\\n\\n# 11.12 Module Scope vs Global Scope\\n\\nWithout modules, old browser JavaScript often put variables/functions into global scope depending on how they were declared.\\n\\nWith ES modules:\\n\\n```javascript\\nconst x = 10;\\n```\\n\\nis scoped to that module.\\n\\nIt isn't automatically a global variable.\\n\\nThis helps avoid naming conflicts.\\n\\n---\\n\\n# 11.13 ES Modules Are Strict Mode by Default\\n\\nCode in ES modules executes in **strict mode** automatically.\\n\\nSo you don't need:\\n\\n```javascript\\n\\\"use strict\\\";\\n```\\n\\njust to enable strict mode for an ES module.\\n\\nStrict mode changes various behaviors and catches certain problematic patterns.\\n\\n---\\n\\n# 11.14 What Is Strict Mode?\\n\\nExample:\\n\\n```javascript\\n\\\"use strict\\\";\\n\\nx = 10;\\n```\\n\\nThis throws an error because `x` wasn't declared.\\n\\nWithout strict mode, older JavaScript behavior could create an accidental global in some situations.\\n\\nStrict mode helps catch these kinds of mistakes.\\n\\n---\\n\\n# 11.15 `this` in Modules\\n\\nAnother useful fact:\\n\\nTop-level `this` in an ES module is:\\n\\n```javascript\\nundefined\\n```\\n\\nrather than the global object.\\n\\nExample:\\n\\n```javascript\\nconsole.log(this);\\n```\\n\\nin an ES module:\\n\\n```text\\nundefined\\n```\\n\\nThis is another consequence of the module execution model.\\n\\n---\\n\\n# 11.16 How Does a Browser Know It's a Module?\\n\\nIn HTML:\\n\\n```html\\n\u003cscript type=\\\"module\\\" src=\\\"./app.js\\\"\u003e\u003c/script\u003e\\n```\\n\\nThe:\\n\\n```html\\ntype=\\\"module\\\"\\n```\\n\\ntells the browser that the script is an ES module.\\n\\nThen inside:\\n\\n```javascript\\n// app.js\\n\\nimport { add } from \\\"./math.js\\\";\\n```\\n\\nthe browser can resolve the module dependency.\\n\\n---\\n\\n# 11.17 Module Dependency Graph\\n\\nSuppose:\\n\\n```text\\napp.js\\n ├── math.js\\n │\\n └── user.js\\n      └── api.js\\n```\\n\\nThe runtime/build tooling can construct a dependency graph:\\n\\n```text\\n             app.js\\n             /    \\\\\\n            ↓      ↓\\n        math.js   user.js\\n                    ↓\\n                  api.js\\n```\\n\\nThis concept becomes **very important in Vite, React, Webpack, Rollup, etc.**\\n\\n---\\n\\n# 11.18 What Vite Is Doing\\n\\nYou've used:\\n\\n```bash\\nnpm create vite@latest\\n```\\n\\nYou might have wondered:\\n\\n\u003e What exactly is Vite doing?\\n\\nAt a high level, modern frontend tooling handles things such as:\\n\\n- module resolution\\n- development server\\n- transforming source code\\n- dependency handling\\n- production bundling/building\\n- asset processing\\n\\nSo when you write:\\n\\n```javascript\\nimport { add } from \\\"./math.js\\\";\\n```\\n\\nyour development/build tooling understands the dependency relationship.\\n\\n---\\n\\n# 11.19 npm\\n\\nNow let's connect JavaScript to its package ecosystem.\\n\\nYou've probably seen:\\n\\n```bash\\nnpm install react\\n```\\n\\nWhat is `npm`?\\n\\n**npm** commonly refers to the JavaScript package manager and its ecosystem/registry.\\n\\nIt allows you to:\\n\\n- install packages\\n- manage dependencies\\n- run scripts\\n- publish packages\\n- specify project metadata\\n\\n---\\n\\n# 11.20 `package.json`\\n\\nA typical project might have:\\n\\n```json\\n{\\n  \\\"name\\\": \\\"my-project\\\",\\n  \\\"version\\\": \\\"1.0.0\\\",\\n  \\\"scripts\\\": {\\n    \\\"dev\\\": \\\"vite\\\",\\n    \\\"build\\\": \\\"vite\\\"\\n  },\\n  \\\"dependencies\\\": {\\n    \\\"react\\\": \\\"^19.0.0\\\"\\n  }\\n}\\n```\\n\\nDon't worry about every field yet.\\n\\nThe important ones:\\n\\n```text\\nname\\nversion\\nscripts\\ndependencies\\ndevDependencies\\n```\\n\\n---\\n\\n# 11.21 Dependencies\\n\\nSuppose:\\n\\n```bash\\nnpm install axios\\n```\\n\\nIt gets added to:\\n\\n```json\\n\\\"dependencies\\\": {\\n    \\\"axios\\\": \\\"...\\\"\\n}\\n```\\n\\nThis tells the project:\\n\\n\u003e Axios is required by the application.\\n\\nThen your code can:\\n\\n```javascript\\nimport axios from \\\"axios\\\";\\n```\\n\\n---\\n\\n# 11.22 `devDependencies`\\n\\nSome packages are mainly needed during development/building.\\n\\nFor example:\\n\\n```text\\ntesting tools\\nlinters\\nbuild tools\\ndevelopment tooling\\n```\\n\\nThese can go under:\\n\\n```json\\n\\\"devDependencies\\\"\\n```\\n\\nExample:\\n\\n```json\\n{\\n  \\\"devDependencies\\\": {\\n    \\\"vite\\\": \\\"^...\\\"\\n  }\\n}\\n```\\n\\nConceptually:\\n\\n```text\\ndependencies\\n→ needed by application/runtime deployment in the relevant environment\\n\\ndevDependencies\\n→ primarily needed for development/build/test tooling\\n```\\n\\nThe exact production-install behavior depends on package-manager configuration and deployment setup.\\n\\n---\\n\\n# 11.23 `npm install`\\n\\nWhen you run:\\n\\n```bash\\nnpm install\\n```\\n\\nnpm reads:\\n\\n```text\\npackage.json\\n```\\n\\nand installs the project's dependencies.\\n\\nYou'll usually get:\\n\\n```text\\nnode_modules/\\n```\\n\\nand:\\n\\n```text\\npackage-lock.json\\n```\\n\\n---\\n\\n# 11.24 `node_modules`\\n\\nThis folder contains installed packages and their dependencies.\\n\\nFor example:\\n\\n```text\\nnode_modules/\\n│\\n├── react/\\n├── vite/\\n├── ...\\n└── dependencies\\n```\\n\\n⚠️ Normally you don't manually edit files inside `node_modules`.\\n\\nIt's generated/managed by the package manager.\\n\\n---\\n\\n# 11.25 `package-lock.json`\\n\\nThis file records resolved dependency information so installations can be reproduced more consistently.\\n\\nThink:\\n\\n```text\\npackage.json\\n→ what versions/ranges the project requests\\n\\npackage-lock.json\\n→ exact dependency resolution information recorded by npm\\n```\\n\\n### Java comparison\\n\\nThis is somewhat like the relationship between:\\n\\n```text\\npom.xml\\n```\\n\\nand Maven's resolved dependency information.\\n\\nBut again, the systems aren't identical.\\n\\n---\\n\\n# 11.26 npm Scripts\\n\\nSuppose:\\n\\n```json\\n{\\n  \\\"scripts\\\": {\\n    \\\"dev\\\": \\\"vite\\\",\\n    \\\"build\\\": \\\"vite\\\",\\n    \\\"test\\\": \\\"vitest\\\"\\n  }\\n}\\n```\\n\\nYou can run:\\n\\n```bash\\nnpm run dev\\n```\\n\\nor:\\n\\n```bash\\nnpm run build\\n```\\n\\nFor the special `start`/`test` conventions there are npm-specific command behaviors, but `npm run \u003cscript\u003e` is the general pattern.\\n\\n---\\n\\n# 11.27 Semantic Versioning\\n\\nYou'll frequently see:\\n\\n```json\\n\\\"react\\\": \\\"^19.0.0\\\"\\n```\\n\\nor:\\n\\n```json\\n\\\"package\\\": \\\"~2.4.1\\\"\\n```\\n\\nVersion format:\\n\\n```text\\nMAJOR.MINOR.PATCH\\n```\\n\\nExample:\\n\\n```text\\n19.2.3\\n│  │ │\\n│  │ └── patch\\n│  └──── minor\\n└─────── major\\n```\\n\\nConceptually:\\n\\n### Major\\n\\nPotentially breaking changes.\\n\\n### Minor\\n\\nNew backward-compatible features.\\n\\n### Patch\\n\\nBackward-compatible bug fixes.\\n\\n---\\n\\n# 11.28 `^` vs `~`\\n\\nA common interview/project question.\\n\\nFor example:\\n\\n```text\\n^1.2.3\\n```\\n\\ngenerally allows compatible updates within the specified major version under npm's semver rules.\\n\\nWhile:\\n\\n```text\\n~1.2.3\\n```\\n\\ngenerally allows patch-level updates within the specified minor version.\\n\\nThe exact behavior has edge cases around `0.x` versions, so don't oversimplify it to \\\"caret always means minor updates.\\\"\\n\\n---\\n\\n# 11.29 Dynamic Imports\\n\\nNormal import:\\n\\n```javascript\\nimport { heavyFunction } from \\\"./heavy.js\\\";\\n```\\n\\nis statically declared.\\n\\nYou can also dynamically import:\\n\\n```javascript\\nconst module = await import(\\\"./heavy.js\\\");\\n```\\n\\nThen:\\n\\n```javascript\\nmodule.heavyFunction();\\n```\\n\\nDynamic imports return a Promise.\\n\\nThis is useful for:\\n\\n- lazy loading\\n- code splitting\\n- loading features only when needed\\n\\n---\\n\\n# 11.30 Example — Lazy Loading\\n\\nImagine an admin page that only some users access.\\n\\nInstead of loading everything immediately:\\n\\n```javascript\\nasync function openAdminPanel() {\\n    const module = await import(\\\"./admin.js\\\");\\n\\n    module.open();\\n}\\n```\\n\\nThe admin module can be loaded when needed.\\n\\nThis can improve initial loading behavior.\\n\\n---\\n\\n# 11.31 Top-Level `await`\\n\\nIn supported ES module environments, you can use:\\n\\n```javascript\\nconst data = await fetch(\\\"/api/data\\\");\\n```\\n\\ndirectly at module top level.\\n\\nExample:\\n\\n```javascript\\nconst response = await fetch(\\\"/api/config\\\");\\nconst config = await response.json();\\n\\nconsole.log(config);\\n```\\n\\nYou don't necessarily need:\\n\\n```javascript\\nasync function main() {}\\n```\\n\\naround it.\\n\\nBut this is specifically a **module** feature.\\n\\n---\\n\\n# 11.32 Why Top-Level Await Matters\\n\\nSuppose:\\n\\n```text\\nconfig.js\\n   ↓\\napp.js\\n```\\n\\n`config.js` might perform asynchronous module initialization.\\n\\nThen other modules depending on it may wait for its evaluation.\\n\\nThis is powerful, but you shouldn't use top-level `await` everywhere without considering module initialization dependencies.\\n\\n---\\n\\n# 11.33 CommonJS vs ES Modules\\n\\nYou'll encounter two major module systems in the JavaScript ecosystem.\\n\\n### ES Modules\\n\\n```javascript\\nimport express from \\\"express\\\";\\n\\nexport function test() {}\\n```\\n\\n### CommonJS\\n\\n```javascript\\nconst express = require(\\\"express\\\");\\n\\nmodule.exports = test;\\n```\\n\\nCommonJS is historically associated with Node.js.\\n\\nES Modules are the standardized modern JavaScript module system.\\n\\n---\\n\\n# 11.34 `require()` vs `import`\\n\\nCommonJS:\\n\\n```javascript\\nconst fs = require(\\\"fs\\\");\\n```\\n\\nESM:\\n\\n```javascript\\nimport fs from \\\"fs\\\";\\n```\\n\\nDon't mix the two blindly.\\n\\nA project needs to be configured/structured appropriately for the module system being used.\\n\\n---\\n\\n# 11.35 Java Comparison\\n\\nThink:\\n\\n```text\\nJava\\n.java files\\n    ↓\\npackage\\n    ↓\\nimport\\n    ↓\\nclasses\\n```\\n\\nModern JavaScript:\\n\\n```text\\n.js files\\n    ↓\\nES modules\\n    ↓\\nexport/import\\n    ↓\\nfunctions/objects/classes/etc.\\n```\\n\\nJavaScript modules don't require everything to be a class.\\n\\nThis is one of the biggest differences.\\n\\n---\\n\\n# 11.36 Tree Shaking\\n\\nThis is an important frontend interview concept.\\n\\nSuppose:\\n\\n```javascript\\n// math.js\\nexport function add() {}\\nexport function subtract() {}\\nexport function multiply() {}\\nexport function divide() {}\\n```\\n\\nAnd:\\n\\n```javascript\\nimport { add } from \\\"./math.js\\\";\\n```\\n\\nA build tool may determine that the other exported functions aren't needed and eliminate unused code from the production bundle.\\n\\nThis optimization is called:\\n\\n\u003e **Tree shaking**\\n\\nIt works particularly well with statically analyzable ES module imports/exports.\\n\\n---\\n\\n# 11.37 Why ES Modules Help Tree Shaking\\n\\nCompare:\\n\\n```javascript\\nimport { add } from \\\"./math.js\\\";\\n```\\n\\nThe dependency relationship is statically visible.\\n\\nThat gives build tools useful information.\\n\\nThis is one reason modern frontend ecosystems strongly use ES modules.\\n\\n---\\n\\n# 🔥 11.38 Important Interview Questions\\n\\nYou should be able to answer:\\n\\n### Q1. What is a JavaScript module?\\n\\nA self-contained unit of code with its own scope that can explicitly expose functionality through exports and consume functionality through imports.\\n\\n### Q2. Named vs default export?\\n\\n```javascript\\nexport { add };\\n```\\n\\n→ named\\n\\n```javascript\\nexport default add;\\n```\\n\\n→ default\\n\\n### Q3. How do you import a named export?\\n\\n```javascript\\nimport { add } from \\\"./math.js\\\";\\n```\\n\\n### Q4. How do you import a default export?\\n\\n```javascript\\nimport add from \\\"./math.js\\\";\\n```\\n\\n### Q5. Can a module have multiple named exports?\\n\\nYes.\\n\\n### Q6. Can it have multiple default exports?\\n\\nNo. A module can have at most one default export.\\n\\n### Q7. What is npm?\\n\\nA package manager and ecosystem used to install/manage JavaScript packages and run project scripts.\\n\\n### Q8. What is `package.json`?\\n\\nProject metadata/configuration including dependencies, scripts, and package information.\\n\\n### Q9. `package.json` vs `package-lock.json`?\\n\\n`package.json` declares project dependencies/ranges and metadata; the lockfile records the resolved dependency tree/versions used for reproducible installs.\\n\\n### Q10. What is `node_modules`?\\n\\nThe directory where installed packages and their dependencies are placed.\\n\\n### Q11. What is dynamic import?\\n\\n```javascript\\nconst module = await import(\\\"./file.js\\\");\\n```\\n\\nIt loads a module dynamically and returns a Promise.\\n\\n### Q12. What is tree shaking?\\n\\nRemoving unused code from a production bundle, commonly enabled by static ES module analysis.\\n\\n### Q13. ES Modules vs CommonJS?\\n\\n```text\\nESM:\\nimport / export\\n\\nCommonJS:\\nrequire() / module.exports\\n```\\n\\n---\\n\\n# 🧪 Phase 11 Coding Checkpoint\\n\\n## Challenge 1 — Named Export\\n\\nCreate:\\n\\n```text\\nmath.js\\n```\\n\\nwith:\\n\\n```javascript\\nadd()\\nsubtract()\\nmultiply()\\n```\\n\\nas named exports.\\n\\nThen import all three into:\\n\\n```text\\napp.js\\n```\\n\\n---\\n\\n## Challenge 2 — Default Export\\n\\nCreate:\\n\\n```text\\ngreet.js\\n```\\n\\nwith a default-exported function:\\n\\n```javascript\\ngreet(\\\"Dev\\\");\\n```\\n\\nExpected:\\n\\n```text\\nHello Dev\\n```\\n\\n---\\n\\n## Challenge 3 — Alias\\n\\nGiven:\\n\\n```javascript\\nexport function calculate(a, b) {\\n    return a + b;\\n}\\n```\\n\\nImport it locally as:\\n\\n```javascript\\nsum\\n```\\n\\nand call:\\n\\n```javascript\\nsum(10, 20);\\n```\\n\\n---\\n\\n## Challenge 4 — Dynamic Import\\n\\nCreate:\\n\\n```javascript\\nconst module = await import(\\\"./math.js\\\");\\n```\\n\\nThen call:\\n\\n```javascript\\nmodule.add(10, 20);\\n```\\n\\n---\\n\\n## Challenge 5 — Project Understanding\\n\\nExplain the purpose of each:\\n\\n```text\\npackage.json\\npackage-lock.json\\nnode_modules\\nnpm install\\nnpm run dev\\ndependencies\\ndevDependencies\\n```\\n\\nIf you can explain these without memorizing definitions, you're beginning to understand how real JS projects work.\\n\\n---\\n\\n# 🧠 Phase 11 Mental Model\\n\\n```text\\nJavaScript Project\\n│\\n├── Source files\\n│      │\\n│      └── ES Modules\\n│            ├── import\\n│            └── export\\n│\\n├── package.json\\n│      ├── dependencies\\n│      ├── devDependencies\\n│      └── scripts\\n│\\n├── package-lock.json\\n│\\n└── node_modules\\n       │\\n       └── installed packages\\n```\\n\\nAnd:\\n\\n```text\\nStatic import\\n    ↓\\nimport { x } from \\\"./module.js\\\"\\n\\nDynamic import\\n    ↓\\nawait import(\\\"./module.js\\\")\\n```\\n\\n---\\n\\n# 🗺️ Updated Roadmap\\n\\n```text\\n✅ Phase 0   Java → JS Mental Model\\n✅ Phase 1   Variables \u0026 Data Types\\n✅ Phase 1B  Operators \u0026 Coercion\\n✅ Phase 2   Conditions \u0026 Loops\\n✅ Phase 3   Arrays\\n✅ Phase 4   Objects\\n✅ Phase 5   Functions\\n✅ Phase 6   this + OOP + Prototypes\\n✅ Phase 7   Execution Model\\n✅ Phase 8   Advanced Functions\\n✅ Phase 9   Async JavaScript\\n✅ Phase 10  Collections \u0026 Built-ins\\n✅ Phase 11  Modules \u0026 Modern JS\\n              ├── import/export\\n              ├── named/default exports\\n              ├── module scope\\n              ├── strict mode\\n              ├── CommonJS\\n              ├── npm\\n              ├── package.json\\n              ├── dependencies\\n              ├── package-lock\\n              ├── dynamic imports\\n              ├── top-level await\\n              └── tree shaking\\n\\n➡️ Phase 12  Browser \u0026 DOM\\n              ├── window\\n              ├── document\\n              ├── DOM tree\\n              ├── selecting elements\\n              ├── modifying HTML\\n              ├── modifying CSS\\n              ├── attributes\\n              ├── creating elements\\n              ├── removing elements\\n              └── DOM traversal\\n\\n➡️ Phase 13  Events \u0026 Event Handling\\n➡️ Phase 14  HTTP, REST \u0026 APIs\\n➡️ Phase 15  Advanced JS Patterns\\n➡️ Phase 16  Node.js\\n➡️ Phase 17  Express.js\\n➡️ Phase 18  JavaScript Security\\n➡️ Phase 19  Performance \u0026 Memory\\n➡️ Phase 20  React JavaScript Foundations\\n➡️ Phase 21  JavaScript Interview Mastery\\n➡️ Phase 22  DSA in JavaScript\\n```\\n\\n**Phase 12 is a major transition:** we'll move from JavaScript running as a language to **JavaScript controlling an actual webpage**—`window`, `document`, the DOM tree, element selection, changing HTML/CSS, creating/removing elements, and DOM traversal.\",{},{\"_197\":1132,\"_204\":1394,\"_54\":1395,\"_208\":1396,\"_210\":211,\"_213\":214,\"_215\":1397,\"_217\":218},\"4cc1e9a4-28d2-4c8e-a032-888feddbe52d\",[1120],{\"_656\":657,\"_215\":1398},1789577405.4998353,{\"_651\":667,\"_668\":669},{\"_233\":234,\"_240\":1145,\"_242\":1145,\"_245\":1392,\"_248\":10,\"_666\":34},{},{\"_197\":1392,\"_204\":1402,\"_54\":1403,\"_208\":1404,\"_210\":211,\"_213\":214,\"_215\":1405,\"_217\":218},\"2eec922c-fdc3-48af-923c-76789d0b1e7f\",[1132],{\"_656\":681,\"_215\":1408},1789577405.0459287,{\"_651\":652,\"_653\":1407},{\"_678\":34,\"_246\":1406,